                                                <af:selectItem label="#{resources.BPM}" value="BPM" id="si4"/>
                                            </af:selectOneRadio>
                                        </af:panelFormLayout>
                                        <af:inputText id="edAttTy" visible="false">
                                            <?audit suppress oracle.adf.faces.compnotlabelled?>
                                        </af:inputText>
