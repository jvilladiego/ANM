<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <f:view xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:trh="http://myfaces.apache.org/trinidad/html"
            xmlns:wf="http://xmlns.oracle.com/bpel/workflow/workflow-taglib.tld"
            xmlns:wlc="http://xmlns.oracle.com/bpel/workflow/worklist">
        <af:document title="ActualizarDatosDestinatario.jspx" id="d1">
            <af:messages id="m1"/>
            <af:resource type="javascript" source="/jsLibs/taskDetails.js"/>
            <af:resource type="javascript" source="/jsLibs/commonBPM.js"/>
            <af:form id="f1" usesUpload="true">
                <af:panelGroupLayout layout="vertical" inlineStyle="padding: 5px;" id="pgl1">
                    <af:panelHeader text="#{bindings.title.inputValue}" id="ph1">
                        <f:facet name="info"/>
                        <f:facet name="legend"/>
                        <f:facet name="menuBar"/>
                        <f:facet name="toolbar">
                            <af:toolbar visible="#{actionAvailable.toolbarAvailable}" id="t1">
                                <af:switcher id="customActionButtons"
                                             facetName="#{actionAvailable.isCustomActionButtons}">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="horizontal" id="pgl2">
                                            <af:button actionListener="#{invokeActionBean.setOperation}"
                                                       text="#{wf:getResourceValue('ACCEPT', 'bindings.customActions')}"
                                                       disabled="#{!bindings.ACCEPT.enabled}"
                                                       action="#{invokeActionBean.invokeOperation}"
                                                       partialSubmit="false"
                                                       visible="#{wf:isCustomActionAvailable('ACCEPT', 'bindings.customActions')}"
                                                       id="b1">
                                                <f:attribute name="DC_OPERATION_BINDING" value="bindings.ACCEPT"/>
                                            </af:button>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                </af:switcher>
                                <af:button actionListener="#{invokeActionBean.setOperation}" text="#{resources.CLAIM}"
                                           id="Claim" action="#{invokeActionBean.invokeOperation}" partialSubmit="false"
                                           visible="#{actionAvailable.claimAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Claim"/>
                                </af:button>
                                <af:button id="acknowledge" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.ACKNOWLEDGE}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.isFyiTask}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Acknowledge"/>
                                </af:button>
                                <af:button id="resume" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.RESUME}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.resumeAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Resume"/>
                                </af:button>
                                <af:panelGroupLayout layout="horizontal" id="pgl3">
                                    <af:group rendered="#{!((empty actionAvailable.customActions) and (empty actionAvailable.redirectActions) and (empty actionAvailable.otherActions)) || bindings.update.enabled}"
                                              id="g1">
                                        <af:menuBar id="mb1">
                                            <af:menu id="acts" text="#{resources.TASK_ACTIONS}"
                                                     visible="#{actionAvailable.actionsAvailable || bindings.update.enabled}">
                                                <af:group id="g2">
                                                    <af:forEach var="childNode1"
                                                                items="#{actionAvailable.customActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{childNode1.displayName}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi2">
                                                            <f:attribute name="ACTION_MENU_ITEM"
                                                                         value="#{childNode1.action}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g3">
                                                    <af:forEach var="childNode2"
                                                                items="#{actionAvailable.redirectActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode2]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="true" id="cmi1">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode2}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g4">
                                                    <af:forEach var="childNode3"
                                                                items="#{actionAvailable.otherActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode3]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi4">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode3}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g5">
                                                    <af:commandMenuItem id="save" textAndAccessKey="#{resources.SAVE}"
                                                                        actionListener="#{invokeActionBean.setAction}"
                                                                        action="#{invokeActionBean.action}"
                                                                        partialSubmit="false"
                                                                        rendered="#{actionAvailable.updateAvailable}">
                                                        <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                                    </af:commandMenuItem>
                                                </af:group>
                                            </af:menu>
                                        </af:menuBar>
                                    </af:group>
                                </af:panelGroupLayout>
                                <af:spacer width="10" id="s1"/>
                                <af:link shortDesc="#{resources.PREVIOUS_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/nexttraversalarrow_ena.png'  : '/hw_images/previoustraversalarrow_ena.png'}"
                                         action="fetchPreviousTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l1"/>
                                <af:spacer width="10" id="s2"/>
                                <af:link shortDesc="#{resources.NEXT_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/previoustraversalarrow_ena.png' : '/hw_images/nexttraversalarrow_ena.png'}"
                                         action="fetchNextTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l2"/>
                                <af:spacer width="10" id="s3"/>
                                <af:link shortDesc="#{resources.SHORT_DESC_CLOSE}" icon="/hw_images/close_ena.png"
                                         action="closeTaskFlow"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l3"/>
                            </af:toolbar>
                        </f:facet>
                        <f:facet name="context"/>
                        <af:panelGroupLayout layout="vertical" id="pgl4">
                            <f:facet name="separator">
                                <af:spacer width="15" height="15" id="s4"/>
                            </f:facet>
                            <af:showDetailHeader size="2" id="dtHead" text="#{resources.DETAILS}"
                                                 shortDesc="#{resources.TASK_HEADER}"
                                                 icon="/hw_images/singleapprover_35x35.png"
                                                 disclosed="#{actionAvailable.discloseHeader}">
                                <f:facet name="context">
                                    <af:link icon="/hw_images/info.png" id="button" clientComponent="true"
                                             rendered="#{!empty bindings.activityId.inputValue}">
                                        <af:showPopupBehavior popupId="helpPopup" align="afterEnd" alignId="button"/>
                                    </af:link>
                                </f:facet>
                                <f:facet name="toolbar"/>
                                <!--trh:tableLayout id="detailTableLayout" width="98%">
                        <trh:rowLayout>
                            <trh:cellFormat width="50%" valign="top"-->
                                <af:panelFormLayout maxColumns="2" rows="4" id="pfl1">
                                    <af:switcher facetName="#{bindings.taskViewContext == 'FYI'}" id="s5">
                                        <f:facet name="false">
                                            <af:panelLabelAndMessage id="assignees" label="#{resources.ASSIGNEES}">
                                                <af:iterator var="assignees" varStatus="varS"
                                                             value="#{bindings.assignees.collectionModel}" id="i1">
                                                    <af:switcher facetName="#{varS.index == 0}" id="s6">
                                                        <f:facet name="false">
                                                            <af:outputText value=", " id="ot1"/>
                                                        </f:facet>
                                                    </af:switcher>
                                                    <af:switcher facetName="#{!empty assignees.displayName}" id="s7">
                                                        <f:facet name="true">
                                                            <af:outputText value="#{assignees.displayName}" id="ot2"/>
                                                        </f:facet>
                                                        <f:facet name="false">
                                                            <af:outputText value="#{assignees.id}" id="ot3"/>
                                                        </f:facet>
                                                    </af:switcher>
                                                </af:iterator>
                                            </af:panelLabelAndMessage>
                                        </f:facet>
                                    </af:switcher>
                                    <af:panelLabelAndMessage id="creator" label="#{resources.CREATOR}">
                                        <af:outputText value="#{bindings.creatorDisplayName.inputValue}" id="ot4"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="createdDate" label="#{resources.CREATE_DATE}">
                                        <af:outputText value="#{bindings.createdDate.inputValue}" noWrap="true"
                                                       id="ot5">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}"
                                                               dateStyle="#{pageFlowScope.df}"
                                                               timeStyle="#{pageFlowScope.tf}"
                                                               pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="updatedDate" label="#{resources.UPDATE_DATE}">
                                        <af:outputText value="#{bindings.updatedDate.inputValue}" noWrap="true"
                                                       id="ot6">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}"
                                                               dateStyle="#{pageFlowScope.df}"
                                                               timeStyle="#{pageFlowScope.tf}"
                                                               pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="expirationDate" label="#{resources.EXPIRATION_DATE}">
                                        <af:outputText value="#{bindings.expirationDate.inputValue}" id="ot7">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}"
                                                               dateStyle="#{pageFlowScope.df}"
                                                               timeStyle="#{pageFlowScope.tf}"
                                                               pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="acquiredBy" label="#{resources.ACQUIRED_BY}">
                                        <af:switcher facetName="#{!empty bindings.acquiredByDisplayName.inputValue}"
                                                     id="s8">
                                            <f:facet name="true">
                                                <af:outputText value="#{bindings.acquiredByDisplayName.inputValue}"
                                                               id="ot8"/>
                                            </f:facet>
                                            <f:facet name="false">
                                                <af:outputText value="#{bindings.acquiredBy.inputValue}" id="ot9"/>
                                            </f:facet>
                                        </af:switcher>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="dueDate" label="#{resources.DUE_DATE}"
                                                             rendered="#{!empty bindings.dueDate.inputValue}">
                                        <af:outputText value="#{bindings.dueDate.inputValue}" noWrap="true" id="ot10">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}"
                                                               dateStyle="#{pageFlowScope.df}"
                                                               timeStyle="#{pageFlowScope.tf}"
                                                               pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="outcome" label="#{resources.OUTCOME}"
                                                             rendered="#{!empty bindings.actionDisplayName.inputValue}">
                                        <af:outputText value="#{bindings.actionDisplayName.inputValue}" id="ot11"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="taskNumber" label="#{resources.TASK_NUMBER}">
                                        <af:outputText value="#{bindings.taskNumber.inputValue}" id="ot12"/>
                                    </af:panelLabelAndMessage>
                                    <af:inputText id="priority" value="#{bindings.priority.inputValue}"
                                                  label="#{resources.PRIORITY}"
                                                  required="#{bindings.priority.mandatory}" columns="3"
                                                  validator="#{actionAvailable.validatePriorityValue}"/>
                                    <af:panelLabelAndMessage id="state" label="#{resources.STATE}">
                                        <af:outputText value="#{resources[bindings.state.inputValue]}" id="ot13"/>
                                    </af:panelLabelAndMessage>
                                </af:panelFormLayout>
                                <!--/trh:cellFormat>
                            <trh:cellFormat>
                                <af:spacer width="15" height="15"/>
                            </trh:cellFormat>
                            <trh:cellFormat width="50%" valign="top">
                                <af:panelFormLayout>
                                    <f:facet name="footer"/>
                                </af:panelFormLayout>
                            </trh:cellFormat>
                        </trh:rowLayout>
                    </trh:tableLayout-->
                            </af:showDetailHeader>
                            <af:showDetailHeader size="2" id="apCntHd" text="#{resources.CONTENTS}"
                                                 disclosed="#{actionAvailable.discloseContents}">
                                <af:panelGroupLayout id="plPnl76" layout="vertical" shortDesc="#{resources.CONTENTS}">
                                    <af:panelBox text="General" id="pb7">
                                        <f:facet name="toolbar"/>
                                        <af:panelGroupLayout id="pgl23" layout="horizontal" valign="top">
                                            <af:panelFormLayout id="pfl2">
                                                <af:inputText label="No. radicado"
                                                              value="#{bindings.nroRadicado.inputValue}" id="it50"
                                                              readOnly="true"/>
                                                <af:panelLabelAndMessage label="Tiempo respuesta"
                                                                         id="plm_tiemporespuesta"
                                                                         visible="#{bindings.isRespuesta.inputValue}">
                                                    <af:outputText value="#{bindings.tiempoRespuesta.inputValue}"
                                                                   id="ot_tiemporespuesta"></af:outputText>
                                                    <af:outputText value=" (d&#237;as h&#225;biles)"
                                                                   id="ot_diashabiles"/>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:panelFormLayout id="pfl20">
                                                <af:inputText label="Fecha radicaci&#243;n"
                                                              value="#{bindings.fechaRadicacion.inputValue}" id="it1"
                                                              readOnly="true">
                                                    <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                </af:inputText>
                                                <af:inputText label="Fecha vencimiento"
                                                              value="#{bindings.fechaVencimiento.inputValue}" id="it16"
                                                              visible="#{bindings.isRespuesta.inputValue}"
                                                              readOnly="true">
                                                    <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                </af:inputText>
                                            </af:panelFormLayout>
                                            <af:panelFormLayout id="pfl4">
                                                <af:inputText value="#{bindings.creatorDisplayName.inputValue}"
                                                              id="it21" readOnly="true" label="Creador"/>
                                                <af:inputText value="#{bindings.updatedDate.inputValue}" id="it22"
                                                              readOnly="true" label="Actualizado">
                                                    <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                </af:inputText>
                                                <af:inputText label="Dependencia"
                                                              value="#{operacionBean.anmUnidad.nombreUnidadadministrativa}"
                                                              id="ot15" visible="false"/>
                                            </af:panelFormLayout>
                                        </af:panelGroupLayout>
                                        <af:spacer width="10" height="10" id="s18"/>
                                        <af:panelGroupLayout layout="horizontal" id="pgl49">
                                            <af:panelLabelAndMessage label="No. Radicado Relacionado" id="plam5"
                                                                     visible="#{bindings.isRespuesta.inputValue}"/>
                                            <af:link targetFrame="_blank"
                                                     text="#{bindings.nroRadicadoRelacionado.inputValue}"
                                                     visible="#{bindings.isRespuesta.inputValue}"
                                                     destination="#{bindings.urlDocPrincipalEntrada.inputValue}"
                                                     id="link_docentrada"/>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox text="Contenido" id="pb4">
                                        <f:facet name="toolbar"/>
                                        <af:panelGroupLayout id="pgcontenido" layout="vertical">
                                            <af:panelGroupLayout layout="horizontal" id="pgl5">
                                                <af:panelLabelAndMessage label="Documento Principal"
                                                                         id="plm_docprincipal"/>
                                                <af:link destination="#{bindings.url.inputValue}" targetFrame="_blank"
                                                         text="COM_#{bindings.nroRadicado.inputValue}.pdf" id="l5"/>
                                            </af:panelGroupLayout>
                                            <af:spacer width="20" height="10" id="s20"/>
                                            <af:inputText value="#{bindings.asunto.inputValue}"
                                                          label="#{bindings.asunto.hints.label}"
                                                          columns="100"
                                                          maximumLength="#{bindings.asunto.hints.precision}"
                                                          readOnly="true" shortDesc="#{bindings.asunto.hints.tooltip}"
                                                          id="it5">
                                                <f:validator binding="#{bindings.asunto.validator}"/>
                                                <f:validateLength maximum="500"/>
                                            </af:inputText>
                                            <af:spacer width="10" height="10" id="s23"/>
                                            <af:panelGroupLayout layout="horizontal" id="pgl7" valign="top">
                                                <af:panelGroupLayout layout="vertical" id="pgl9">
                                                    <af:selectBooleanCheckbox value="#{bindings.esTituloMinero.inputValue}"
                                                                              label="&#191;Expediente minero?"
                                                                              shortDesc="#{bindings.esTituloMinero.hints.tooltip}"
                                                                              id="sbcTituloMinero" readOnly="true"/>
                                                    <af:inputText value="#{bindings.placa.inputValue}" autoSubmit="true"
                                                                  partialTriggers="sbcTituloMinero"
                                                                  placeholder="No.Expediente"
                                                                  disabled="#{not bindings.esTituloMinero.inputValue}"
                                                                  required="#{bindings.placa.hints.mandatory}"
                                                                  columns="#{bindings.placa.hints.displayWidth}"
                                                                  maximumLength="#{bindings.placa.hints.precision}"
                                                                  shortDesc="#{bindings.placa.hints.tooltip}" id="it3"
                                                                  valueChangeListener="#{operacionBean.cambiarPlaca}"
                                                                  readOnly="true">
                                                        <f:validator binding="#{bindings.placa.validator}"/>
                                                    </af:inputText>
                                                </af:panelGroupLayout>
                                                <af:spacer width="20" height="10" id="s19"/>
                                                <af:panelGroupLayout layout="vertical" id="pgl42">
                                                    <af:selectBooleanCheckbox label="Referencia adicional"
                                                                              value="#{not empty bindings.referencia.inputValue}"
                                                                              readOnly="true" id="sbcReferencia"
                                                                              autoSubmit="true"/>
                                                    <af:inputText value="#{bindings.referencia.inputValue}"
                                                                  partialTriggers="sbcReferencia" readOnly="true"
                                                                  placeholder="#{bindings.referencia.hints.label}"
                                                                  required="#{bindings.referencia.hints.mandatory}"
                                                                  columns="#{bindings.referencia.hints.displayWidth}"
                                                                  maximumLength="#{bindings.referencia.hints.precision}"
                                                                  shortDesc="#{bindings.referencia.hints.tooltip}"
                                                                  id="it33">
                                                        <f:validator binding="#{bindings.referencia.validator}"/>
                                                        <f:validateLength maximum="200" />
                                                    </af:inputText>
                                                </af:panelGroupLayout>
                                                <af:spacer width="20" height="10" id="s21"/>
                                                <af:panelGroupLayout layout="vertical" id="pgl47">
                                                    <af:selectBooleanCheckbox label="&#191;PQRS?"
                                                                              visible="#{bindings.isRespuesta.inputValue}"
                                                                              value="#{bindings.isPQRS.inputValue}"
                                                                              id="sbcisPQRS" readOnly="true"></af:selectBooleanCheckbox>
                                                    <af:inputText label="Tipo PQRS"
                                                                  visible="#{bindings.isRespuesta.inputValue}"
                                                                  value="#{bindings.tipoPQRS.inputValue}"
                                                                  id="it_tipoPQRS" readOnly="true"></af:inputText>
                                                </af:panelGroupLayout>
                                                <af:spacer width="10" height="10" id="spacer31"/>
                                                <af:panelGroupLayout id="pgl48" layout="vertical">
                                                    <af:inputNumberSpinbox label="No. Folios"
                                                                  value="#{bindings.nroFolios.inputValue}"
                                                                  id="itnumfolios" readOnly="true"
                                                                  minimum="1" maximum="100"/>
                                                </af:panelGroupLayout>
                                            </af:panelGroupLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox text="Anexos No digitalizables" id="pb_anexos">
                                        <af:table value="#{bindings.listaAnexos.collectionModel}" var="row"
                                                  rows="#{bindings.listaAnexos.rangeSize}"
                                                  emptyText="#{bindings.listaAnexos.viewable ? 'No data to display.' : 'Access Denied.'}"
                                                  rowBandingInterval="0" fetchSize="#{bindings.listaAnexos.rangeSize}"
                                                  id="t5">
                                            <?audit suppress oracle.adf.faces.compreqsummary?><?audit suppress oracle.adf.faces.tableneedsrowheader?>
                                            <af:column headerText="Cantidad" id="c3">
                                                <af:inputText value="#{row.bindings.nombre.inputValue}" label="Cantidad"
                                                              required="#{bindings.listaAnexos.hints.nombre.mandatory}"
                                                              maximumLength="#{bindings.listaAnexos.hints.nombre.precision}"
                                                              shortDesc="#{bindings.listaAnexos.hints.nombre.tooltip}"
                                                              readOnly="true" id="it27">
                                                    <f:validator binding="#{row.bindings.nombre.validator}"/>
                                                </af:inputText>
                                            </af:column>
                                            <af:column headerText="#{bindings.listaAnexos.hints.descripcion.label}"
                                                       id="c4">
                                                <af:inputText value="#{row.bindings.descripcion.inputValue}"
                                                              label="#{bindings.listaAnexos.hints.descripcion.label}"
                                                              required="#{bindings.listaAnexos.hints.descripcion.mandatory}"
                                                              maximumLength="#{bindings.listaAnexos.hints.descripcion.precision}"
                                                              shortDesc="#{bindings.listaAnexos.hints.descripcion.tooltip}"
                                                              readOnly="true" id="it32">
                                                    <f:validator binding="#{row.bindings.descripcion.validator}"/>
                                                </af:inputText>
                                            </af:column>
                                            <!--<af:column headerText="#{bindings.listaAnexos.hints.contenido.label}"
                                                       id="c6">
                                                <af:inputText value="#{row.bindings.contenido.inputValue}"
                                                              label="#{bindings.listaAnexos.hints.contenido.label}"
                                                              required="#{bindings.listaAnexos.hints.contenido.mandatory}"
                                                              columns="#{bindings.listaAnexos.hints.contenido.displayWidth}"
                                                              maximumLength="#{bindings.listaAnexos.hints.contenido.precision}"
                                                              shortDesc="#{bindings.listaAnexos.hints.contenido.tooltip}"
                                                              id="it41">
                                                    <f:validator binding="#{row.bindings.contenido.validator}"/>
                                                </af:inputText>
                                            </af:column>
                                            <af:column headerText="#{bindings.listaAnexos.hints.mimeType.label}"
                                                       id="c7">
                                                <af:inputText value="#{row.bindings.mimeType.inputValue}"
                                                              label="#{bindings.listaAnexos.hints.mimeType.label}"
                                                              required="#{bindings.listaAnexos.hints.mimeType.mandatory}"
                                                              columns="#{bindings.listaAnexos.hints.mimeType.displayWidth}"
                                                              maximumLength="#{bindings.listaAnexos.hints.mimeType.precision}"
                                                              shortDesc="#{bindings.listaAnexos.hints.mimeType.tooltip}"
                                                              id="it42">
                                                    <f:validator binding="#{row.bindings.mimeType.validator}"/>
                                                </af:inputText>
                                            </af:column>
                                            <af:column headerText="#{bindings.listaAnexos.hints.tipoAnexo.label}"
                                                       id="c8">
                                                <af:inputText value="#{row.bindings.tipoAnexo.inputValue}"
                                                              label="#{bindings.listaAnexos.hints.tipoAnexo.label}"
                                                              required="#{bindings.listaAnexos.hints.tipoAnexo.mandatory}"
                                                              columns="#{bindings.listaAnexos.hints.tipoAnexo.displayWidth}"
                                                              maximumLength="#{bindings.listaAnexos.hints.tipoAnexo.precision}"
                                                              shortDesc="#{bindings.listaAnexos.hints.tipoAnexo.tooltip}"
                                                              id="it43">
                                                    <f:validator binding="#{row.bindings.tipoAnexo.validator}"/>
                                                </af:inputText>
                                            </af:column>-->
                                        </af:table>
                                    </af:panelBox>
                                    <!--<af:panelFormLayout id="pfl3">
                                        <af:inputText value="#{bindings.descripcion.inputValue}"
