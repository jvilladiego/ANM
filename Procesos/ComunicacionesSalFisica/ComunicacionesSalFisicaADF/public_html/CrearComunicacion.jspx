                        </trh:rowLayout>
                    </trh:tableLayout-->
                            </af:showDetailHeader>
                            <af:panelGroupLayout id="plPnl76" layout="vertical" shortDesc="#{resources.CONTENTS}">
                                <af:panelBox text="Plantillas" id="pb2">
                                    <f:facet name="toolbar"/>
                                    <af:table var="row" rowBandingInterval="1" id="t5" rowSelection="single"
                                              value="#{operacionBean.lstPlantilla}">
                                        <af:column sortable="false" headerText="Nombre plantilla" id="c3" width="300">
                                            <af:link text="#{row.nombre}" id="l4" targetFrame="_blank"
                                                     destination="#{row.ruta}"/>
                                        </af:column>
                                        <af:column sortable="false" headerText="Fecha creaci&#243;n" id="c4">
                                            <af:outputText value="#{row.fechaCreacion}" id="ot24"/>
                                        </af:column>
                                    </af:table>
                                </af:panelBox>
                                <af:panelBox text="General" id="pb7">
                                    <f:facet name="toolbar"/>
                                    <af:panelGroupLayout id="pgl23" layout="horizontal">
                                        <af:panelFormLayout id="pfl2"
                                                            visible="#{bindings.nroRadicado.inputValue != null}">
                                            <af:inputText label="No. radicado"
                                                          value="#{bindings.nroRadicado.inputValue}" id="it50"
                                                          readOnly="true"/>
                                            <af:inputText label="Tiempo respuesta" id="it40" readOnly="true"/>
                                            <af:inputText label="No. radicado relacionado"
                                                          value="#{bindings.nroRadicadoRelacionado.inputValue}"
                                                          id="it30" readOnly="true">
                                                <f:validateLength maximum="100" />
                                            </af:inputText>
                                        </af:panelFormLayout>
                                        <af:panelFormLayout id="pfl20">
                                            <af:inputText label="Fecha radicaci&#243;n"
                                                          value="#{operacionBean.fechaActual}" id="it1" readOnly="true">
                                                <af:convertDateTime pattern="dd-MMM-yyyy"/>
                                            </af:inputText>
                                            <af:inputText label="Fecha vencimiento" value="#{operacionBean.fechaActual}"
                                                          id="it16" readOnly="true">
                                                <af:convertDateTime pattern="dd-MMM-yyyy"/>
                                            </af:inputText>
                                        </af:panelFormLayout>
                                        <af:panelFormLayout id="pfl4">
                                            <af:inputText value="#{bindings.creatorDisplayName.inputValue}" id="ot4"
                                                          readOnly="true" label="Creador"/>
                                            <af:inputText value="#{bindings.updatedDate.inputValue}" id="ot6"
                                                          readOnly="true" label="Actualizado">
                                                <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                   timeZone="#{pageFlowScope.tz}"
                                                                   dateStyle="#{pageFlowScope.df}"
                                                                   timeStyle="#{pageFlowScope.tf}"
                                                                   pattern="#{pageFlowScope.dateTimePattern}"/>
                                            </af:inputText>
                                            <af:inputText label="Dependencia"
                                                          value="#{operacionBean.anmUnidad.nombreUnidadadministrativa}"
                                                          id="ot15" visible="false"/>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:panelBox>
                                <af:panelBox text="Contenido" id="pb4">
                                    <f:facet name="toolbar"/>
                                    <af:panelGroupLayout id="pgl24" layout="vertical">
                                        <af:inputText value="#{bindings.asunto.inputValue}"
                                                      label="#{bindings.asunto.hints.label}" required="true"
                                                      columns="100" maximumLength="500"
                                                      shortDesc="#{bindings.asunto.hints.tooltip}" id="it5">
                                            <f:validator binding="#{bindings.asunto.validator}"/>
                                            <f:validateLength maximum="500" />
                                        </af:inputText>
                                        <af:spacer width="10" height="10" id="s23"/>
                                        <af:panelGroupLayout layout="horizontal">
                                            <af:panelGroupLayout layout="vertical">
                                                <af:selectBooleanCheckbox value="#{bindings.esTituloMinero.inputValue}"
                                                                          label="&#191;Expediente minero?"
                                                                          shortDesc="#{bindings.esTituloMinero.hints.tooltip}"
                                                                          valueChangeListener="#{operacionBean.cambiarEsTituloMinero}"
                                                                          id="sbcTituloMinero" autoSubmit="true"/>
                                                <af:inputText value="#{bindings.placa.inputValue}" autoSubmit="true"
                                                              partialTriggers="sbcTituloMinero"
                                                              placeholder="No.Expediente"
                                                              disabled="#{not bindings.esTituloMinero.inputValue}"
                                                              required="#{bindings.placa.hints.mandatory}"
                                                              columns="#{bindings.placa.hints.displayWidth}"
                                                              maximumLength="100"
                                                              shortDesc="#{bindings.placa.hints.tooltip}" id="it3"
                                                              valueChangeListener="#{operacionBean.cambiarPlaca}">
                                                    <f:validator binding="#{bindings.placa.validator}"/>
                                                    <f:validateLength maximum="100" />
                                                </af:inputText>
                                            </af:panelGroupLayout>
                                            <af:spacer width="20" height="10" id="s5"/>
                                            <af:panelGroupLayout layout="vertical" id="pgl42">
                                                <af:selectBooleanCheckbox label="Referencia adicional"
                                                                          value="#{operacionBean.tieneReferencia}"
                                                                          id="sbcReferencia" autoSubmit="true"/>
                                                <af:inputText value="#{bindings.referencia.inputValue}"
                                                              partialTriggers="sbcReferencia"
                                                              disabled="#{not operacionBean.tieneReferencia}"
                                                              placeholder="#{bindings.referencia.hints.label}"
                                                              required="#{operacionBean.tieneReferencia}"
                                                              columns="#{bindings.referencia.hints.displayWidth}"
                                                              shortDesc="#{bindings.referencia.hints.tooltip}"
                                                              maximumLength="200" id="it33">
                                                    <f:validator binding="#{bindings.referencia.validator}"/>
                                                    <f:validateLength maximum="200" />
                                                </af:inputText>
                                            </af:panelGroupLayout>
                                        </af:panelGroupLayout>
                                        <af:spacer width="10" height="10" id="s31"/>
                                        <af:inputNumberSpinbox label="No. Folios"
                                                               value="#{bindings.nroFolios.inputValue}" id="ins1"
                                                               minimum="1" maximum="100" required="true"/>
                                    </af:panelGroupLayout>
                                </af:panelBox>
                                <af:panelBox text="Anexos no digitalizables" id="pb1">
                                    <af:panelGroupLayout id="pgl3" layout="horizontal">
                                        <af:button actionListener="#{bindings.CreateInsert5.execute}" text="Agregar"
                                                   disabled="#{!bindings.CreateInsert5.enabled}" id="b4"/>
                                        <af:button actionListener="#{bindings.Delete5.execute}" text="Borrar"
                                                   disabled="#{!bindings.Delete5.enabled}" id="b5"
                                                   immediate="true"/>
                                    </af:panelGroupLayout>
                                    <af:spacer width="10" height="10" id="s6"/>
                                    <af:table value="#{bindings.listaAnexos.collectionModel}" var="row"
                                              rows="#{bindings.listaAnexos.rangeSize}"
                                              emptyText="#{bindings.listaAnexos.viewable ? 'No hay datos para mostrar.' : 'Acceso denegado.'}"
                                              rowBandingInterval="0" fetchSize="#{bindings.listaAnexos.rangeSize}"
                                              id="t3" partialTriggers="::b4 ::b5">
                                        <af:column headerText="Cantidad" id="c1">
                                            <af:inputText value="#{row.bindings.nombre.inputValue}"
                                                          label="#{bindings.listaAnexos.hints.nombre.label}"
                                                          required="true"
                                                          maximumLength="4"
                                                          shortDesc="#{bindings.listaAnexos.hints.nombre.tooltip}"
                                                          id="it2">
                                                <f:validator binding="#{row.bindings.nombre.validator}"/>
                                                <f:validateLongRange minimum="1" maximum="9999" />
                                            </af:inputText>
                                        </af:column>
                                        <af:column headerText="#{bindings.listaAnexos.hints.descripcion.label}" id="c6">
                                            <af:inputText value="#{row.bindings.descripcion.inputValue}"
                                                          label="#{bindings.listaAnexos.hints.descripcion.label}"
                                                          required="true"
                                                          maximumLength="200"
                                                          shortDesc="#{bindings.listaAnexos.hints.descripcion.tooltip}"
                                                          id="it8">
                                                <f:validator binding="#{row.bindings.descripcion.validator}"/>
                                                <f:validateLength maximum="200" />
                                            </af:inputText>
                                        </af:column>
                                    </af:table>
                                </af:panelBox>
                                <af:panelBox text="Gesti&#243;n documental" id="pb3">
                                    <f:facet name="toolbar"/>
                                    <af:panelGroupLayout id="pgl25" layout="horizontal">
                                        <af:panelGroupLayout id="pgl9" layout="horizontal"
                                                             partialTriggers="sbcTituloMinero"
                                                             visible="#{bindings.esTituloMinero.inputValue eq 'true'}"
                                                             rendered="#{bindings.esTituloMinero.inputValue eq 'true'}">
                                                             
                                            <af:selectOneChoice id="selectTramite" label="Tr&#225;mite"
                                                                partialTriggers="sbcTituloMinero"
                                                                rendered="#{bindings.esTituloMinero.inputValue eq 'true'}"
                                                                autoSubmit="true"
                                                                showRequired="#{bindings.esTituloMinero.inputValue eq 'true'}"
                                                                valueChangeListener="#{operacionBean.cambiarTramite}">
                                                <f:selectItems value="#{operacionBean.lstTramites}" id="selTramites2"/>
                                            </af:selectOneChoice>
                                            <af:spacer width="10" height="10" id="s9"/>
                                            <af:selectOneChoice id="selectTpDocumento" label="Tipo Documental"
                                                                partialTriggers="selectTramite sbcTituloMinero"
                                                                showRequired="#{bindings.esTituloMinero.inputValue eq 'true'}"
                                                                valueChangeListener="#{operacionBean.cambiarTipoDocumental}"
                                                                autoSubmit="true">
                                                <f:selectItems value="#{operacionBean.lstTiposDocum}" id="selTpDoc2"/>
                                            </af:selectOneChoice>
                                        </af:panelGroupLayout>
                                        <af:panelFormLayout id="pgl10" partialTriggers="sbcTituloMinero"
                                                            visible="#{bindings.esTituloMinero.inputValue ne 'true'}">
                                            <af:selectOneChoice id="selectCategoria" label="Categoria" autoSubmit="true"
                                                                showRequired="#{bindings.esTituloMinero.inputValue eq 'N'}"
                                                                valueChangeListener="#{operacionBean.cambiarCategoria}">
                                                <f:selectItems value="#{operacionBean.lstCategoria}"
                                                               id="selCategorias"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectProceso" label="Proceso"
                                                                showRequired="#{bindings.esTituloMinero.inputValue eq 'N'}"
                                                                autoSubmit="true" partialTriggers="selectCategoria"
                                                                valueChangeListener="#{operacionBean.cambiarProceso}">
                                                <f:selectItems value="#{operacionBean.lstProceso}" id="selProceso"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectSerie" label="Serie"
                                                                showRequired="#{bindings.esTituloMinero.inputValue eq 'N'}"
                                                                autoSubmit="true"
                                                                partialTriggers="selectProceso selectCategoria"
                                                                valueChangeListener="#{operacionBean.cambiarSerie}">
                                                <f:selectItems value="#{operacionBean.lstSerie}" id="selSerie"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectSubserie" label="Subserie" autoSubmit="true"
                                                                partialTriggers="selectSerie selectProceso selectCategoria"
                                                                valueChangeListener="#{operacionBean.cambiarSubserie}">
                                                <f:selectItems value="#{operacionBean.lstSubserie}" id="selSubserie"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectExpediente" label="Expediente"
                                                                autoSubmit="true"
