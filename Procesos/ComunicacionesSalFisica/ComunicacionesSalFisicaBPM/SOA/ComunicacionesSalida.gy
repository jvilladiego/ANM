public void methodACT1915417835789()
{
	InteresadoRequest interesadoService;
	Iterator it = listaInteresadosDO.interesados.iterator();
	InteresadoBO interesadoLocal;
	boolean resultadoAdd;
	
	actualizacionComunicacion = new ActualizacionProceso();
	actualizacionComunicacion.comunicacion = new ComunicacionRequest();
	actualizacionComunicacion.interesadosList.clear();
	actualizacionComunicacion.comunicacion.setNroRadicado(comunicacionSalidaDO.nroRadicado);
	
	while ( it.hasNext() ){
	    Object object = it.next();
	    if (object instanceof InteresadoBO){
	        interesadoLocal = (InteresadoBO)object;
	        System.out.println("Interesado: "+interesadoLocal.primerNombre);
	        interesadoService = new InteresadoRequest();
	        interesadoService.nroIdentificacion = interesadoLocal.numeroIdentificacion;
	        interesadoService.tipoIdentificacion = interesadoLocal.tipoIdentificacion;
	        interesadoService.direccion = interesadoLocal.direccion;
	        interesadoService.email = interesadoLocal.email;
	        interesadoService.telefono = interesadoLocal.telefono;
	        interesadoService.primerNombre = interesadoLocal.primerNombre;
	        interesadoService.segundoNombre = interesadoLocal.segundoNombre;
	        interesadoService.primerApellido = interesadoLocal.primerApellido;
	        interesadoService.segundoApellido = interesadoLocal.segundoApellido;
	        interesadoService.celular = interesadoLocal.celular;
	        interesadoService.idPais = interesadoLocal.idPais;
	        interesadoService.idDepartamento = interesadoLocal.idDepartamento;
	        interesadoService.idMunicipio = interesadoLocal.idMunicipio;
	        interesadoService.ocupacion = interesadoLocal.ocupacion;
	        resultadoAdd = actualizacionComunicacion.interesadosList.add(interesadoService);
	        System.out.println("Resultado Add: "+resultadoAdd);
	    }
	}
}


public void methodACT19154531840315()
{
	AnexoComunicacionRequest anexoService;
	AnexoBO anexoLocal;
	boolean resultadoAdd;
	boolean resultadoDocPrincipal;
	
	actualizacionComunicacion.anexosList.clear();
	
	//se agrega documento principal a la lista de anexos
	AnexoComunicacionRequest docPrincipal = new AnexoComunicacionRequest();
	docPrincipal.cantidad = BigDecimal.ONE;
	docPrincipal.descripcion = "Documento Principal";
	docPrincipal.enlaceContent = anexoListDO.getUrl();
	//docPrincipal.rutaLocalCargue = anexoListDO.getUrl();
	docPrincipal.nroRadicado = comunicacionSalidaDO.getNroRadicado();
	resultadoDocPrincipal = actualizacionComunicacion.anexosList.add(docPrincipal);
	System.out.println("END : Create Anexo script grovy | Resultado Add Doc Principal: "+resultadoDocPrincipal);
	
	//se agregan los anexos no digitalizables a la lista de anexos
	if (listaAnexos != null && listaAnexos.listaAnexos != null) {
	    Iterator it = listaAnexos.listaAnexos.iterator();
	    
	    while ( it.hasNext() ){
	        Object object = it.next();
	        if (object instanceof AnexoBO) {
	            anexoLocal = (AnexoBO)object;
	            System.out.println("BEGIN : Create Anexo script grovy");
	            anexoService = new AnexoComunicacionRequest();
	            
	            if (anexoLocal.getNombre() != null && !anexoLocal.getNombre().trim().equals("")) {
	                anexoService.setCantidad(new BigDecimal(anexoLocal.getNombre()));    
	            } else {
	                anexoService.setCantidad(BigDecimal.ONE);
	            }
	            
	            if (anexoLocal.descripcion != null && !anexoLocal.descripcion.trim().equals("")) {
	                anexoService.descripcion = anexoLocal.descripcion.take(200);    
	            } else {
	                anexoService.setDescripcion(" ");
	            }            
	            
	            anexoService.setNroRadicado(comunicacionSalidaDO.getNroRadicado());
	            resultadoAdd = actualizacionComunicacion.anexosList.add(anexoService);
	            System.out.println("END : Create Anexo script grovy | Resultado Add: "+resultadoAdd);   
	        } else {
	            System.out.println("END : El objeto no es AnexoBO");   
	        }
	    }   
	}
}


