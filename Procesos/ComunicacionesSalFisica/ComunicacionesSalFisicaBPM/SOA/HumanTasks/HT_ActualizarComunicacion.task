<?xml version = '1.0' encoding = 'UTF-8'?>
<taskDefinition targetNamespace="http://xmlns.oracle.com/ComunicacionesSalFisica/ComunicacionesSalFisicaBPM/HT_ActualizarComunicacion" xmlns:xp20="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.Xpath20" xmlns:ora="http://schemas.oracle.com/xpath/extension" xmlns:oraext="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.ExtFunc" xmlns:task="http://xmlns.oracle.com/bpel/workflow/task" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://xmlns.oracle.com/bpel/workflow/taskDefinition" xmlns:bpm="http://xmlns.oracle.com/bpmn20/extensions" xmlns:hwf="http://xmlns.oracle.com/bpel/workflow/xpath" xmlns:xref="http://www.oracle.com/XSL/Transform/java/oracle.tip.xref.xpath.XRefXPathFunctions"
                xmlns:ns0="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ComunicacionSalidaBO" xmlns:dvm="http://www.oracle.com/XSL/Transform/java/oracle.tip.dvm.LookupValue" xmlns:ids="http://xmlns.oracle.com/bpel/services/IdentityService/xpath" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:evidence="http://xmlns.oracle.com/bpel/workflow/TaskEvidenceService"
                xmlns:ns1="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/UsuarioBO" xmlns:ns2="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/RolBO"
                xmlns:ns3="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/TaxonomiaBO"
                xmlns:ns7="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/MetadatosBO"
                xmlns:ns6="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ComunicacionEntradaBO"
                xmlns:ns5="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ListaAnexosBO"
                xmlns:ns8="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/AdjuntoBO"
                xmlns:ns9="http://xmlns.oracle.com/bpel/workflow/common"
                xmlns:ns4="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ListaInteresadosBO"><name>HT_ActualizarComunicacion</name><id>${domain_id}_${process_id}_${process_revision}_HT_ActualizarComunicacion</id>
  <title type="STATIC"><value>Actualizar Comunicación</value></title>
  <priority>3</priority><hideCreator>false</hideCreator><process processId="" processVersion=""/><routingSlip xmlns="http://xmlns.oracle.com/bpel/workflow/routingSlip"
                                                                                                              routingType="TEMPLATE"><globalConfiguration><applicationContext>OracleBPMProcessRolesApp</applicationContext>
      <taskOwner type="STATIC" identityType="application_role">ComunicacionesSalFisicaBPM.ProcessOwner</taskOwner>
      <sharePayloadConfiguration>
        <type>USE_SYSTEM_WIDE_GLOBAL_CONFIGURATION</type>
      </sharePayloadConfiguration>
      <errorOnEmptyAssignee>false</errorOnEmptyAssignee><excludeSaturdayAndSunday>false</excludeSaturdayAndSunday></globalConfiguration>
    <participants isAdhocRoutingSupported="false">
      <stage name="Stage1" disabled="false">
        <participant disabled="false" name="default.DefaultPerformer">
          <resource type="XPATH" identityType="user">/task:task/task:payload/ns3:UsuarioBO/ns3:idUsuario</resource>
          <dynamicAssignment identityTypeToSelect="user">
            <assignmentPattern patternName="LEAST_BUSY" isGlobalPattern="false"/>
          </dynamicAssignment>
        </participant>
      </stage>
    </participants>
    <onErrorParticipant>
      <resource type="STATIC" identityType="user">weblogic</resource>
    </onErrorParticipant>
    <notification includeTaskAttachments="false" actionable="false" secureNotifications="false"
                  oneNotificationPerUserPerAction="false" hideWorklistUrlInEmail="false">
      <action name="ASSIGN" recipient="ASSIGNEES">
        <![CDATA[concat(string('Task '), /task:task/task:title, string(' requires your attention.'))]]>
      </action>
      <action name="COMPLETE" recipient="CREATOR">
        <![CDATA[concat(string('Task '), /task:task/task:title, string(' requires your attention.'))]]>
      </action>
      <action name="ERROR" recipient="OWNER">
        <![CDATA[concat(string('Task '), /task:task/task:title, string(' requires your attention.'))]]>
      </action>
      <groupNotificationConfiguration>SEND_INDIVIDUAL_NOTIFICATION</groupNotificationConfiguration>
      <commentScope>TASK</commentScope>
    </notification>
  </routingSlip><workflowConfiguration features="ucm,RSCUSTOMIZATION" xmlns:ns0="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ComunicacionSalidaBO" xmlns:ns1="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/UsuarioBO" xmlns="http://xmlns.oracle.com/bpel/workflow/configuration" xmlns:ns3="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/TaxonomiaBO" xmlns:ns4="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ListaInteresadosBO" xmlns:ns5="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ListaAnexosBO" xmlns:ns6="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ComunicacionEntradaBO" xmlns:ns7="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/MetadatosBO" xmlns:ns8="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/AdjuntoBO"
                                       xmlns:xsd="http://www.w3.org/2001/XMLSchema"><outcomes default="ACCEPT">
      <outcome>ACCEPT</outcome>
    </outcomes><payload externalSchema="false" xmlSchemaDefinition="../Schemas/HT_ActualizarComunicacionPayload.xsd"
                        typedTaskSchemaLocation="../Schemas/HT_ActualizarComunicacionWorkflowTask.xsd">
      <messageAttribute name="ComunicacionSalidaBO" attributeType="ELEMENT" type="ns0:ComunicacionSalidaBO"
                        updatable="true" external="false"/>
      <messageAttribute name="UsuarioBO" attributeType="ELEMENT" type="ns1:UsuarioBO" updatable="true"
                        external="false"/>
      <messageAttribute name="TaxonomiaBO" attributeType="ELEMENT" type="ns3:TaxonomiaBO" updatable="true"
                        external="false"/>
      <messageAttribute name="ListaInteresadosBO" attributeType="ELEMENT" type="ns4:ListaInteresadosBO" updatable="true"
                        external="false"/>
      <messageAttribute name="ListaAnexosBO" attributeType="ELEMENT" type="ns5:ListaAnexosBO" updatable="true"
                        external="false"/>
      <messageAttribute name="ComunicacionEntradaBO" attributeType="ELEMENT" type="ns6:ComunicacionEntradaBO"
                        updatable="true" external="false"/>
      <messageAttribute name="MetadatosBO" attributeType="ELEMENT" type="ns7:MetadatosBO" updatable="true"
                        external="false"/>
      <messageAttribute name="asunto" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true" external="false"/>
      <messageAttribute name="numeroRadicado" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                        external="false"/>
      <messageAttribute name="fechaVencimiento" attributeType="SIMPLE_TYPE" type="xsd:dateTime" updatable="true"
                        external="false"/>
      <messageAttribute name="fechaRadicacion" attributeType="SIMPLE_TYPE" type="xsd:dateTime" updatable="true"
                        external="false"/>
      <messageAttribute name="AdjuntoBO" attributeType="ELEMENT" type="ns8:AdjuntoBO" updatable="true"
                        external="false"/>
    </payload>
    <flexfieldMappings>
      <flexfieldMapping>
        <xpathExpression>/task:task/task:payload/task:asunto</xpathExpression>
        <attributeLabel>
          <labelName>asunto</labelName>
          <flexfield>ProtectedTextAttribute11</flexfield>
          <description>Asunto</description>
        </attributeLabel>
        <description>Asunto</description>
      </flexfieldMapping>
      <flexfieldMapping>
        <xpathExpression>/task:task/task:payload/task:numeroRadicado</xpathExpression>
        <attributeLabel>
          <labelName>numeroRadicado</labelName>
          <flexfield>ProtectedTextAttribute12</flexfield>
          <description>Numero radicado</description>
        </attributeLabel>
        <description>Numero radicado</description>
      </flexfieldMapping>
      <flexfieldMapping>
        <xpathExpression>/task:task/task:payload/task:fechaVencimiento</xpathExpression>
        <attributeLabel>
          <labelName>fechaVencimiento</labelName>
          <flexfield>ProtectedDateAttribute1</flexfield>
          <description>Auto-generated for BPM Process</description>
        </attributeLabel>
        <description>fecha vencimiento</description>
      </flexfieldMapping>
      <flexfieldMapping>
        <xpathExpression>/task:task/task:payload/task:fechaRadicacion</xpathExpression>
        <attributeLabel>
          <labelName>fechaRadicacion</labelName>
          <flexfield>ProtectedDateAttribute2</flexfield>
          <description>Auto-generated for BPM Process</description>
        </attributeLabel>
        <description>Fecha radicacion</description>
      </flexfieldMapping>
    </flexfieldMappings>
    <bpelEventListener>false</bpelEventListener><bpelNoCallbacks>false</bpelNoCallbacks>
    <accessRules>
      <actionRules>
        <systemAction>WITHDRAW</systemAction>
        <roles>
          <role privilege="PERMIT">ADMIN</role>
          <role privilege="RESTRICT">APPROVERS</role>
          <role privilege="RESTRICT">ASSIGNEES</role>
          <role privilege="RESTRICT">CREATOR</role>
          <role privilege="RESTRICT">OWNER</role>
          <role privilege="RESTRICT">REVIEWERS</role>
        </roles>
      </actionRules>
      <actionRules>
        <systemAction>REASSIGN</systemAction>
        <roles>
          <role privilege="PERMIT">ADMIN</role>
          <role privilege="PERMIT">OWNER</role>
          <role privilege="RESTRICT">APPROVERS</role>
          <role privilege="RESTRICT">CREATOR</role>
          <role privilege="RESTRICT">REVIEWERS</role>
          <role privilege="RESTRICT">ASSIGNEES</role>
        </roles>
      </actionRules>
    </accessRules>
    <showCompleteGraphicalHistory>true</showCompleteGraphicalHistory><reevalTranslatablesOnUpdate>false</reevalTranslatablesOnUpdate>
    <preActionMandatoryUserSteps/>
    <allowInitiatorEditParticipants>false</allowInitiatorEditParticipants><allowParticipantsEditParticipants>false</allowParticipantsEditParticipants><globalCreationTask>false</globalCreationTask><enableAutoClaim>true</enableAutoClaim><workflowConditions/>
    <taskSequenceTypes>FUTURE</taskSequenceTypes>
    <taskSequenceTypes>AGGREGATE</taskSequenceTypes>
  </workflowConfiguration></taskDefinition>