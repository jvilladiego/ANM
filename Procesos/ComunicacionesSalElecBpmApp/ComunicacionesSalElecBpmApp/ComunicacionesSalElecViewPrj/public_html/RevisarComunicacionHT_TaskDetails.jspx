<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <f:view xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:trh="http://myfaces.apache.org/trinidad/html"
            xmlns:wf="http://xmlns.oracle.com/bpel/workflow/workflow-taglib.tld"
            xmlns:wlc="http://xmlns.oracle.com/bpel/workflow/worklist">
        <af:document title="Comunicaci&#243;n Salida - Revisar Comunicaci&#243;n" id="d1">
            <af:messages id="m1"/>
            <af:resource type="javascript" source="/jsLibs/taskDetails.js"/>
            <af:resource type="javascript" source="/jsLibs/commonBPM.js"/>
            <af:form id="f1" usesUpload="true">
                <af:panelGroupLayout layout="vertical" inlineStyle="padding: 5px;" id="pgl23">
                    <af:panelHeader text="#{bindings.title.inputValue}" id="ph1">
                        <f:facet name="info"/>
                        <f:facet name="legend"/>
                        <f:facet name="menuBar"/>
                        <f:facet name="toolbar">
                            <af:toolbar visible="#{actionAvailable.toolbarAvailable}" id="t3">
                                <af:switcher id="customActionButtons"
                                             facetName="#{actionAvailable.isCustomActionButtons}">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="horizontal" id="pgl25">
                                            <af:button actionListener="#{RevisarComunicacionJSFBean.validarFormRevisarComunicacion}"
                                                       text="Enviar" disabled="#{!bindings.OK.enabled}"
                                                       action="#{invokeActionBean.invokeOperation}"
                                                       partialSubmit="false"
                                                       visible="#{wf:isCustomActionAvailable('OK', 'bindings.customActions')}"
                                                       id="b1">
                                                <f:attribute name="DC_OPERATION_BINDING" value="bindings.OK"/>
                                            </af:button>
                                            <af:button id="button_save" textAndAccessKey="#{resources.SAVE}"
                                                       actionListener="#{invokeActionBean.setAction}"
                                                       action="#{invokeActionBean.action}" partialSubmit="false"
                                                       rendered="#{actionAvailable.updateAvailable}">
                                                <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                            </af:button>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                </af:switcher>
                                <af:button actionListener="#{invokeActionBean.setOperation}" text="#{resources.CLAIM}"
                                           id="Claim" action="#{invokeActionBean.invokeOperation}" partialSubmit="false"
                                           visible="#{actionAvailable.claimAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Claim"/>
                                </af:button>
                                <af:button id="acknowledge" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.ACKNOWLEDGE}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.isFyiTask}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Acknowledge"/>
                                </af:button>
                                <af:button id="resume" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.RESUME}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.resumeAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Resume"/>
                                </af:button>
                                <af:panelGroupLayout layout="horizontal" id="pgl11" visible="false">
                                    <af:group rendered="#{!((empty actionAvailable.customActions) and (empty actionAvailable.redirectActions) and (empty actionAvailable.otherActions)) || bindings.update.enabled}"
                                              id="g6">
                                        <af:menuBar id="mb1">
                                            <af:menu id="acts" text="#{resources.TASK_ACTIONS}"
                                                     visible="#{actionAvailable.actionsAvailable || bindings.update.enabled}">
                                                <af:group id="g5">
                                                    <af:forEach var="childNode1"
                                                                items="#{actionAvailable.customActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{childNode1.displayName}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi2">
                                                            <f:attribute name="ACTION_MENU_ITEM"
                                                                         value="#{childNode1.action}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g3">
                                                    <af:forEach var="childNode2"
                                                                items="#{actionAvailable.redirectActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode2]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="true" id="cmi1">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode2}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g1">
                                                    <af:forEach var="childNode3"
                                                                items="#{actionAvailable.otherActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode3]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi4">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode3}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g4">
                                                    <af:commandMenuItem id="save" textAndAccessKey="#{resources.SAVE}"
                                                                        actionListener="#{invokeActionBean.setAction}"
                                                                        action="#{invokeActionBean.action}"
                                                                        partialSubmit="false"
                                                                        rendered="#{actionAvailable.updateAvailable}">
                                                        <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                                    </af:commandMenuItem>
                                                </af:group>
                                            </af:menu>
                                        </af:menuBar>
                                    </af:group>
                                </af:panelGroupLayout>
                                <af:spacer width="10" id="s16"/>
                                <af:link shortDesc="#{resources.PREVIOUS_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/nexttraversalarrow_ena.png'  : '/hw_images/previoustraversalarrow_ena.png'}"
                                         action="fetchPreviousTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l1"/>
                                <af:spacer width="10" id="s15"/>
                                <af:link shortDesc="#{resources.NEXT_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/previoustraversalarrow_ena.png' : '/hw_images/nexttraversalarrow_ena.png'}"
                                         action="fetchNextTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l3"/>
                                <af:spacer width="10" id="s19"/>
                                <af:link shortDesc="#{resources.SHORT_DESC_CLOSE}" icon="/hw_images/close_ena.png"
                                         action="closeTaskFlow"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l2"/>
                            </af:toolbar>
                        </f:facet>
                        <f:facet name="context"/>
                        <af:panelGroupLayout layout="vertical" id="pgl_vertical">
                            <f:facet name="separator">
                                <af:spacer width="15" height="15" id="s4"/>
                            </f:facet>
                            <af:showDetailHeader size="2" id="apCntHd" text="Contenido" disclosed="true">
                                <af:panelGroupLayout layout="vertical" id="panelCenter" styleClass="AFStretchWidth">
                                    <af:panelBox id="plantillasPnl" text="Plantillas" styleClass="AFStretchWidth">
                                        <af:table value="#{RevisarComunicacionJSFBean.plantillasSet}" var="row" id="t32"
                                                  styleClass="AFStretchWidth" columnStretching="multiple">
                                            <af:column headerText="Nombre" id="c5" width="50%">
                                                <af:link targetFrame="_blank" text="#{row.nombre}"
                                                         destination="#{row.ruta}" id="ot3"/>
                                            </af:column>
                                            <af:column headerText="Creada Por" id="c7" width="25%">
                                                <af:outputText value="#{row.usuarioCreacion}" id="ot5"/>
                                            </af:column>
                                            <af:column headerText="Fecha" id="c8" width="25%">
                                                <af:outputText value="#{row.fechaCreacion}" id="ot6">
                                                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                                                </af:outputText>
                                            </af:column>
                                        </af:table>
                                    </af:panelBox>
                                    <af:panelBox id="pb_general" text="General">
                                        <af:panelGroupLayout id="pgl3" layout="horizontal" valign="top">
                                            <af:panelFormLayout id="pf_fechas">
                                                <af:panelLabelAndMessage label="Fecha Creaci&#243;n" id="plam1">
                                                    <af:outputText value="#{bindings.fechaCreacion.inputValue}"
                                                                   id="ot1">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Fecha Actualizaci&#243;n"
                                                                         id="plam_fechaactualizacion">
                                                    <af:outputText value="#{bindings.updatedDate.inputValue}"
                                                                   id="ot_fechaactualizacion">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="No. Radicado Relacionado" id="plam2"
                                                                         visible="#{bindings.esRespComunicacionEntrada.inputValue}">
                                                    <af:link text="#{bindings.nroRadicadoRelacionado.inputValue}"
                                                             destination="#{bindings.urlDocumentoPpalRelacionado.inputValue}"
                                                             id="relLink" targetFrame="_blank"/>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:spacer width="20" id="s3"/>
                                            <af:panelFormLayout id="pf_respuesta">
                                                <af:panelLabelAndMessage label="Tiempo Respuesta" id="plam4"
                                                                         visible="#{bindings.esRespComunicacionEntrada.inputValue}">
                                                    <af:outputText value="#{bindings.tiempoRespuesta.inputValue}"
                                                                   id="ot18">
                                                        <af:convertNumber groupingUsed="false"
                                                                          pattern="#{bindings.tiempoRespuesta.format}"/>
                                                    </af:outputText>
                                                    <af:outputText value="   (d&#237;as h&#225;biles)" id="ot17"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Fecha Vencimiento"
                                                                         visible="#{bindings.esRespComunicacionEntrada.inputValue}"
                                                                         id="plam_fechavencimiento">
                                                    <af:outputText value="#{bindings.fechaVencimiento.inputValue}"
                                                                   id="ot2">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:spacer width="20" id="s5"/>
                                            <af:panelFormLayout id="pf_funcionario">
                                                <af:panelLabelAndMessage label="Funcionario" id="plam3">
                                                    <af:outputText value="#{bindings.nombre2.inputValue}"
                                                                   shortDesc="#{bindings.nombre2.hints.tooltip}"
                                                                   id="ot7"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Dependencia" id="plam23s">
                                                    <af:outputText value="#{RevisarComunicacionJSFBean.dependenciaSelected}"
                                                                   id="ot22s"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="#{bindings.email1.hints.label}"
                                                                         id="plam6">
                                                    <af:outputText value="#{bindings.email1.inputValue}"
                                                                   shortDesc="#{bindings.email1.hints.tooltip}"
                                                                   id="ot10"/>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox id="pb_contenido" text="Contenido">
                                        <af:inputText value="#{bindings.asunto.inputValue}"
                                                      label="#{bindings.asunto.hints.label}" required="true"
                                                      columns="100" maximumLength="500"
                                                      shortDesc="#{bindings.asunto.hints.tooltip}" id="it4">
                                            <f:validator binding="#{bindings.asunto.validator}"/>
                                            <f:validateLength maximum="500"/>
                                        </af:inputText>
                                        <af:spacer id="spacer_01" width="10" height="20"/>
                                        <af:panelGroupLayout id="pg_contenido_0" layout="horizontal">
                                            <af:panelGroupLayout id="pg_contenido_1" layout="vertical">
                                                <af:selectBooleanCheckbox value="#{bindings.esTituloMineroBool.inputValue}"
                                                                          label="&#191;Expediente Minero?"
                                                                          clientComponent="true" autoSubmit="true"
                                                                          valueChangeListener="#{RevisarComunicacionJSFBean.cambiarEsExpMinero}"
                                                                          id="sbc_expminero"/>
                                                <af:inputText id="it_placa" label="Placa" readOnly="false"
                                                              value="#{bindings.placa.inputValue}"
                                                              disabled="#{not bindings.esTituloMineroBool.inputValue}"
                                                              valueChangeListener="#{CrearComunicacionJSFBean.validarPlaca}"
                                                              maximumLength="100" partialTriggers="sbc_expminero">
                                                    <f:validateLength maximum="100"/>
                                                </af:inputText>
                                            </af:panelGroupLayout>
                                            <af:spacer width="100" height="10" id="s21"/>
                                            <af:panelGroupLayout id="pg_contenido_2" layout="vertical">
                                                <af:selectBooleanCheckbox value="#{bindings.esPqrs.inputValue eq 'S'}"
                                                                          id="sbc_pqrs" label="&#191;PQRS?"
                                                                          visible="#{bindings.esRespComunicacionEntrada.inputValue}"
                                                                          readOnly="true"/>
                                                <af:inputText id="it_pqrs" value="#{bindings.tipoPQRS.inputValue}"
                                                              label="Tipo PQRS"
                                                              visible="#{bindings.esRespComunicacionEntrada.inputValue}"
                                                              readOnly="true"/>
                                                <af:inputText value="#{bindings.tipoPQRS.inputValue}"
                                                              label="#{bindings.tipoPQRS.hints.label}" visible="false"
                                                              columns="#{bindings.tipoPQRS.hints.displayWidth}"
                                                              maximumLength="#{bindings.tipoPQRS.hints.precision}"
                                                              shortDesc="#{bindings.tipoPQRS.hints.tooltip}" id="it1">
                                                    <f:validator binding="#{bindings.tipoPQRS.validator}"/>
                                                </af:inputText>
                                            </af:panelGroupLayout>
                                            <af:spacer width="100" height="10" id="s25"/>
                                            <af:panelGroupLayout id="pg_contenido_3" layout="vertical">
                                                <af:selectBooleanCheckbox label="&#191;Referencia adicional?"
                                                                          id="soc_referencia"
                                                                          value="#{empty bindings.referencia.inputValue?false:true}"
                                                                          autoSubmit="true" readOnly="false"/>
                                                <af:inputText value="#{bindings.referencia.inputValue}"
                                                              maximumLength="200" label="Referencia" readOnly="false"
                                                              id="it_referencia">
                                                    <f:validator binding="#{bindings.referencia.validator}"/>
                                                    <f:validateLength maximum="200"/>
                                                </af:inputText>
                                            </af:panelGroupLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox id="metadatosPnk" text="Gesti&#243;n Documental">
                                        <af:panelFormLayout id="pnlFormGest1" clientComponent="true"
                                                            partialTriggers="sbc_expminero"
                                                            visible="#{!bindings.esTituloMineroBool.inputValue}">
                                            <af:selectOneChoice id="selectCatProceso" showRequired="true"
                                                                shortDesc="#{bindings.idCatProceso.hints.tooltip}"
                                                                autoSubmit="true" clientComponent="true"
                                                                label="Categor&#237;a"
                                                                valueChangeListener="#{RevisarComunicacionJSFBean.cambiarCategoriaProceso}"
                                                                value="#{bindings.idCatProceso.inputValue}">
                                                <f:selectItem itemLabel="Seleccione" id="selCPItm1"/>
                                                <f:selectItems value="#{RevisarComunicacionJSFBean.categoriasProceso}"
                                                               id="selCPItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp1" height="5px"/>
                                            <af:selectOneChoice id="selectProceso" showRequired="true"
                                                                shortDesc="#{bindings.idProceso.hints.tooltip}"
                                                                autoSubmit="true" clientComponent="true" label="Proceso"
                                                                partialTriggers="selectCatProceso"
                                                                valueChangeListener="#{RevisarComunicacionJSFBean.cambiarProceso}"
                                                                value="#{bindings.idProceso.inputValue}">
                                                <f:selectItem itemLabel="Seleccione" id="selPRItm1"/>
                                                <f:selectItems value="#{RevisarComunicacionJSFBean.procesos}"
                                                               id="selPRItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp2" height="5px"/>
                                            <af:selectOneChoice id="selectSerie" showRequired="true"
                                                                shortDesc="#{bindings.idSerie.hints.tooltip}"
                                                                autoSubmit="true" clientComponent="true" label="Serie"
                                                                partialTriggers="selectCatProceso selectProceso"
                                                                valueChangeListener="#{RevisarComunicacionJSFBean.cambiarSerie}"
                                                                value="#{bindings.idSerie.inputValue}">
                                                <f:selectItem itemLabel="Seleccione" id="selSRItm1"/>
                                                <f:selectItems value="#{RevisarComunicacionJSFBean.series}"
                                                               id="selSRItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp3" height="5px"/>
                                            <af:selectOneChoice id="selectSubSerie" showRequired="true"
                                                                shortDesc="#{bindings.idSubSerie.hints.tooltip}"
                                                                autoSubmit="true" clientComponent="true"
                                                                label="Subserie"
                                                                partialTriggers="selectCatProceso selectProceso selectSerie"
                                                                valueChangeListener="#{RevisarComunicacionJSFBean.cambiarSubSerie}"
                                                                visible="#{RevisarComunicacionJSFBean.renderSubserie}"
                                                                value="#{bindings.idSubSerie.inputValue}">
                                                <f:selectItem itemLabel="Seleccione" id="selSSRItm1"/>
                                                <f:selectItems value="#{RevisarComunicacionJSFBean.subseries}"
                                                               id="selSSRItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp4" height="5px"/>
                                            <af:selectOneChoice id="selectCuaderno" showRequired="true"
                                                                shortDesc="#{bindings.idCuaderno.hints.tooltip}"
                                                                label="Expediente" autoSubmit="true"
                                                                clientComponent="true"
                                                                visible="#{RevisarComunicacionJSFBean.renderCuaderno}"
                                                                partialTriggers="selectCatProceso selectProceso selectSerie selectSubSerie"
                                                                valueChangeListener="#{RevisarComunicacionJSFBean.cambiarCuaderno}"
                                                                value="#{bindings.idCuaderno.inputValue}">
                                                <f:selectItem itemLabel="Seleccione" id="selCuaItm1"/>
                                                <f:selectItems value="#{RevisarComunicacionJSFBean.cuadernos}"
                                                               id="selCuaItm2"/>
                                            </af:selectOneChoice>
                                        </af:panelFormLayout>
                                        <af:panelFormLayout id="pnlFormGest2" clientComponent="true"
                                                            partialTriggers="sbc_expminero"
                                                            visible="#{bindings.esTituloMineroBool.inputValue}">
                                            <af:selectOneChoice id="selectTramite" showRequired="true"
                                                                shortDesc="#{bindings.idTramite.hints.tooltip}"
                                                                label="Tr&#225;mite" autoSubmit="true"
                                                                clientComponent="true"
                                                                valueChangeListener="#{RevisarComunicacionJSFBean.cambiarTramite}"
                                                                value="#{bindings.idTramite.inputValue}">
                                                <f:selectItem itemLabel="Seleccione" id="selTramite1"/>
                                                <f:selectItems value="#{RevisarComunicacionJSFBean.tramites}"
                                                               id="selTramites2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp5" height="5px"/>
                                            <af:selectOneChoice id="selectTpDocumento" showRequired="true"
                                                                shortDesc="#{bindings.idTpDocumento.hints.tooltip}"
                                                                label="Tipo Documental" autoSubmit="true"
                                                                clientComponent="true" partialTriggers="selectTramite"
                                                                valueChangeListener="#{RevisarComunicacionJSFBean.cambiarTipoDocumento}"
                                                                value="#{bindings.idTpDocumento.inputValue}">
                                                <f:selectItem itemLabel="Seleccione" id="selTpDoc1"/>
                                                <f:selectItems value="#{RevisarComunicacionJSFBean.tiposDocumentales}"
                                                               id="selTpDoc2"/>
                                            </af:selectOneChoice>
                                        </af:panelFormLayout>
                                    </af:panelBox>
                                    <af:panelBox id="destinatarioPnl" text="Destinatarios" styleClass="AFStretchWidth">
                                        <af:panelCollection id="pc1" styleClass="AFStretchWidth" featuresOff="viewMenu">
                                            <f:facet name="toolbar">
                                                <af:toolbar id="tbDestinatarios">
                                                    <af:button actionListener="#{bindings.CreateInsert5.execute}"
                                                               text="Agregar"
                                                               disabled="#{!bindings.CreateInsert5.enabled}" id="b44"
                                                               visible="#{actionAvailable.updateAvailable}"/>
                                                    <af:button actionListener="#{bindings.Delete5.execute}"
                                                               text="Eliminar" disabled="#{!bindings.Delete5.enabled}"
                                                               visible="#{actionAvailable.updateAvailable}" id="b45"/>
                                                </af:toolbar>
                                            </f:facet>
                                            <af:table value="#{bindings.interesadosExternos.collectionModel}" var="row"
                                                      rows="#{bindings.interesadosExternos.rangeSize}"
                                                      emptyText="#{bindings.interesadosExternos.viewable ? 'No data to display.' : 'Access Denied.'}"
                                                      rowBandingInterval="0"
                                                      selectedRowKeys="#{bindings.interesadosExternos.collectionModel.selectedRow}"
                                                      selectionListener="#{bindings.interesadosExternos.collectionModel.makeCurrent}"
                                                      rowSelection="single" styleClass="AFStretchWidth"
                                                      columnStretching="multiple"
                                                      fetchSize="#{bindings.interesadosExternos.rangeSize}" id="t5">
                                                <af:column headerText="Identificacion" id="c4">
                                                    <af:column headerText="Tipo" id="c9" width="10%">
                                                        <af:selectOneChoice value="#{row.bindings.tipoIdentificacion.inputValue}"
                                                                            label="#{bindings.interesadosExternos.hints.tipoIdentificacion.label}"
                                                                            required="#{bindings.interesadosExternos.hints.tipoIdentificacion.mandatory}"
                                                                            shortDesc="#{bindings.interesadosExternos.hints.tipoIdentificacion.tooltip}"
                                                                            id="soc5">
                                                            <f:selectItems value="#{RevisarComunicacionJSFBean.tiposIdentificacionSet}"
                                                                           id="si11"/>
                                                        </af:selectOneChoice>
                                                    </af:column>
                                                    <af:column headerText="N&#250;mero" id="c10" width="10%">
                                                        <af:inputText value="#{row.bindings.nroIdentificacion.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.nroIdentificacion.label}"
                                                                      required="true" maximumLength="20"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.nroIdentificacion.tooltip}"
                                                                      id="it7">
                                                            <f:validator binding="#{row.bindings.nroIdentificacion.validator}"/>
                                                            <f:validateLength maximum="20"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Primer Nombre" id="c11" width="10%">
                                                        <af:inputText value="#{row.bindings.nombre1.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.nombre1.label}"
                                                                      required="true" maximumLength="100" columns="25"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.nombre1.tooltip}"
                                                                      id="it18">
                                                            <f:validator binding="#{row.bindings.nombre1.validator}"/>
                                                            <f:validateLength maximum="100"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Segundo Nombre" id="c111" width="10%">
                                                        <af:inputText value="#{row.bindings.nombre2.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.nombre2.label}"
                                                                      required="#{bindings.interesadosExternos.hints.nombre2.mandatory}"
                                                                      maximumLength="100" columns="25"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.nombre2.tooltip}"
                                                                      id="it181">
                                                            <f:validator binding="#{row.bindings.nombre2.validator}"/>
                                                            <f:validateLength maximum="100"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Apellido" id="c112" width="10%">
                                                        <af:inputText value="#{row.bindings.apellido1.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.apellido1.label}"
