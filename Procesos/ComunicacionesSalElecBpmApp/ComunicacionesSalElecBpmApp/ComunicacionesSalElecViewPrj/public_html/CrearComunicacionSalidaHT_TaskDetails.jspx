<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <f:view xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:trh="http://myfaces.apache.org/trinidad/html"
            xmlns:wf="http://xmlns.oracle.com/bpel/workflow/workflow-taglib.tld"
            xmlns:wlc="http://xmlns.oracle.com/bpel/workflow/worklist">
        <af:document title="Comunicaci&#243;n Salida - Crear Comunicaci&#243;n" id="d1">
            <af:messages id="m1"/>
            <af:resource type="javascript" source="/jsLibs/taskDetails.js"/>
            <af:resource type="javascript" source="/jsLibs/commonBPM.js"/>
            <af:form id="f1" usesUpload="true">
                <af:panelGroupLayout layout="vertical" inlineStyle="padding: 5px;" id="pgl12">
                    <af:panelHeader text="#{bindings.title1.inputValue}" id="ph1">
                        <f:facet name="info"/>
                        <f:facet name="legend"/>
                        <f:facet name="menuBar"/>
                        <f:facet name="toolbar">
                            <af:toolbar visible="#{actionAvailable.toolbarAvailable}" id="t4">
                                <af:switcher id="customActionButtons"
                                             facetName="#{actionAvailable.isCustomActionButtons}">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="horizontal" id="pgl5">
                                            <af:button actionListener="#{invokeActionBean.setOperation}"
                                                       text="#{wf:getResourceValue('SUBMIT', 'bindings.customActions')}"
                                                       disabled="#{!bindings.SUBMIT.enabled}"
                                                       action="#{CrearComunicacionJSFBean.submit}" partialSubmit="false"
                                                       visible="#{wf:isCustomActionAvailable('SUBMIT', 'bindings.customActions')}"
                                                       id="b2">
                                                <f:attribute name="DC_OPERATION_BINDING" value="bindings.SUBMIT"/>
                                            </af:button>
                                            <af:button id="button_save" textAndAccessKey="#{resources.SAVE}"
                                                       actionListener="#{invokeActionBean.setAction}"
                                                       action="#{invokeActionBean.action}" partialSubmit="false"
                                                       rendered="#{actionAvailable.updateAvailable}">
                                                <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                            </af:button>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                </af:switcher>
                                <af:button actionListener="#{invokeActionBean.setOperation}" text="#{resources.CLAIM}"
                                           id="Claim" action="#{invokeActionBean.invokeOperation}" partialSubmit="false"
                                           visible="#{actionAvailable.claimAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Claim"/>
                                </af:button>
                                <af:button id="acknowledge" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.ACKNOWLEDGE}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.isFyiTask}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Acknowledge"/>
                                </af:button>
                                <af:button id="resume" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.RESUME}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.resumeAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Resume"/>
                                </af:button>
                                <!--menu acciones visible=false-->
                                <af:panelGroupLayout layout="horizontal" id="pgl7" visible="false">
                                    <af:group rendered="#{!((empty actionAvailable.customActions) and (empty actionAvailable.redirectActions) and (empty actionAvailable.otherActions)) || bindings.update.enabled}"
                                              id="g2">
                                        <af:menuBar id="mb1">
                                            <af:menu id="acts" text="#{resources.TASK_ACTIONS}"
                                                     visible="#{actionAvailable.actionsAvailable || bindings.update.enabled}">
                                                <af:group id="g1">
                                                    <af:forEach var="childNode1"
                                                                items="#{actionAvailable.customActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{childNode1.displayName}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi2">
                                                            <f:attribute name="ACTION_MENU_ITEM"
                                                                         value="#{childNode1.action}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g4">
                                                    <af:forEach var="childNode2"
                                                                items="#{actionAvailable.redirectActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode2]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="true" id="cmi1">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode2}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g6">
                                                    <af:forEach var="childNode3"
                                                                items="#{actionAvailable.otherActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode3]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi4">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode3}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g5">
                                                    <af:commandMenuItem id="save" textAndAccessKey="#{resources.SAVE}"
                                                                        actionListener="#{invokeActionBean.setAction}"
                                                                        action="#{invokeActionBean.action}"
                                                                        partialSubmit="false"
                                                                        rendered="#{actionAvailable.updateAvailable}">
                                                        <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                                    </af:commandMenuItem>
                                                </af:group>
                                            </af:menu>
                                        </af:menuBar>
                                    </af:group>
                                </af:panelGroupLayout>
                                <af:spacer width="10" id="s15"/>
                                <af:link shortDesc="#{resources.PREVIOUS_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/nexttraversalarrow_ena.png'  : '/hw_images/previoustraversalarrow_ena.png'}"
                                         action="fetchPreviousTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l2"/>
                                <af:spacer width="10" id="s5"/>
                                <af:link shortDesc="#{resources.NEXT_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/previoustraversalarrow_ena.png' : '/hw_images/nexttraversalarrow_ena.png'}"
                                         action="fetchNextTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l3"/>
                                <af:spacer width="10" id="s16"/>
                                <af:link shortDesc="#{resources.SHORT_DESC_CLOSE}" icon="/hw_images/close_ena.png"
                                         action="closeTaskFlow"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l1"/>
                            </af:toolbar>
                        </f:facet>
                        <f:facet name="context"/>
                        <af:panelStretchLayout id="rootPanel" styleClass="AFStretchWidth" startWidth="10%"
                                               endWidth="10%" dimensionsFrom="children">
                            <f:facet name="start">
                                <af:spacer height="10" width="10px"/>
                            </f:facet>
                            <f:facet name="end">
                                <af:spacer height="10" width="10px"/>
                            </f:facet>
                            <f:facet name="center">
                                <af:panelGroupLayout layout="vertical" id="panelCenter" styleClass="AFStretchWidth">
                                    <af:panelBox id="plantillasPnl" text="Plantillas" styleClass="AFStretchWidth">
                                        <af:table value="#{CrearComunicacionJSFBean.plantillasSet}" var="row" id="t3"
                                                  styleClass="AFStretchWidth" columnStretching="multiple">
                                            <af:column headerText="Nombre" id="c5" width="100%">
                                                <af:link targetFrame="_blank" text="#{row.nombre}"
                                                         destination="#{row.ruta}" id="ot3"/>
                                            </af:column>
                                            <af:column headerText="Creada Por" id="c7" width="30%">
                                                <af:outputText value="#{row.usuarioCreacion}" id="ot5"/>
                                            </af:column>
                                            <af:column headerText="Fecha" id="c8" width="20%">
                                                <af:outputText value="#{row.fechaCreacion}" id="ot6">
                                                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                                                </af:outputText>
                                            </af:column>
                                        </af:table>
                                    </af:panelBox>
                                    <!--af:inputText value="#{bindings.instanceId.inputValue}"
                                                  label="#{bindings.instanceId.hints.label}"
                                                  required="#{bindings.instanceId.hints.mandatory}"
                                                  columns="#{bindings.instanceId.hints.displayWidth}"
                                                  maximumLength="#{bindings.instanceId.hints.precision}"
                                                  shortDesc="#{bindings.instanceId.hints.tooltip}" id="it5">
                                        <f:validator binding="#{bindings.instanceId.validator}"/>
                                    </af:inputText>
                                    <af:inputText value="#{bindings.activityId.inputValue}"
                                                  label="#{bindings.activityId.hints.label}"
                                                  required="#{bindings.activityId.hints.mandatory}"
                                                  columns="#{bindings.activityId.hints.displayWidth}"
                                                  maximumLength="#{bindings.activityId.hints.precision}"
                                                  shortDesc="#{bindings.activityId.hints.tooltip}" id="it6">
                                        <f:validator binding="#{bindings.activityId.validator}"/>
                                    </af:inputText-->
                                    <af:panelBox id="generalPnl" text="General">
                                        <af:panelGroupLayout id="pgl_general" valign="top" layout="horizontal">
                                            <af:panelFormLayout id="pf_general_1">
                                                <af:panelLabelAndMessage label="Fecha Creaci&#243;n" id="plam1">
                                                    <af:outputText value="#{bindings.createdDate.inputValue}" id="ot1">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Fecha Actualizaci&#243;n"
                                                                         id="plam_fechaactualizacion">
                                                    <af:outputText value="#{bindings.updatedDate.inputValue}"
                                                                   id="ot_fechaactualizacion">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:spacer width="10" height="10" id="s3"/>
                                            <af:panelFormLayout id="pf_general_2">
                                                <af:panelLabelAndMessage label="#{bindings.nombre2.hints.label}"
                                                                         id="plam3">
                                                    <af:outputText value="#{bindings.nombre2.inputValue}"
                                                                   shortDesc="#{bindings.nombre2.hints.tooltip}"
                                                                   id="ot7"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="#{bindings.email1.hints.label}"
                                                                         id="plam6">
                                                    <af:outputText value="#{bindings.email1.inputValue}"
                                                                   shortDesc="#{bindings.email1.hints.tooltip}"
                                                                   id="ot10"/>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:spacer width="10" height="10" id="s4"/>
                                            <af:panelFormLayout id="pf_general_3">
                                                <af:panelLabelAndMessage label="Dependencia" id="plam23s">
                                                    <af:outputText value="#{CrearComunicacionJSFBean.dependenciaSelected}"
                                                                   id="ot22s"/>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox id="pb_contenido" text="Contenido">
                                        <af:inputText value="#{bindings.asunto.inputValue}"
                                                      label="#{bindings.asunto.hints.label}" required="true"
                                                      columns="100" maximumLength="500"
                                                      shortDesc="#{bindings.asunto.hints.tooltip}" id="it4">
                                            <f:validator binding="#{bindings.asunto.validator}"/>
                                            <f:validateLength maximum="500"/>
                                        </af:inputText>
                                        <af:spacer id="spacer_01" width="10" height="10"/>
                                        <af:panelGroupLayout id="pg_contenido_1" layout="horizontal">
                                            <af:selectBooleanCheckbox value="#{bindings.esTituloMinero.inputValue}"
                                                                      label="&#191;Expediente Minero?"
                                                                      clientComponent="true" autoSubmit="true"
                                                                      shortDesc="#{bindings.esTituloMinero.hints.tooltip}"
                                                                      valueChangeListener="#{CrearComunicacionJSFBean.cambiarEsExpMinero}"
                                                                      id="sbc1"/>
                                            <af:spacer width="20" height="10" id="s6"/>
                                            <af:inputText value="#{bindings.placa.inputValue}"
                                                          label="#{bindings.placa.hints.label}" showRequired="true"
                                                          valueChangeListener="#{CrearComunicacionJSFBean.validarPlaca}"
                                                          columns="#{bindings.placa.hints.displayWidth}"
                                                          autoSubmit="true" maximumLength="100" clientComponent="true"
                                                          partialTriggers="sbc1"
                                                          visible="#{CrearComunicacionJSFBean.esTituloMinero}"
                                                          shortDesc="#{bindings.placa.hints.tooltip}" id="it1">
                                                <f:validator binding="#{bindings.placa.validator}"/>
                                                <f:validateLength maximum="100"/>
                                            </af:inputText>
                                            <af:spacer width="20" height="10" id="s8"/>
                                            <af:inputText value="#{bindings.referencia.inputValue}"
                                                          label="#{bindings.referencia.hints.label}"
                                                          required="#{bindings.referencia.hints.mandatory}"
                                                          columns="#{bindings.referencia.hints.displayWidth}"
                                                          maximumLength="200"
                                                          shortDesc="#{bindings.referencia.hints.tooltip}" id="it2">
                                                <f:validator binding="#{bindings.referencia.validator}"/>
                                                <f:validateLength maximum="200"/>
                                            </af:inputText>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox id="metadatosPnk" text="Gesti&#243;n Documental">
                                        <af:panelFormLayout id="pnlFormGest1" clientComponent="true"
                                                            partialTriggers="sbc1"
                                                            visible="#{!CrearComunicacionJSFBean.esTituloMinero}">
                                            <af:selectOneChoice id="selectCatProceso" showRequired="true"
                                                                autoSubmit="true" clientComponent="true"
                                                                label="Categor&#237;a"
                                                                valueChangeListener="#{CrearComunicacionJSFBean.cambiarCategoriaProceso}"
                                                                value="#{bindings.idCatProceso.inputValue}">
                                                <f:selectItems value="#{CrearComunicacionJSFBean.categoriasProceso}"
                                                               id="selCPItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp1" height="5px"/>
                                            <af:selectOneChoice id="selectProceso" showRequired="true" autoSubmit="true"
                                                                clientComponent="true" label="Proceso"
                                                                partialTriggers="selectCatProceso"
                                                                valueChangeListener="#{CrearComunicacionJSFBean.cambiarProceso}"
                                                                value="#{bindings.idProceso.inputValue}">
                                                <f:selectItems value="#{CrearComunicacionJSFBean.procesos}"
                                                               id="selPRItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp2" height="5px"/>
                                            <af:selectOneChoice id="selectSerie" showRequired="true" autoSubmit="true"
                                                                clientComponent="true" label="Serie"
                                                                partialTriggers="selectCatProceso selectProceso"
                                                                valueChangeListener="#{CrearComunicacionJSFBean.cambiarSerie}"
                                                                value="#{bindings.idSerie.inputValue}">
                                                <f:selectItems value="#{CrearComunicacionJSFBean.series}"
                                                               id="selSRItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp3" height="5px"/>
                                            <af:selectOneChoice id="selectSubSerie" autoSubmit="true"
                                                                clientComponent="true" label="Subserie"
                                                                visible="#{CrearComunicacionJSFBean.renderSubserie}"
                                                                partialTriggers="selectCatProceso selectProceso selectSerie"
                                                                valueChangeListener="#{CrearComunicacionJSFBean.cambiarSubSerie}"
                                                                value="#{bindings.idSubSerie.inputValue}">
                                                <f:selectItems value="#{CrearComunicacionJSFBean.subseries}"
                                                               id="selSSRItm2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp4" height="5px"/>
                                            <af:selectOneChoice id="selectCuaderno" showRequired="true"
                                                                label="Expediente" autoSubmit="true"
                                                                visible="#{CrearComunicacionJSFBean.renderCuaderno}"
                                                                clientComponent="true"
                                                                partialTriggers="selectCatProceso selectProceso selectSerie selectSubSerie"
                                                                valueChangeListener="#{CrearComunicacionJSFBean.cambiarCuaderno}"
                                                                value="#{bindings.idCuaderno.inputValue}">
                                                <f:selectItems value="#{CrearComunicacionJSFBean.cuadernos}"
                                                               id="selCuaItm2"/>
                                            </af:selectOneChoice>
                                        </af:panelFormLayout>
                                        <af:panelFormLayout id="pnlFormGest2" clientComponent="true"
                                                            partialTriggers="sbc1"
                                                            visible="#{CrearComunicacionJSFBean.esTituloMinero}">
                                            <af:selectOneChoice id="selectTramite" showRequired="true"
                                                                label="Tr&#225;mite" autoSubmit="true"
                                                                clientComponent="true"
                                                                valueChangeListener="#{CrearComunicacionJSFBean.cambiarTramite}"
                                                                value="#{bindings.idTramite.inputValue}">
                                                <f:selectItems value="#{CrearComunicacionJSFBean.tramites}"
                                                               id="selTramites2"/>
                                            </af:selectOneChoice>
                                            <af:spacer id="spp5" height="5px"/>
                                            <af:selectOneChoice id="selectTpDocumento" showRequired="true"
                                                                label="Tipo Documental" autoSubmit="true"
                                                                clientComponent="true" partialTriggers="selectTramite"
                                                                valueChangeListener="#{CrearComunicacionJSFBean.cambiarTipoDocumento}"
                                                                value="#{bindings.idTpDocumento.inputValue}">
                                                <f:selectItems value="#{CrearComunicacionJSFBean.tiposDocumentales}"
                                                               id="selTpDoc2"/>
                                            </af:selectOneChoice>
                                        </af:panelFormLayout>
                                    </af:panelBox>
                                    <af:panelBox id="destinatarioPnl" text="Destinatarios" styleClass="AFStretchWidth">
                                        <af:panelCollection id="pc1" styleClass="AFStretchWidth" featuresOff="viewMenu">
                                            <f:facet name="toolbar">
                                                <af:toolbar id="tbDestinatarios">
                                                    <af:button actionListener="#{bindings.CreateInsertInteresado.execute}"
                                                               text="Agregar"
                                                               disabled="#{!bindings.CreateInsertInteresado.enabled}"
                                                               id="b44" visible="#{actionAvailable.updateAvailable}"/>
                                                    <af:button actionListener="#{bindings.DeleteInteresado.execute}"
                                                               text="Eliminar"
                                                               disabled="#{!bindings.DeleteInteresado.enabled}"
                                                               visible="#{actionAvailable.updateAvailable}" id="b45"/>
                                                </af:toolbar>
                                            </f:facet>
                                            <af:table value="#{bindings.interesadosExternos.collectionModel}" var="row"
                                                      rows="#{bindings.interesadosExternos.rangeSize}"
                                                      emptyText="#{bindings.interesadosExternos.viewable ? 'No data to display.' : 'Access Denied.'}"
                                                      rowBandingInterval="0"
                                                      selectedRowKeys="#{bindings.interesadosExternos.collectionModel.selectedRow}"
                                                      selectionListener="#{bindings.interesadosExternos.collectionModel.makeCurrent}"
                                                      rowSelection="single" styleClass="AFStretchWidth"
                                                      columnStretching="multiple"
                                                      fetchSize="#{bindings.interesadosExternos.rangeSize}" id="t5">
                                                <af:column headerText="Identificacion" id="c4">
                                                    <af:column headerText="Tipo" id="c9" width="10%">
                                                        <af:selectOneChoice value="#{row.bindings.tipoIdentificacion.inputValue}"
                                                                            label="#{bindings.interesadosExternos.hints.tipoIdentificacion.label}"
                                                                            required="#{bindings.interesadosExternos.hints.tipoIdentificacion.mandatory}"
                                                                            shortDesc="#{bindings.interesadosExternos.hints.tipoIdentificacion.tooltip}"
                                                                            id="soc5">
                                                            <f:selectItems value="#{CrearComunicacionJSFBean.tiposIdentificacionSet}"
                                                                           id="si11"/>
                                                        </af:selectOneChoice>
                                                    </af:column>
                                                    <af:column headerText="N&#250;mero" id="c10" width="10%">
                                                        <af:inputText value="#{row.bindings.nroIdentificacion.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.nroIdentificacion.label}"
                                                                      required="true" maximumLength="20"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.nroIdentificacion.tooltip}"
                                                                      id="it7">
                                                            <f:validator binding="#{row.bindings.nroIdentificacion.validator}"/>
                                                            <f:validateLength maximum="20"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Nombre" id="c11" width="10%">
                                                        <af:inputText value="#{row.bindings.nombre1.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.nombre1.label}"
                                                                      required="true" maximumLength="100" columns="25"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.nombre1.tooltip}"
                                                                      id="it8">
                                                            <f:validator binding="#{row.bindings.nombre1.validator}"/>
                                                            <f:validateLength maximum="100"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Segundo Nombre" id="c111" width="10%">
                                                        <af:inputText value="#{row.bindings.nombre2.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.nombre2.label}"
                                                                      required="#{bindings.interesadosExternos.hints.nombre2.mandatory}"
                                                                      maximumLength="100" columns="25"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.nombre2.tooltip}"
                                                                      id="it18">
                                                            <f:validator binding="#{row.bindings.nombre2.validator}"/>
                                                            <f:validateLength maximum="100"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Apellido" id="c112" width="10%">
                                                        <af:inputText value="#{row.bindings.apellido1.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.apellido1.label}"
                                                                      required="#{bindings.interesadosExternos.hints.apellido1.mandatory}"
                                                                      maximumLength="100" columns="25"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.apellido1.tooltip}"
                                                                      id="it19">
                                                            <f:validator binding="#{row.bindings.apellido1.validator}"/>
                                                            <f:validateLength maximum="100"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Segundo Apellido" id="c113" width="10%">
                                                        <af:inputText value="#{row.bindings.apellido2.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.apellido2.label}"
                                                                      required="#{bindings.interesadosExternos.hints.apellido2.mandatory}"
                                                                      maximumLength="100" columns="25"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.apellido2.tooltip}"
                                                                      id="it20">
                                                            <f:validator binding="#{row.bindings.apellido2.validator}"/>
                                                            <f:validateLength maximum="100"/>
                                                        </af:inputText>
                                                    </af:column>
                                                </af:column>
                                                <af:column headerText="Datos de Contacto" id="c12">
                                                    <af:column headerText="Celular" id="c_celular" width="10%">
                                                        <af:inputText value="#{row.bindings.celular.inputValue}"
                                                                      label="Celular" columns="13" required="true"
                                                                      maximumLength="20"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.celular.tooltip}"
                                                                      id="it_celular">
                                                            <f:validator binding="#{row.bindings.celular.validator}"/>
                                                            <f:validateLength maximum="20"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Telef&#243;no" id="c13" width="10%">
                                                        <af:inputText value="#{row.bindings.telefono.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.telefono.label}"
                                                                      required="true" maximumLength="20"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.telefono.tooltip}"
                                                                      id="it9">
                                                            <f:validator binding="#{row.bindings.telefono.validator}"/>
                                                            <f:validateLength maximum="20"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Correo Electr&#243;nico" id="c14"
                                                               width="20%">
                                                        <af:inputText value="#{row.bindings.email.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.email.label}"
                                                                      required="true" columns="100" maximumLength="200"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.email.tooltip}"
                                                                      id="it11">
                                                            <f:validator binding="#{row.bindings.email.validator}"/>
                                                            <f:validateLength maximum="200"/>
                                                        </af:inputText>
                                                    </af:column>
                                                    <af:column headerText="Direcci&#243;n" id="c15" width="30%">
                                                        <af:inputText value="#{row.bindings.direccionCorrespondencia.inputValue}"
                                                                      label="#{bindings.interesadosExternos.hints.direccionCorrespondencia.label}"
                                                                      required="true" maximumLength="200" columns="150"
                                                                      shortDesc="#{bindings.interesadosExternos.hints.direccionCorrespondencia.tooltip}"
                                                                      id="it12">
                                                            <f:validator binding="#{row.bindings.direccionCorrespondencia.validator}"/>
                                                            <f:validateLength maximum="200"/>
                                                        </af:inputText>
                                                    </af:column>
                                                </af:column>
                                            </af:table>
                                        </af:panelCollection>
                                    </af:panelBox>
                                    <af:panelBox id="adjuntosPnl" text="Adjuntos">
                                        <af:inputFile label="Documento Principal" id="if1" autoSubmit="true"
                                                      showRequired="true" binding="#{CrearComunicacionJSFBean.ifAnexo}"
                                                      valueChangeListener="#{CrearComunicacionJSFBean.cambiarDocPpal}"/>
                                        <af:spacer width="30" height="30" id="s11"/>
                                        <wlc:manageDocuments docBean="#{pageFlowScope.docMgmtBean}" id="manageDocs"
                                                             rendered="#{!actionAvailable.inNotificationClient}"/>
                                    </af:panelBox>
                                    <af:spacer height="20px" id="spRoot6"/>
                                    <af:popup id="popupAddCommentDialog" contentDelivery="lazyUncached"
                                              popupCanceledListener="#{invokeActionBean.commentsPopupCanceled}"
                                              attributeChangeListener="#{bindings.CreateInsert1.execute}"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.CREATE_COMMENT}" type="none" modal="true"
                                                   id="cmtDlg">
                                            <f:facet name="buttonBar">
                                                <af:panelGroupLayout id="pgl10">
                                                    <af:button textAndAccessKey="#{resources.OK_AK}" id="cmtOK"
                                                               action="#{popupBean.hideCommentDialog}"
                                                               partialSubmit="true"/>
                                                    <af:button textAndAccessKey="#{resources.CANCEL_AK}"
                                                               actionListener="#{bindings.Delete1.execute}"
                                                               immediate="true" partialSubmit="true" id="cmtCan"
                                                               action="#{popupBean.hideCommentDialog}"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <af:panelGroupLayout id="pgl8">
                                                <af:panelFormLayout id="pfl3">
                                                    <f:facet name="footer"/>
                                                    <af:inputText id="cmtBox" rows="3" columns="80"
                                                                  value="#{bindings.comment.inputValue}"
                                                                  label="#{resources.COMMENT}" required="true"
                                                                  maximumLength="1999"/>
                                                    <af:selectOneRadio value="#{bindings.commentScope.inputValue}"
                                                                       label="#{resources.UPLOAD_TO_PROCESS}"
                                                                       id="uploadToProcComment"
                                                                       visible="#{pageFlowScope.ADFHumanTaskBean.taskBelongsToProcess and !pageFlowScope.ADFHumanTaskBean.isCaseTask}"
                                                                       layout="vertical">
                                                        <af:selectItem label="#{resources.TASK}" value="TASK" id="si1"/>
                                                        <af:selectItem label="#{resources.BPM}" value="BPM" id="si4"/>
                                                    </af:selectOneRadio>
                                                </af:panelFormLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="popupAddAttachmentDialog" contentDelivery="lazyUncached"
                                              popupCanceledListener="#{invokeActionBean.attachmentsPopupCanceled}"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.ADD_ATTACHMENT}" type="none" id="d2">
                                            <f:facet name="buttonBar">
                                                <af:panelGroupLayout id="pgl17">
                                                    <af:button id="addAtOK" action="#{addAttachmentBean.attachmentOK}"
                                                               textAndAccessKey="#{resources.OK_AK}"
                                                               partialSubmit="true"/>
                                                    <af:button id="attCan" textAndAccessKey="#{resources.CANCEL_AK}"
                                                               actionListener="#{bindings.Delete2.execute}"
                                                               action="#{addAttachmentBean.clear}" immediate="true"
                                                               partialSubmit="true"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <af:panelGroupLayout layout="vertical" id="pgl16">
                                                <af:panelFormLayout id="pfl12">
                                                    <af:selectOneRadio value="#{bindings.attachmentScope.inputValue}"
                                                                       label="#{resources.UPLOAD_TO_PROCESS}"
                                                                       id="uploadToProcAttach"
                                                                       visible="#{pageFlowScope.ADFHumanTaskBean.taskBelongsToProcess and !pageFlowScope.ADFHumanTaskBean.isCaseTask}"
                                                                       layout="vertical">
                                                        <af:selectItem label="#{resources.TASK}" value="TASK" id="si2"/>
                                                        <af:selectItem label="#{resources.BPM}" value="BPM" id="si7"/>
                                                    </af:selectOneRadio>
                                                </af:panelFormLayout>
                                                <af:inputText id="edAttTy" label="edAttTy" visible="false"/>
                                                <af:panelGroupLayout layout="vertical" partialTriggers="edAttTy"
                                                                     id="pgl4">
                                                    <af:inputText id="attName" label="#{resources.NAME}"
                                                                  value="#{bindings.name.inputValue}"
                                                                  required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'url'}"
                                                                  partialTriggers="edAttTy" maximumLength="128"/>
                                                    <af:switcher facetName="#{pageFlowScope.readAttachmentBean.selectedAttachmentType}"
                                                                 id="s2">
                                                        <f:facet name="url">
                                                            <af:panelFormLayout id="pfl2">
                                                                <af:inputText id="attHref" label="#{resources.URL}"
                                                                              value="#{bindings.URI.inputValue}"
                                                                              required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'url'}"
                                                                              partialTriggers="edAttTy"
                                                                              maximumLength="256"/>
                                                            </af:panelFormLayout>
                                                        </f:facet>
                                                        <f:facet name="file">
                                                            <af:panelGroupLayout layout="vertical" id="pgl3">
                                                                <af:panelFormLayout id="pfl11">
                                                                    <af:inputFile label="#{resources.FILE_NAME}"
                                                                                  value="#{addAttachmentBean.file}"
                                                                                  id="attFile" required="true"
                                                                                  partialTriggers="edAttTy"/>
                                                                    <af:inputText label="#{resources.ALLOWED_FILE_EXT}"
                                                                                  value="#{addAttachmentBean.allowedExtensions}"
                                                                                  visible="#{!empty addAttachmentBean.allowedExtensions and pageFlowScope.readAttachmentBean.selectedAttachmentType == 'file'}"
                                                                                  partialTriggers="edAttTy" id="it26"/>
                                                                    <af:inputText label="#{resources.DESCRIPTION}"
                                                                                  value="#{pageFlowScope.ADFHumanTaskBean.docComments}"
                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.docCommentsShow}"
                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.docCommentsEdit}"
                                                                                  rows="4" id="it10"/>
                                                                </af:panelFormLayout>
                                                                <af:spacer height="10" width="10" id="s12"/>
                                                                <af:switcher facetName="#{pageFlowScope.ADFHumanTaskBean.isUsingUCM}"
                                                                             id="s1">
                                                                    <f:facet name="true">
                                                                        <af:panelFormLayout id="pfl1">
                                                                            <af:inputText id="attDir"
                                                                                          label="#{resources.FOLDER_NAME}"
                                                                                          value="#{pageFlowScope.ADFHumanTaskBean.folder}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.folderShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.folderEdit}"
                                                                                          maximumLength="256">
                                                                                <af:autoSuggestBehavior suggestedItems="#{pageFlowScope.ADFHumanTaskBean.onFolderSuggest}"/>
                                                                            </af:inputText>
                                                                            <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.docType}"
                                                                                                label="#{resources.DOCUMENT_TYPE}"
                                                                                                visible="#{pageFlowScope.ADFHumanTaskBean.docTypeShow}"
                                                                                                partialTriggers="edAttTy"
                                                                                                readOnly="#{!pageFlowScope.ADFHumanTaskBean.docTypeEdit}"
                                                                                                required="true"
                                                                                                id="soc1">
                                                                                <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.documentTypeList}"
                                                                                               id="si5"/>
                                                                            </af:selectOneChoice>
                                                                            <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.account}"
                                                                                                label="#{resources.ACCOUNT}"
                                                                                                visible="#{pageFlowScope.ADFHumanTaskBean.accountShow}"
                                                                                                partialTriggers="edAttTy"
                                                                                                readOnly="#{!pageFlowScope.ADFHumanTaskBean.accountEdit}"
                                                                                                rendered="#{!empty pageFlowScope.ADFHumanTaskBean.accountList}"
                                                                                                id="soc3">
                                                                                <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.accountList}"
                                                                                               id="si6"/>
                                                                            </af:selectOneChoice>
                                                                            <af:inputText value="#{pageFlowScope.ADFHumanTaskBean.revision}"
                                                                                          label="#{resources.REVISION}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.revisionShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.revisionEdit}"
                                                                                          id="it3"/>
                                                                            <af:switcher facetName="#{!empty pageFlowScope.dateTimePattern}"
                                                                                         id="s10">
                                                                                <f:facet name="true">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.releaseDate}"
                                                                                                  label="#{resources.RELEASE_DATE}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.releaseDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  id="id6">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           pattern="#{pageFlowScope.dateTimePattern}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                                <f:facet name="false">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.releaseDate}"
                                                                                                  label="#{resources.RELEASE_DATE}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.releaseDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  id="id2">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                            </af:switcher>
                                                                            <af:switcher facetName="#{!empty pageFlowScope.dateTimePattern}"
                                                                                         id="s20">
                                                                                <f:facet name="true">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.expirationDate}"
                                                                                                  label="#{resources.EXPIRATION_DATE}"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.expirationDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  id="id3">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           pattern="#{pageFlowScope.dateTimePattern}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                                <f:facet name="false">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.expirationDate}"
                                                                                                  label="#{resources.EXPIRATION_DATE}"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.expirationDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  id="id5">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                            </af:switcher>
                                                                            <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.securityGroup}"
                                                                                                label="#{resources.SECURITY_GROUP}"
                                                                                                visible="#{pageFlowScope.ADFHumanTaskBean.secGroupShow}"
                                                                                                required="true"
                                                                                                readOnly="#{!pageFlowScope.ADFHumanTaskBean.secGroupEdit}"
                                                                                                partialTriggers="edAttTy"
                                                                                                id="soc2">
                                                                                <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.securityGroupList}"
                                                                                               id="si3"/>
                                                                            </af:selectOneChoice>
                                                                        </af:panelFormLayout>
                                                                    </f:facet>
                                                                </af:switcher>
                                                            </af:panelGroupLayout>
                                                        </f:facet>
                                                        <f:facet name="ucm">
                                                            <af:panelGroupLayout layout="vertical" id="pgl15">
                                                                <af:inputListOfValues label="#{resources.DOCUMENT_ID}"
                                                                                      id="idInputComboboxLOVWithTable"
                                                                                      value="#{pageFlowScope.readAttachmentBean.ucmDocId}"
                                                                                      autoSubmit="true"
                                                                                      popupTitle="#{resources.SRCH_SLCT_DOC_ID}"
                                                                                      searchDesc="#{resources.SRCH_SLCT_DOC_ID}"
                                                                                      partialTriggers="edAttTy"
                                                                                      model="#{pageFlowScope.ADFHumanTaskBean.listOfValuesModel}"
                                                                                      columns="60"
                                                                                      required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}"
                                                                                      rendered="#{pageFlowScope.ADFHumanTaskBean.isUsingUCM}"
                                                                                      visible="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}"/>
                                                            </af:panelGroupLayout>
                                                        </f:facet>
                                                    </af:switcher>
                                                </af:panelGroupLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="popupDeleteAttachmentDialog" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.DELETE_ATTACHMENT}" type="none" modal="true"
                                                   closeIconVisible="false" id="attDelDlg">
                                            <f:facet name="buttonBar">
                                                <af:panelGroupLayout id="pgl1">
                                                    <af:button textAndAccessKey="#{resources.OK_AK}"
                                                               actionListener="#{bindings.Delete2.execute}"
                                                               immediate="true" partialSubmit="true" id="delAtOK"
                                                               action="#{popupBean.hideAttachmentDeleteDialog}"/>
                                                    <af:button textAndAccessKey="#{resources.CANCEL_AK}" id="delAtCan"
                                                               action="#{popupBean.hideAttachmentDeleteDialog}"
                                                               partialSubmit="true"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <af:panelGroupLayout id="pgl6">
                                                <af:panelFormLayout id="pfl8">
                                                    <af:outputText id="delAttTxt"
                                                                   value="#{resources.DELETE_ATTACHMENT_MSG}"/>
                                                </af:panelFormLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="reassignPopup" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog id="reAsDg" dialogListener="#{invokeActionBean.reassignAction}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   title="#{resources.REASSIGNPAGE}">
                                            <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                                 workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                                 id="reAsIdB" mode="REASSIGN" showActionButtons="false"
                                                                 selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="requestInfoPopup" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.INFOREQUESTEDPAGE}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   dialogListener="#{invokeActionBean.requestInfoAction}" id="reqIfD">
                                            <wlc:requestInfoDialog workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                                   id="rqIDgC"
                                                                   selectedTaskId="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds[0]}"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="routePopup" contentDelivery="lazyUncached" childCreation="deferred">
                                        <af:dialog title="#{resources.ROUTEPAGE}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   dialogListener="#{invokeActionBean.routeTaskAction}" id="rteDg">
                                            <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                                 workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                                 id="rteIdB" mode="ROUTE"
                                                                 selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}"
                                                                 showActionButtons="false"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="decomposePopup" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{pageFlowScope.ADFHumanTaskBean.decomposeDialogTitle}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   dialogListener="#{invokeActionBean.decomposeTaskAction}" id="dcmpDg">
                                            <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                                 workflowContext="#{pageFlowScope.ADFHumanTaskBean.workflowContext}"
                                                                 id="dcmpIdB" mode="DECOMPOSE"
                                                                 selectedTaskObject="#{pageFlowScope.ADFHumanTaskBean.task}"
                                                                 showActionButtons="false"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="popupEnterPasswordDialog" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.ENTER_PASSWORD}"
                                                   dialogListener="#{invokeActionBean.validatePassword}" type="okCancel"
                                                   modal="true" cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   closeIconVisible="false" id="pwdDlg">
                                            <af:panelGroupLayout id="pgl14">
                                                <af:panelFormLayout id="pfl5">
                                                    <af:inputText id="pwdBox" rows="1" columns="50"
                                                                  value="#{invokeActionBean.password}"
                                                                  label="#{resources.PASSWORD}" secret="true"
                                                                  required="true"/>
                                                </af:panelFormLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="helpPopup" childCreation="deferred">
                                        <af:switcher facetName="#{pageFlowScope.taskDocumentationBean.isTaskDoc}"
                                                     id="s7">
                                            <f:facet name="true">
                                                <af:panelGroupLayout layout="vertical" id="pgl2">
                                                    <af:link text="#{resources.OPEN_IN_WINDOW}"
                                                             destination="#{pageFlowScope.taskDocumentationBean.docURL}"
                                                             targetFrame="help" id="help"
                                                             rendered="#{!empty bindings.activityId.inputValue}"/>
                                                    <af:outputFormatted value="#{pageFlowScope.taskDocumentationBean.taskDoc}"
                                                                        id="of1"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <f:facet name="false">
                                                <af:outputText value="#{resources.TASK_DOC_NOT_AVAILABLE}" id="ot17"/>
                                            </f:facet>
                                        </af:switcher>
                                    </af:popup>
                                </af:panelGroupLayout>
                            </f:facet>
                        </af:panelStretchLayout>
                    </af:panelHeader>
                    <f:facet name="separator"/>
                </af:panelGroupLayout>
            </af:form>
        </af:document>
    </f:view>
</jsp:root>