<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <f:view xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:trh="http://myfaces.apache.org/trinidad/html"
            xmlns:wf="http://xmlns.oracle.com/bpel/workflow/workflow-taglib.tld"
            xmlns:wlc="http://xmlns.oracle.com/bpel/workflow/worklist" >
        <af:document title="DescargarImprimirHT_TaskDetails.jspx" id="d1">
            <af:messages id="m1"/>
            <af:resource type="javascript" source="/jsLibs/taskDetails.js"/>
            <af:resource type="javascript" source="/jsLibs/commonBPM.js"/>
            <af:form id="f1" usesUpload="true">
                <af:panelGroupLayout layout="vertical" inlineStyle="padding: 5px;" id="pgl7">
                    <af:panelHeader text="#{bindings.title.inputValue}" id="ph1">
                        <f:facet name="info"/>
                        <f:facet name="legend"/>
                        <f:facet name="menuBar"/>
                        <f:facet name="toolbar">
                            <af:toolbar visible="#{actionAvailable.toolbarAvailable}" id="t4">
                                <af:switcher id="customActionButtons"
                                             facetName="#{actionAvailable.isCustomActionButtons}">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="horizontal" id="pgl18">
                                            <!--<af:button actionListener="#{invokeActionBean.setOperation}"
                                                       text="#{wf:getResourceValue('ACCEPT', 'bindings.customActions')}"
                                                       disabled="#{!bindings.ACCEPT.enabled}"
                                                       action="#{invokeActionBean.invokeOperation}"
                                                       partialSubmit="false"
                                                       visible="#{wf:isCustomActionAvailable('ACCEPT', 'bindings.customActions')}"
                                                       id="b2">
                                                <f:attribute name="DC_OPERATION_BINDING" value="bindings.ACCEPT"/>
                                            </af:button>-->
                                            <af:button id="btn_aceptar" text="Aceptar">
                                                <af:showPopupBehavior popupId="popup_accept"/>
                                            </af:button>
                                            <af:popup childCreation="deferred" autoCancel="disabled" id="popup_accept">
                                                <af:dialog title="Mensaje" id="d3" type="cancel">
                                                    <af:panelGroupLayout layout="vertical" id="pgl5" halign="center">
                                                        <af:outputText id="ot_mensaje"
                                                                       value="&#191;Esta seguro que desea cerrar esta actividad?"/>
                                                        <af:spacer width="10" height="10" id="s19"/>
                                                        <af:outputText id="ot18"
                                                                       value="Recuerde que previamente tuvo que haber descargado el documento principal."/>
                                                        <af:spacer width="10" height="10" id="s20"/>
                                                    </af:panelGroupLayout>
                                                    <f:facet name="buttonBar">
                                                        <af:button actionListener="#{invokeActionBean.setOperation}"
                                                                   text="#{wf:getResourceValue('ACCEPT', 'bindings.customActions')}"
                                                                   disabled="#{!bindings.ACCEPT.enabled}"
                                                                   action="#{invokeActionBean.invokeOperation}"
                                                                   partialSubmit="false"
                                                                   visible="#{wf:isCustomActionAvailable('ACCEPT', 'bindings.customActions')}"
                                                                   id="b2">
                                                            <f:attribute name="DC_OPERATION_BINDING"
                                                                         value="bindings.ACCEPT"/>
                                                        </af:button>
                                                    </f:facet>
                                                </af:dialog>
                                            </af:popup>
                                            <af:button id="button_save" textAndAccessKey="#{resources.SAVE}"
                                                       actionListener="#{invokeActionBean.setAction}"
                                                       action="#{invokeActionBean.action}" partialSubmit="false"
                                                       rendered="#{actionAvailable.updateAvailable}">
                                                <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                            </af:button>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                </af:switcher>
                                <af:button actionListener="#{invokeActionBean.setOperation}" text="#{resources.CLAIM}"
                                           id="Claim" action="#{invokeActionBean.invokeOperation}" partialSubmit="false"
                                           visible="#{actionAvailable.claimAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Claim"/>
                                </af:button>
                                <af:button id="acknowledge" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.ACKNOWLEDGE}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.isFyiTask}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Acknowledge"/>
                                </af:button>
                                <af:button id="resume" actionListener="#{invokeActionBean.setOperation}"
                                           text="#{resources.RESUME}" action="#{invokeActionBean.invokeOperation}"
                                           partialSubmit="false" visible="#{actionAvailable.resumeAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Resume"/>
                                </af:button>
                                <!--menu actions visible=false-->
                                <af:panelGroupLayout layout="horizontal" id="pgl24" visible="false">
                                    <af:group rendered="#{!((empty actionAvailable.customActions) and (empty actionAvailable.redirectActions) and (empty actionAvailable.otherActions)) || bindings.update.enabled}"
                                              id="g5">
                                        <af:menuBar id="mb1">
                                            <af:menu id="acts" text="#{resources.TASK_ACTIONS}"
                                                     visible="#{actionAvailable.actionsAvailable || bindings.update.enabled}">
                                                <af:group id="g6">
                                                    <af:forEach var="childNode1"
                                                                items="#{actionAvailable.customActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{childNode1.displayName}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi2">
                                                            <f:attribute name="ACTION_MENU_ITEM"
                                                                         value="#{childNode1.action}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g3">
                                                    <af:forEach var="childNode2"
                                                                items="#{actionAvailable.redirectActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode2]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="true" id="cmi1">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode2}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g4">
                                                    <af:forEach var="childNode3"
                                                                items="#{actionAvailable.otherActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode3]}"
                                                                            actionListener="#{invokeActionBean.setAction}"
                                                                            action="#{invokeActionBean.action}"
                                                                            partialSubmit="false" id="cmi4">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode3}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g2">
                                                    <af:commandMenuItem id="save" textAndAccessKey="#{resources.SAVE}"
                                                                        actionListener="#{invokeActionBean.setAction}"
                                                                        action="#{invokeActionBean.action}"
                                                                        partialSubmit="false"
                                                                        rendered="#{actionAvailable.updateAvailable}">
                                                        <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                                    </af:commandMenuItem>
                                                </af:group>
                                            </af:menu>
                                        </af:menuBar>
                                    </af:group>
                                </af:panelGroupLayout>
                                <af:spacer width="10" id="s15"/>
                                <af:link shortDesc="#{resources.PREVIOUS_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/nexttraversalarrow_ena.png'  : '/hw_images/previoustraversalarrow_ena.png'}"
                                         action="fetchPreviousTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l1"/>
                                <af:spacer width="10" id="s4"/>
                                <af:link shortDesc="#{resources.NEXT_TASK}"
                                         icon="#{ adfFacesContext.rightToLeft ? '/hw_images/previoustraversalarrow_ena.png' : '/hw_images/nexttraversalarrow_ena.png'}"
                                         action="fetchNextTask"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l2"/>
                                <af:spacer width="10" id="s6"/>
                                <af:link shortDesc="#{resources.SHORT_DESC_CLOSE}" icon="/hw_images/close_ena.png"
                                         action="closeTaskFlow"
                                         visible="#{pageFlowScope.enableNavigationButton != null}" id="l3"/>
                            </af:toolbar>
                        </f:facet>
                        <f:facet name="context"/>
                        <af:panelGroupLayout layout="vertical" id="pgl_vertical">
                            <f:facet name="separator">
                                <af:spacer width="15" height="15" id="s3"/>
                            </f:facet>
                            <af:showDetailHeader size="2" id="apCntHd" text="Contenido" disclosed="true">
                                <af:panelGroupLayout layout="vertical" id="panelCenter" styleClass="AFStretchWidth">
                                    <af:panelBox id="pb_general" text="General">
                                        <af:panelGroupLayout id="pgl3" layout="horizontal" valign="top"
                                                             styleClass="AFStretchWidth">
                                            <af:panelFormLayout id="pf_radicacion">
                                                <af:panelLabelAndMessage label="No. Radicado" id="plam_numradicado">
                                                    <af:outputText value="#{bindings.nroRadicado.inputValue}"
                                                                   id="ot_numradicado"></af:outputText>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Fecha Radicaci&#243;n"
                                                                         id="plam_fecharadicacion">
                                                    <af:outputText value="#{bindings.fechaRadicacion.inputValue}"
                                                                   id="ot_fecharadicacion">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:panelFormLayout id="pf_fechas">
                                                <af:panelLabelAndMessage label="Fecha Creaci&#243;n"
                                                                         id="plam_fechacreacion">
                                                    <af:outputText value="#{bindings.fechaCreacion.inputValue}"
                                                                   id="ot1">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Fecha Actualizaci&#243;n"
                                                                         id="plam_fechaactualizacion">
                                                    <af:outputText value="#{bindings.updatedDate.inputValue}"
                                                                   id="ot_fechaactualizacion">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="No. Radicado Relacionado" id="plam2"
                                                                         visible="#{bindings.esRespComunicacionEntrada.inputValue}">
                                                    <af:link text="#{bindings.nroRadicadoRelacionado.inputValue}"
                                                             destination="#{bindings.urlDocumentoPpalRelacionado.inputValue}"
                                                             id="relLink"/>
                                                </af:panelLabelAndMessage>
                                                <af:inputText value="#{bindings.esRespComunicacionEntrada.inputValue}"
                                                              visible="false"
                                                              label="#{bindings.esRespComunicacionEntrada.hints.label}"
                                                              required="#{bindings.esRespComunicacionEntrada.hints.mandatory}"
                                                              columns="#{bindings.esRespComunicacionEntrada.hints.displayWidth}"
                                                              maximumLength="#{bindings.esRespComunicacionEntrada.hints.precision}"
                                                              shortDesc="#{bindings.esRespComunicacionEntrada.hints.tooltip}"
                                                              id="it3">
                                                    <f:validator binding="#{bindings.esRespComunicacionEntrada.validator}"/>
                                                </af:inputText>
                                            </af:panelFormLayout>
                                            <af:panelFormLayout id="pf_respuesta"
                                                                visible="#{bindings.esRespComunicacionEntrada.inputValue}">
                                                <af:panelLabelAndMessage label="Tiempo Respuesta" id="plam4">
                                                    <af:outputText value="#{bindings.tiempoRespuesta.inputValue}"
                                                                   id="ot3">
                                                        <af:convertNumber groupingUsed="false"
                                                                          pattern="#{bindings.tiempoRespuesta.format}"/>
                                                    </af:outputText>
                                                    <af:outputText value="   (d&#237;as h&#225;biles)"
                                                                   id="ot_diashabiles"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Fecha Vencimiento"
                                                                         id="plam_fechavencimiento">
                                                    <af:outputText value="#{bindings.fechaVencimiento.inputValue}"
                                                                   id="ot_fechavencimiento">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:panelFormLayout id="pf_funcionario">
                                                <af:panelLabelAndMessage label="Funcionario" id="plam_funcionario">
                                                    <af:outputText value="#{bindings.nombre2.inputValue}"
                                                                   shortDesc="#{bindings.nombre2.hints.tooltip}"
                                                                   id="ot_funcionario"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Dependencia" id="plam23s">
                                                    <af:outputText value="#{bindings.dependenciaOrigen.inputValue}"
                                                                   id="ot_dependencia"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="#{bindings.email1.hints.label}"
                                                                         id="plam_email">
                                                    <af:outputText value="#{bindings.email1.inputValue}" id="ot_email"/>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox id="pb_contenido" text="Contenido">
                                        <af:inputText id="it_asunto" label="Asunto" readOnly="true"
                                                      value="#{bindings.asunto.inputValue}"></af:inputText>
                                        <af:panelGroupLayout id="pg_contenido_0" layout="horizontal">
                                            <af:panelGroupLayout id="pg_contenido_1" layout="vertical">
                                                <af:selectBooleanCheckbox value="#{bindings.esTituloMinero.inputValue eq 'SI'}"
                                                                          label="&#191;Relaci&#243;n con Expediente Minero?"
                                                                          autoSubmit="true" id="sbc_expminero"
                                                                          readOnly="true"/>
                                                <af:inputText id="it_placa" label="Placa" readOnly="true"
                                                              value="#{bindings.placa.inputValue}"></af:inputText>
                                            </af:panelGroupLayout>
                                            <af:spacer width="100" height="10" id="s21"/>
                                            <af:panelGroupLayout id="pg_contenido_2" layout="vertical">
                                                <af:selectBooleanCheckbox value="#{bindings.esPqrs.inputValue eq 'S'}"
                                                                          id="sbc_pqrs" label="&#191;PQRS?"
                                                                          visible="#{bindings.esRespComunicacionEntrada.inputValue}"
                                                                          readOnly="true"/>
                                                <af:inputText id="it_pqrs" value="#{bindings.tipoPQRS.inputValue}"
                                                visible="#{bindings.esRespComunicacionEntrada.inputValue}"
                                                              label="Tipo PQRS" readOnly="true"></af:inputText>
                                                <!--<af:inputText value="#{bindings.tipoPQRS.inputValue}"
                                                              label="#{bindings.tipoPQRS.hints.label}"
                                                              required="#{bindings.tipoPQRS.hints.mandatory}"
                                                              columns="#{bindings.tipoPQRS.hints.displayWidth}"
                                                              maximumLength="#{bindings.tipoPQRS.hints.precision}"
                                                              shortDesc="#{bindings.tipoPQRS.hints.tooltip}" id="it4">
                                                    <f:validator binding="#{bindings.tipoPQRS.validator}"/>
                                                </af:inputText>-->
                                            </af:panelGroupLayout>
                                            <af:spacer width="100" height="10" id="s25"/>
                                            <af:panelGroupLayout id="pg_contenido_3" layout="vertical">
                                                <af:selectBooleanCheckbox label="&#191;Referencia adicional?"
                                                                          id="soc_referencia"
                                                                          value="#{empty bindings.referencia.inputValue?false:true}"
                                                                          autoSubmit="true" readOnly="true"/>
                                                <af:inputText value="#{bindings.referencia.inputValue}"
                                                              label="Referencia" readOnly="true" id="it_referencia">
                                                    <f:validator binding="#{bindings.referencia.validator}"/>
                                                </af:inputText>
                                            </af:panelGroupLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox id="metadatosPnk" text="Gesti&#243;n Documental">
                                        <af:panelFormLayout id="tab1Form1"
                                                            rendered="#{bindings.esTituloMinero.inputValue == 'NO'}">
                                            <af:panelLabelAndMessage label="Documento Principal" id="docPrincipalPnl">
                                                <af:link targetFrame="_blank" text="#{bindings.nroRadicado.inputValue}"
                                                         destination="#{bindings.urlDocumentoPrincipal}" id="lnkDoc"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="Categor&#237;a" id="idCatProcesoID">
                                                <af:outputText value="#{bindings.catProceso.inputValue}"
                                                               shortDesc="#{bindings.catProceso.hints.tooltip}"
                                                               id="idCatProcesoOt"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="#{bindings.proceso.hints.label}"
                                                                     id="procesoId">
                                                <af:outputText value="#{bindings.proceso.inputValue}"
                                                               shortDesc="#{bindings.proceso.hints.tooltip}"
                                                               id="procesoOt"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="#{bindings.serie.hints.label}" id="serieId">
                                                <af:outputText value="#{bindings.serie.inputValue}"
                                                               shortDesc="#{bindings.serie.hints.tooltip}"
                                                               id="serieOt"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="#{bindings.subserie.hints.label}"
                                                                     visible="#{not empty bindings.subserie.inputValue}"
                                                                     id="subserieId">
                                                <af:outputText value="#{bindings.subserie.inputValue}"
                                                               shortDesc="#{bindings.subserie.hints.tooltip}"
                                                               id="subserieOt"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="Expediente" id="cuadernoId"
                                                                     visible="#{not empty bindings.cuaderno.inputValue}">
                                                <af:outputText value="#{bindings.cuaderno.inputValue}"
                                                               shortDesc="#{bindings.cuaderno.hints.tooltip}"
                                                               id="cuadernoOt"/>
                                            </af:panelLabelAndMessage>
                                        </af:panelFormLayout>
                                        <af:panelFormLayout id="tab2Form1"
                                                            rendered="#{bindings.esTituloMinero.inputValue == 'SI'}">
                                            <af:panelLabelAndMessage label="Documento Principal" id="docPrincipalPnl1">
                                                <af:link targetFrame="_blank" text="#{bindings.nroRadicado.inputValue}"
                                                         destination="#{bindings.urlDocumentoPrincipal}" id="lnkDoc1"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="Tr&#225;mite" id="nombreTramiteID">
                                                <af:outputText value="#{bindings.nombreTramite.inputValue}"
                                                               shortDesc="#{bindings.nombreTramite.hints.tooltip}"
                                                               id="nombreTramiteOt"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="Tipo Documental" id="nombreTpDocumentoId">
                                                <af:outputText value="#{bindings.nombreTpDocumento.inputValue}"
                                                               shortDesc="#{bindings.nombreTpDocumento.hints.tooltip}"
                                                               id="nombreTpDocumentoOt"/>
                                            </af:panelLabelAndMessage>
                                        </af:panelFormLayout>
                                    </af:panelBox>
                                    <af:panelBox id="destinatarioPnl" text="Destinatarios" styleClass="AFStretchWidth">
                                        <af:panelCollection id="pc1" styleClass="AFStretchWidth" featuresOff="viewMenu">
                                            <af:table value="#{bindings.interesadosExternos.collectionModel}" var="row"
                                                      rows="#{bindings.interesadosExternos.rangeSize}"
                                                      emptyText="#{bindings.interesadosExternos.viewable ? 'No data to display.' : 'Access Denied.'}"
                                                      rowBandingInterval="0" editingMode="readOnly"
                                                      fetchSize="#{bindings.interesadosExternos.rangeSize}" id="t5">
                                                <af:column headerText="Identificacion" id="c4">
                                                    <af:column headerText="Tipo" id="c9">
                                                        <af:outputText value="#{row.bindings.tipoIdentificacion.inputValue}"
                                                                       id="t5ot2"/>
                                                    </af:column>
                                                    <af:column headerText="N&#250;mero" id="c10">
                                                        <af:outputText value="#{row.bindings.nroIdentificacion.inputValue}"
                                                                       id="t5ot3"/>
                                                    </af:column>
                                                    <af:column headerText="Nombre" id="c111">
                                                        <af:outputText value="#{row.bindings.nombre1.inputValue}"
                                                                       id="t5ot41"/>
                                                    </af:column>
                                                    <af:column headerText="Segundo Nombre" id="c112">
                                                        <af:outputText value="#{row.bindings.nombre2.inputValue}"
                                                                       id="t5ot42"/>
                                                    </af:column>
                                                    <af:column headerText="Apellido" id="c113">
                                                        <af:outputText value="#{row.bindings.apellido1.inputValue}"
                                                                       id="t5ot43"/>
                                                    </af:column>
                                                    <af:column headerText="Segundo Apellido" id="c114">
                                                        <af:outputText value="#{row.bindings.apellido2.inputValue}"
                                                                       id="t5ot44"/>
                                                    </af:column>
                                                </af:column>
                                                <af:column headerText="Datos de Contacto" id="c12">
                                                    <af:column headerText="Celular" id="c_celular">
                                                        <af:outputText value="#{row.bindings.celular.inputValue}"
                                                                       id="ot4"/>
                                                    </af:column>
                                                    <af:column headerText="Telef&#243;no" id="c13">
                                                        <af:outputText value="#{row.bindings.telefono.inputValue}"
                                                                       id="t5ot5"/>
                                                    </af:column>
                                                    <af:column headerText="Correo Electr&#243;nico" id="c14">
                                                        <af:outputText value="#{row.bindings.email.inputValue}"
                                                                       id="t5ot6"/>
                                                    </af:column>
                                                    <af:column headerText="Direcci&#243;n" id="c15">
                                                        <af:outputText value="#{row.bindings.direccionCorrespondencia.inputValue}"
                                                                       id="t5ot7"/>
                                                    </af:column>
                                                </af:column>
                                            </af:table>
                                        </af:panelCollection>
                                    </af:panelBox>
                                    <af:panelBox text="#{resources.COMMENTS}"
                                                 disclosed="#{actionAvailable.discloseComments}"
                                                 contentStyle="padding: 5px;" partialTriggers="commentSubmit" id="sdh1">
                                        <af:panelGroupLayout layout="vertical" inlineStyle="padding:10px;" id="dc_pgl1">
                                            <af:inputText id="cmtBox" rows="2" columns="80" wrap="off"
                                                          partialTriggers="commentSubmit" value="#{commentBean.value}"
                                                          visible="#{actionAvailable.isCommentUpdatable}"
                                                          maximumLength="2000" label="" inlineStyle="text-align:left;"/>
                                            <af:spacer height="5" rendered="#{actionAvailable.isCommentUpdatable}"
                                                       id="s8"/>
                                            <af:toolbar rendered="#{actionAvailable.isCommentUpdatable}" id="t3">
                                                <af:commandButton id="commentSubmit" text="#{resources.POST_COMMENT}"
                                                                  partialSubmit="true"
                                                                  actionListener="#{bindings.CreateInsert1.execute}"
                                                                  action="#{commentBean.addComment}"/>
                                            </af:toolbar>
                                            <af:spacer height="10" id="dc_s7"
                                                       rendered="#{actionAvailable.isCommentUpdatable}"/>
                                            <af:outputText value="#{resources.NO_ROWS_YET}"
                                                           rendered="#{(actionAvailable.isCommentUpdatable) and (empty bindings.userComment)}"
                                                           id="ot2"/>
                                            <af:forEach items="#{bindings.userComment.children}" var="row">
                                                <af:panelGroupLayout id="pgl9" layout="horizontal" valign="top">
                                                    <af:image source="/images/simple_16x16.png" id="i19"/>
                                                    <af:spacer width="10" height="10" id="s27"/>
                                                    <af:panelGroupLayout id="pgl19" layout="vertical">
                                                        <af:panelGroupLayout id="pgl69" layout="horizontal">
                                                            <af:switcher facetName="#{row.updatedBy.displayName != null}"
                                                                         id="s17">
                                                                <f:facet name="true">
                                                                    <af:group id="g12">
                                                                        <af:outputText value="#{row.updatedBy.displayName}"
                                                                                       id="ot59"
                                                                                       inlineStyle="font-weight:bold;"/>
                                                                        <af:spacer width="10" height="10" id="s129"/>
                                                                        <af:outputText value="#{row.updatedDate}"
                                                                                       id="ot119"
                                                                                       inlineStyle="font-size:x-small; color:Gray;">
                                                                            <f:converter converterId="dateTimeConvertor"/>
                                                                        </af:outputText>
                                                                    </af:group>
                                                                </f:facet>
                                                                <f:facet name="false">
                                                                    <af:group id="g11">
                                                                        <af:outputText value="#{pageFlowScope.ADFHumanTaskBean.workflowContext.user}"
                                                                                       inlineStyle="font-weight:bold;"
                                                                                       id="ot15"/>
                                                                        <af:spacer width="10" height="10" id="s32"/>
                                                                        <af:outputText value="#{resources.TODAY}"
                                                                                       id="ot12"/>
                                                                    </af:group>
                                                                </f:facet>
                                                            </af:switcher>
                                                        </af:panelGroupLayout>
                                                        <af:outputText value="#{row.comment}" id="ot419"/>
                                                        <af:spacer width="10" height="5" id="s59"/>
                                                    </af:panelGroupLayout>
                                                </af:panelGroupLayout>
                                            </af:forEach>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:spacer height="20px" id="spRoot6"/>
                                    <af:popup id="popupAddCommentDialog" contentDelivery="lazyUncached"
                                              popupCanceledListener="#{invokeActionBean.commentsPopupCanceled}"
                                              attributeChangeListener="#{bindings.CreateInsert1.execute}"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.CREATE_COMMENT}" type="none" modal="true"
                                                   id="cmtDlg">
                                            <f:facet name="buttonBar">
                                                <af:panelGroupLayout id="pgl10">
                                                    <af:button textAndAccessKey="#{resources.OK_AK}" id="cmtOK"
                                                               action="#{popupBean.hideCommentDialog}"
                                                               partialSubmit="true"/>
                                                    <af:button textAndAccessKey="#{resources.CANCEL_AK}"
                                                               actionListener="#{bindings.Delete1.execute}"
                                                               immediate="true" partialSubmit="true" id="cmtCan"
                                                               action="#{popupBean.hideCommentDialog}"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <af:panelGroupLayout id="pgl8">
                                                <af:panelFormLayout id="pfl3">
                                                    <f:facet name="footer"/>
                                                    <af:inputText id="it1" rows="3" columns="80"
                                                                  value="#{bindings.comment.inputValue}"
                                                                  label="#{resources.COMMENT}" required="true"
                                                                  maximumLength="1999"/>
                                                    <af:selectOneRadio value="#{bindings.commentScope.inputValue}"
                                                                       label="#{resources.UPLOAD_TO_PROCESS}"
                                                                       id="uploadToProcComment"
                                                                       visible="#{pageFlowScope.ADFHumanTaskBean.taskBelongsToProcess and !pageFlowScope.ADFHumanTaskBean.isCaseTask}"
                                                                       layout="vertical">
                                                        <af:selectItem label="#{resources.TASK}" value="TASK" id="si1"/>
                                                        <af:selectItem label="#{resources.BPM}" value="BPM" id="si4"/>
                                                    </af:selectOneRadio>
                                                </af:panelFormLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="popupAddAttachmentDialog" contentDelivery="lazyUncached"
                                              popupCanceledListener="#{invokeActionBean.attachmentsPopupCanceled}"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.ADD_ATTACHMENT}" type="none" id="d2">
                                            <f:facet name="buttonBar">
                                                <af:panelGroupLayout id="pgl17">
                                                    <af:button id="addAtOK" action="#{addAttachmentBean.attachmentOK}"
                                                               textAndAccessKey="#{resources.OK_AK}"
                                                               partialSubmit="true"/>
                                                    <af:button id="attCan" textAndAccessKey="#{resources.CANCEL_AK}"
                                                               actionListener="#{bindings.Delete2.execute}"
                                                               action="#{addAttachmentBean.clear}" immediate="true"
                                                               partialSubmit="true"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <af:panelGroupLayout layout="vertical" id="pgl16">
                                                <af:panelFormLayout id="pfl12">
                                                    <af:selectOneRadio value="#{bindings.attachmentScope.inputValue}"
                                                                       label="#{resources.UPLOAD_TO_PROCESS}"
                                                                       id="uploadToProcAttach"
                                                                       visible="#{pageFlowScope.ADFHumanTaskBean.taskBelongsToProcess and !pageFlowScope.ADFHumanTaskBean.isCaseTask}"
                                                                       layout="vertical">
                                                        <af:selectItem label="#{resources.TASK}" value="TASK" id="si2"/>
                                                        <af:selectItem label="#{resources.BPM}" value="BPM" id="si7"/>
                                                    </af:selectOneRadio>
                                                </af:panelFormLayout>
                                                <af:inputText id="edAttTy" label="edAttTy" visible="false"/>
                                                <af:panelGroupLayout layout="vertical" partialTriggers="edAttTy"
                                                                     id="pgl4">
                                                    <af:inputText id="attName" label="#{resources.NAME}"
                                                                  value="#{bindings.name.inputValue}"
                                                                  required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'url'}"
                                                                  partialTriggers="edAttTy" maximumLength="128"/>
                                                    <af:switcher facetName="#{pageFlowScope.readAttachmentBean.selectedAttachmentType}"
                                                                 id="s2">
                                                        <f:facet name="url">
                                                            <af:panelFormLayout id="pfl2">
                                                                <af:inputText id="attHref" label="#{resources.URL}"
                                                                              value="#{bindings.URI.inputValue}"
                                                                              required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'url'}"
                                                                              partialTriggers="edAttTy"
                                                                              maximumLength="256"/>
                                                            </af:panelFormLayout>
                                                        </f:facet>
                                                        <f:facet name="file">
                                                            <af:panelGroupLayout layout="vertical" id="pgl2">
                                                                <af:panelFormLayout id="pfl11">
                                                                    <af:inputFile label="#{resources.FILE_NAME}"
                                                                                  value="#{addAttachmentBean.file}"
                                                                                  id="attFile" required="true"
                                                                                  partialTriggers="edAttTy"/>
                                                                    <af:inputText label="#{resources.ALLOWED_FILE_EXT}"
                                                                                  value="#{addAttachmentBean.allowedExtensions}"
                                                                                  visible="#{!empty addAttachmentBean.allowedExtensions and pageFlowScope.readAttachmentBean.selectedAttachmentType == 'file'}"
                                                                                  partialTriggers="edAttTy" id="it26"/>
                                                                    <af:inputText label="#{resources.DESCRIPTION}"
                                                                                  value="#{pageFlowScope.ADFHumanTaskBean.docComments}"
                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.docCommentsShow}"
                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.docCommentsEdit}"
                                                                                  rows="4" id="it10"/>
                                                                </af:panelFormLayout>
                                                                <af:spacer height="10" width="10" id="s12"/>
                                                                <af:switcher facetName="#{pageFlowScope.ADFHumanTaskBean.isUsingUCM}"
                                                                             id="s1">
                                                                    <f:facet name="true">
                                                                        <af:panelFormLayout id="pfl1">
                                                                            <af:inputText id="attDir"
                                                                                          label="#{resources.FOLDER_NAME}"
                                                                                          value="#{pageFlowScope.ADFHumanTaskBean.folder}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.folderShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.folderEdit}"
                                                                                          maximumLength="256">
                                                                                <af:autoSuggestBehavior suggestedItems="#{pageFlowScope.ADFHumanTaskBean.onFolderSuggest}"/>
                                                                            </af:inputText>
                                                                            <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.docType}"
                                                                                                label="#{resources.DOCUMENT_TYPE}"
                                                                                                visible="#{pageFlowScope.ADFHumanTaskBean.docTypeShow}"
                                                                                                partialTriggers="edAttTy"
                                                                                                readOnly="#{!pageFlowScope.ADFHumanTaskBean.docTypeEdit}"
                                                                                                required="true"
                                                                                                id="soc1">
                                                                                <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.documentTypeList}"
                                                                                               id="si5"/>
                                                                            </af:selectOneChoice>
                                                                            <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.account}"
                                                                                                label="#{resources.ACCOUNT}"
                                                                                                visible="#{pageFlowScope.ADFHumanTaskBean.accountShow}"
                                                                                                partialTriggers="edAttTy"
                                                                                                readOnly="#{!pageFlowScope.ADFHumanTaskBean.accountEdit}"
                                                                                                rendered="#{!empty pageFlowScope.ADFHumanTaskBean.accountList}"
                                                                                                id="soc3">
                                                                                <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.accountList}"
                                                                                               id="si6"/>
                                                                            </af:selectOneChoice>
                                                                            <af:inputText value="#{pageFlowScope.ADFHumanTaskBean.revision}"
                                                                                          label="#{resources.REVISION}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.revisionShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.revisionEdit}"
                                                                                          id="it2"/>
                                                                            <af:switcher facetName="#{!empty pageFlowScope.dateTimePattern}"
                                                                                         id="s10">
                                                                                <f:facet name="true">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.releaseDate}"
                                                                                                  label="#{resources.RELEASE_DATE}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.releaseDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  id="id6">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           pattern="#{pageFlowScope.dateTimePattern}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                                <f:facet name="false">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.releaseDate}"
                                                                                                  label="#{resources.RELEASE_DATE}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.releaseDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  id="id2">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                            </af:switcher>
                                                                            <af:switcher facetName="#{!empty pageFlowScope.dateTimePattern}"
                                                                                         id="s5">
                                                                                <f:facet name="true">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.expirationDate}"
                                                                                                  label="#{resources.EXPIRATION_DATE}"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.expirationDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  id="id3">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           pattern="#{pageFlowScope.dateTimePattern}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                                <f:facet name="false">
                                                                                    <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.expirationDate}"
                                                                                                  label="#{resources.EXPIRATION_DATE}"
                                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.expirationDateShow}"
                                                                                                  partialTriggers="edAttTy"
                                                                                                  id="id5">
                                                                                        <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                           timeZone="#{pageFlowScope.tz}"
                                                                                                           dateStyle="#{pageFlowScope.df}"
                                                                                                           timeStyle="#{pageFlowScope.tf}"/>
                                                                                    </af:inputDate>
                                                                                </f:facet>
                                                                            </af:switcher>
                                                                            <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.securityGroup}"
                                                                                                label="#{resources.SECURITY_GROUP}"
                                                                                                visible="#{pageFlowScope.ADFHumanTaskBean.secGroupShow}"
                                                                                                required="true"
                                                                                                readOnly="#{!pageFlowScope.ADFHumanTaskBean.secGroupEdit}"
                                                                                                partialTriggers="edAttTy"
                                                                                                id="soc2">
                                                                                <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.securityGroupList}"
                                                                                               id="si3"/>
                                                                            </af:selectOneChoice>
                                                                        </af:panelFormLayout>
                                                                    </f:facet>
                                                                </af:switcher>
                                                            </af:panelGroupLayout>
                                                        </f:facet>
                                                        <f:facet name="ucm">
                                                            <af:panelGroupLayout layout="vertical" id="pgl15">
                                                                <af:inputListOfValues label="#{resources.DOCUMENT_ID}"
                                                                                      id="idInputComboboxLOVWithTable"
                                                                                      value="#{pageFlowScope.readAttachmentBean.ucmDocId}"
                                                                                      autoSubmit="true"
                                                                                      popupTitle="#{resources.SRCH_SLCT_DOC_ID}"
                                                                                      searchDesc="#{resources.SRCH_SLCT_DOC_ID}"
                                                                                      partialTriggers="edAttTy"
                                                                                      model="#{pageFlowScope.ADFHumanTaskBean.listOfValuesModel}"
                                                                                      columns="60"
                                                                                      required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}"
                                                                                      rendered="#{pageFlowScope.ADFHumanTaskBean.isUsingUCM}"
                                                                                      visible="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}"/>
                                                            </af:panelGroupLayout>
                                                        </f:facet>
                                                    </af:switcher>
                                                </af:panelGroupLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="popupDeleteAttachmentDialog" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.DELETE_ATTACHMENT}" type="none" modal="true"
                                                   closeIconVisible="false" id="attDelDlg">
                                            <f:facet name="buttonBar">
                                                <af:panelGroupLayout id="pgl12">
                                                    <af:button textAndAccessKey="#{resources.OK_AK}"
                                                               actionListener="#{bindings.Delete2.execute}"
                                                               immediate="true" partialSubmit="true" id="delAtOK"
                                                               action="#{popupBean.hideAttachmentDeleteDialog}"/>
                                                    <af:button textAndAccessKey="#{resources.CANCEL_AK}" id="delAtCan"
                                                               action="#{popupBean.hideAttachmentDeleteDialog}"
                                                               partialSubmit="true"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <af:panelGroupLayout id="pgl6">
                                                <af:panelFormLayout id="pfl8">
                                                    <af:outputText id="delAttTxt"
                                                                   value="#{resources.DELETE_ATTACHMENT_MSG}"/>
                                                </af:panelFormLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="reassignPopup" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog id="reAsDg" dialogListener="#{invokeActionBean.reassignAction}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   title="#{resources.REASSIGNPAGE}">
                                            <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                                 workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                                 id="reAsIdB" mode="REASSIGN" showActionButtons="false"
                                                                 selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="requestInfoPopup" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.INFOREQUESTEDPAGE}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   dialogListener="#{invokeActionBean.requestInfoAction}" id="reqIfD">
                                            <wlc:requestInfoDialog workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                                   id="rqIDgC"
                                                                   selectedTaskId="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds[0]}"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="routePopup" contentDelivery="lazyUncached" childCreation="deferred">
                                        <af:dialog title="#{resources.ROUTEPAGE}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   dialogListener="#{invokeActionBean.routeTaskAction}" id="rteDg">
                                            <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                                 workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                                 id="rteIdB" mode="ROUTE"
                                                                 selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}"
                                                                 showActionButtons="false"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="decomposePopup" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{pageFlowScope.ADFHumanTaskBean.decomposeDialogTitle}"
                                                   cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   dialogListener="#{invokeActionBean.decomposeTaskAction}" id="dcmpDg">
                                            <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                                 workflowContext="#{pageFlowScope.ADFHumanTaskBean.workflowContext}"
                                                                 id="dcmpIdB" mode="DECOMPOSE"
                                                                 selectedTaskObject="#{pageFlowScope.ADFHumanTaskBean.task}"
                                                                 showActionButtons="false"/>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="popupEnterPasswordDialog" contentDelivery="lazyUncached"
                                              childCreation="deferred">
                                        <af:dialog title="#{resources.ENTER_PASSWORD}"
                                                   dialogListener="#{invokeActionBean.validatePassword}" type="okCancel"
                                                   modal="true" cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                                   affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                                   closeIconVisible="false" id="pwdDlg">
                                            <af:panelGroupLayout id="pgl14">
                                                <af:panelFormLayout id="pfl5">
                                                    <af:inputText id="pwdBox" rows="1" columns="50"
                                                                  value="#{invokeActionBean.password}"
                                                                  label="#{resources.PASSWORD}" secret="true"
                                                                  required="true"/>
                                                </af:panelFormLayout>
                                            </af:panelGroupLayout>
                                        </af:dialog>
                                    </af:popup>
                                    <af:popup id="helpPopup" childCreation="deferred">
                                        <af:switcher facetName="#{pageFlowScope.taskDocumentationBean.isTaskDoc}"
                                                     id="s7">
                                            <f:facet name="true">
                                                <af:panelGroupLayout layout="vertical" id="pgl1">
                                                    <af:link text="#{resources.OPEN_IN_WINDOW}"
                                                             destination="#{pageFlowScope.taskDocumentationBean.docURL}"
                                                             targetFrame="help" id="help"
                                                             rendered="#{!empty bindings.activityId.inputValue}"/>
                                                    <af:outputFormatted value="#{pageFlowScope.taskDocumentationBean.taskDoc}"
                                                                        id="of1"/>
                                                </af:panelGroupLayout>
                                            </f:facet>
                                            <f:facet name="false">
                                                <af:outputText value="#{resources.TASK_DOC_NOT_AVAILABLE}" id="ot17"/>
                                            </f:facet>
                                        </af:switcher>
                                    </af:popup>
                                </af:panelGroupLayout>
                            </af:showDetailHeader>
                        </af:panelGroupLayout>
                    </af:panelHeader>
                    <f:facet name="separator"/>
                </af:panelGroupLayout>
            </af:form>
        </af:document>
    </f:view>
</jsp:root>