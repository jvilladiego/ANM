<?xml version='1.0' encoding='UTF-8'?>
<adapter-config name="EscribirAdjuntos" adapter="file" wsdlLocation="../WSDLs/EscribirAdjuntos.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
   <connection-factory location="eis/FileAdapter"/>
   <endpoint-interaction portType="Write_ptt" operation="Write">
      <interaction-spec className="oracle.tip.adapter.file.outbound.FileInteractionSpec">
         <property name="PhysicalDirectory" value="/Users/jgutierrez/alejandria/acti.repository/acti-anm-pqrs/impl/comunicaciones"/>
         <property name="NumberMessages" value="1"/>
         <property name="Append" value="false"/>
         <property name="FileNamingConvention" value="po_%SEQ%_file"/>
      </interaction-spec>
   </endpoint-interaction>
</adapter-config>
