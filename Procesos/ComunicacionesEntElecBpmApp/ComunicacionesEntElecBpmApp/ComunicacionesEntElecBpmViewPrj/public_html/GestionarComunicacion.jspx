                                                              label="#{bindings.idTipoPQRS.hints.label}"
                                                              required="#{bindings.idTipoPQRS.hints.mandatory}"
                                                              columns="#{bindings.idTipoPQRS.hints.displayWidth}"
                                                              maximumLength="#{bindings.idTipoPQRS.hints.precision}"
                                                              shortDesc="#{bindings.idTipoPQRS.hints.tooltip}" id="it7">
                                                    <f:validator binding="#{bindings.idTipoPQRS.validator}"/>
                                                    <af:convertNumber groupingUsed="false"
                                                                      pattern="#{bindings.idTipoPQRS.format}"/>
                                                </af:inputText>-->
                                                <!--<af:inputText value="#{bindings.tipoPQRSDO.inputValue}"
                                                              label="#{bindings.tipoPQRSDO.hints.label}"
                                                              required="#{bindings.tipoPQRSDO.hints.mandatory}"
                                                              columns="#{bindings.tipoPQRSDO.hints.displayWidth}"
                                                              maximumLength="#{bindings.tipoPQRSDO.hints.precision}"
                                                              shortDesc="#{bindings.tipoPQRSDO.hints.tooltip}" id="it4">
                                                    <f:validator binding="#{bindings.tipoPQRSDO.validator}"/>
                                                </af:inputText>-->
                                                <af:selectOneChoice label="&#191;Requiere respuesta?" id="socReqResp"
                                                                    value="#{bindings.requiereRespuestaDO.inputValue}"
                                                                    autoSubmit="true" partialTriggers="sbcPQRS"
                                                                    valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarRequiereRespuesta}"
                                                                    readOnly="#{bindings.isPQRS.inputValue}">
                                                    <af:selectItem label="SI" value="S" id="si24"/>
                                                    <af:selectItem label="NO" value="N" id="si25"/>
                                                </af:selectOneChoice>
                                                <af:inputNumberSpinbox label="Tiempo respuesta (dias)"
                                                                       id="ins_tiemporesp" minimum="1" maximum="30"
                                                                       value="#{bindings.tiempoRespuesta.inputValue eq 0?'No asignado':bindings.tiempoRespuesta.inputValue}"
                                                                       valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarTiempoRespuesta}"
                                                                       partialTriggers="socTipoPQRS socReqResp sbcPQRS"
                                                                       shortDesc="dias h&#225;biles" autoSubmit="true"
                                                                       readOnly="#{bindings.isPQRS.inputValue or bindings.requiereRespuestaDO.inputValue eq 'N'}"/>
                                            </af:panelFormLayout>
                                            <af:spacer id="s20" width="10"/>
                                            <af:panelFormLayout id="pfl10">
                                                <af:selectOneChoice label="&#191;Acceso negado a la informaci&#243;n?"
                                                                    id="soc11"
                                                                    value="#{bindings.accesoNegadoInformacionDO.inputValue}"
                                                                    showRequired="true" required="true">
                                                    <af:selectItem label="SI" value="S" id="si16"/>
                                                    <af:selectItem label="NO" value="N" id="si19"/>
                                                </af:selectOneChoice>
                                                <af:selectOneChoice label="&#191;Identificaci&#243;n Reservada?"
                                                                    id="soc12"
                                                                    value="#{bindings.identificacionReservadaDO.inputValue}"
                                                                    showRequired="true" required="true">
                                                    <af:selectItem label="SI" value="S" id="si20"/>
                                                    <af:selectItem label="NO" value="N" id="si21"/>
                                                </af:selectOneChoice>
                                                <af:selectOneChoice label="&#191;Traslado a otra instituci&#243;n?"
                                                                    id="soc13"
                                                                    value="#{bindings.trasladoOtraInstitucionDO.inputValue}"
                                                                    showRequired="true" required="true">
                                                    <af:selectItem label="SI" value="S" id="si22"/>
                                                    <af:selectItem label="NO" value="N" id="si23"/>
                                                </af:selectOneChoice>
                                            </af:panelFormLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelGroupLayout id="pglTipoCierre" layout="vertical"
                                                         partialTriggers="socReqResp">
                                        <af:panelBox id="pbTipoCierre" text="Tipo de cierre"
                                                     rendered="#{bindings.requiereRespuestaDO.inputValue eq 'S'}">
                                            <af:panelFormLayout id="pflTipoCierre">
                                                <af:selectOneRadio id="socTipoCierre" label="Tipo de cierre"
                                                                   value="#{bindings.tipoCierreDO.inputValue}"
                                                                   required="true" autoSubmit="true" layout="vertical">
                                                    <f:selectItem itemLabel="Generar Respuesta (Utilizando plantilla .odt)"
                                                                  itemValue="RESPUESTA" id="si14"/>
                                                    <f:selectItem itemLabel="Generar Cierre Autom&#225;tico"
                                                                  itemValue="CIERRE_AUTOMATICO" id="si26"/>
                                                </af:selectOneRadio>
                                                <af:panelGroupLayout id="pglJustificacionCierre" layout="vertical"
                                                                     partialTriggers="socTipoCierre">
                                                    <af:inputText id="itJustificacionCierre"
                                                                  label="Justificaci&#243;n de Cierre Autom&#225;tico"
                                                                  value="#{bindings.justificacionCierreDO.inputValue}"
                                                                  rendered="#{bindings.tipoCierreDO.inputValue eq 'CIERRE_AUTOMATICO'}"
                                                                  required="true" rows="5" columns="70"
                                                                  maximumLength="1000">
                                                        <f:validateLength minimum="100" maximum="1000"/>
                                                    </af:inputText>
                                                </af:panelGroupLayout>
                                            </af:panelFormLayout>
                                        </af:panelBox>
                                    </af:panelGroupLayout>
                                    <af:panelGroupLayout id="pglAdjuntosREQ04" layout="vertical"
                                                         partialTriggers="socTipoCierre socReqResp">
                                        <af:panelBox text="Adjuntos" id="pb2"
                                                     rendered="#{not (bindings.requiereRespuestaDO.inputValue eq 'S' and bindings.tipoCierreDO.inputValue eq 'CIERRE_AUTOMATICO')}">
                                            <wlc:manageDocuments docBean="#{pageFlowScope.docMgmtBean}" id="manageDocs"
                                                                 rendered="#{!actionAvailable.inNotificationClient}"/>
                                        </af:panelBox>
                                    </af:panelGroupLayout>
                                    <af:panelBox text="Gesti&#243;n Documental" id="pb3">
                                        <af:panelFormLayout id="pnlFormGest1" clientComponent="true"
                                                            partialTriggers="sbc_expminero"
                                                            rendered="#{bindings.esTituloMinero.inputValue}">
                                            <af:selectOneChoice id="selectTramite" label="Tr&#225;mite"
                                                                autoSubmit="true"
                                                                readOnly="#{bindings.categorizado.inputValue}"
                                                                valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarTramite}"
                                                                value="#{bindings.idTramite.inputValue}"
                                                                showRequired="true">
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.tramites}"
                                                               id="selTramites2"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectTpDocumento" label="Tipo Documental"
                                                                partialTriggers="selectTramite"
                                                                readOnly="#{bindings.categorizado.inputValue}"
                                                                value="#{bindings.idTpDocumento.inputValue}"
                                                                showRequired="true" autoSubmit="true"
                                                                valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarTipoDocumento}">
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.tiposDocumentales}"
                                                               id="selTpDoc2"/>
                                            </af:selectOneChoice>
                                        </af:panelFormLayout>
                                        <af:panelFormLayout id="pnlFormGest2" partialTriggers="sbc_expminero"
                                                            rendered="#{!bindings.esTituloMinero.inputValue}">
                                            <af:selectOneChoice id="selectCatProceso"
                                                                readOnly="#{bindings.categorizado.inputValue}"
                                                                autoSubmit="true" label="Categoria Proceso"
                                                                valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarCategoriaProceso}"
                                                                value="#{bindings.idCatProceso.inputValue}"
                                                                showRequired="true">
                                                <f:selectItem itemLabel="Seleccione" id="selCPItm1"/>
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.categoriasProceso}"
                                                               id="selCPItm2"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectProceso"
                                                                readOnly="#{bindings.categorizado.inputValue}"
                                                                shortDesc="#{bindings.idProceso.hints.tooltip}"
                                                                autoSubmit="true" label="Proceso"
                                                                valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarProceso}"
                                                                value="#{bindings.idProceso.inputValue}"
                                                                partialTriggers="selectCatProceso" showRequired="true">
                                                <f:selectItem itemLabel="Seleccione" id="selPRItm1"/>
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.procesos}"
                                                               id="selPRItm2"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectSerie" autoSubmit="true"
                                                                readOnly="#{bindings.categorizado.inputValue}"
                                                                label="Serie"
                                                                partialTriggers="selectCatProceso selectProceso"
                                                                valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarSerie}"
                                                                value="#{bindings.idSerie.inputValue}"
                                                                showRequired="true">
                                                <f:selectItem itemLabel="Seleccione" id="selSRItm1"/>
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.series}"
                                                               id="selSRItm2"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectSubSerie"
                                                                readOnly="#{bindings.categorizado.inputValue}"
                                                                visible="#{CrearComunicacionEntElecHT_jsfbean.renderedSubseries}"
                                                                shortDesc="#{bindings.idSubSerie.hints.tooltip}"
                                                                autoSubmit="true" label="Subserie"
                                                                partialTriggers="selectCatProceso selectProceso selectSerie"
                                                                valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarSubSerie}"
                                                                value="#{bindings.idSubSerie.inputValue}"
                                                                showRequired="true">
                                                <f:selectItem itemLabel="Seleccione" id="selSSRItm1"/>
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.subseries}"
                                                               id="selSSRItm2"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice id="selectCuaderno"
                                                                readOnly="#{bindings.categorizado.inputValue}"
                                                                visible="#{CrearComunicacionEntElecHT_jsfbean.renderedCuadernos}"
                                                                shortDesc="#{bindings.idCuaderno.hints.tooltip}"
                                                                label="Expediente" autoSubmit="true"
                                                                partialTriggers="selectCatProceso selectProceso selectSerie selectSubSerie"
                                                                valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarCuaderno}"
                                                                value="#{bindings.idCuaderno.inputValue}"
                                                                showRequired="true">
                                                <f:selectItem itemLabel="Seleccione" id="selCuaItm1"/>
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.cuadernos}"
                                                               id="selCuaItm2"/>
                                            </af:selectOneChoice>
                                        </af:panelFormLayout>
                                    </af:panelBox>
                                    <af:panelBox text="Comentarios" partialTriggers="commentSubmit" id="sdh1">
                                        <af:panelGroupLayout layout="vertical" inlineStyle="padding:10px;" id="dc_pgl1">
                                            <af:inputText id="cmtBox" rows="2" columns="80" wrap="off"
                                                          partialTriggers="commentSubmit" value="#{commentBean.value}"
                                                          visible="#{actionAvailable.isCommentUpdatable}"
                                                          maximumLength="2000" label="" inlineStyle="text-align:left;"/>
                                            <af:spacer height="5" rendered="#{actionAvailable.isCommentUpdatable}"
                                                       id="s10"/>
                                            <af:toolbar rendered="#{actionAvailable.isCommentUpdatable}" id="t3">
                                                <af:commandButton id="commentSubmit" text="#{resources.POST_COMMENT}"
                                                                  partialSubmit="true"
                                                                  actionListener="#{bindings.CreateInsert1.execute}"
                                                                  action="#{commentBean.addComment}"/>
                                            </af:toolbar>
                                            <af:spacer height="10" id="dc_s7"
                                                       rendered="#{actionAvailable.isCommentUpdatable}"/>
                                            <af:outputText value="#{resources.NO_ROWS_YET}"
                                                           rendered="#{(actionAvailable.isCommentUpdatable) and (empty bindings.userComment)}"
                                                           id="ot14"/>
                                            <af:forEach items="#{bindings.userComment.children}" var="row">
                                                <af:panelGroupLayout id="pgl9" layout="horizontal" valign="top">
                                                    <af:image source="/images/simple_16x16.png" id="i19"/>
                                                    <af:spacer width="10" height="10" id="s27"/>
                                                    <af:panelGroupLayout id="pgl19" layout="vertical">
                                                        <af:panelGroupLayout id="pgl69" layout="horizontal">
                                                            <af:switcher facetName="#{row.updatedBy.displayName != null}"
                                                                         id="s17">
                                                                <f:facet name="true">
                                                                    <af:group id="g12">
                                                                        <af:outputText value="#{row.updatedBy.displayName}"
                                                                                       id="ot59"
                                                                                       inlineStyle="font-weight:bold;"/>
                                                                        <af:spacer width="10" height="10" id="s129"/>
                                                                        <af:outputText value="#{row.updatedDate}"
                                                                                       id="ot119"
                                                                                       inlineStyle="font-size:x-small; color:Gray;">
                                                                            <f:converter converterId="dateTimeConvertor"/>
                                                                        </af:outputText>
                                                                    </af:group>
                                                                </f:facet>
                                                                <f:facet name="false">
                                                                    <af:group id="g11">
                                                                        <af:outputText value="#{pageFlowScope.ADFHumanTaskBean.workflowContext.user}"
                                                                                       inlineStyle="font-weight:bold;"
                                                                                       id="ot115"/>
                                                                        <af:spacer width="10" height="10" id="s32"/>
                                                                        <af:outputText value="#{resources.TODAY}"
                                                                                       id="ot16"/>
                                                                    </af:group>
                                                                </f:facet>
                                                            </af:switcher>
                                                        </af:panelGroupLayout>
                                                        <af:spacer width="10" height="5" id="s59"/>
                                                        <af:outputText value="#{row.comment}" id="ot419"/>
                                                    </af:panelGroupLayout>
                                                </af:panelGroupLayout>
                                            </af:forEach>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                </af:panelGroupLayout>
                            </af:showDetailHeader>
                            <af:popup id="popupAddCommentDialog" contentDelivery="lazyUncached"
                                      popupCanceledListener="#{invokeActionBean.commentsPopupCanceled}"
                                      attributeChangeListener="#{bindings.CreateInsert1.execute}"
                                      childCreation="deferred">
                                <af:dialog title="#{resources.CREATE_COMMENT}" type="none" modal="true" id="cmtDlg">
                                    <f:facet name="buttonBar">
                                        <af:panelGroupLayout id="pgl18">
                                            <af:button textAndAccessKey="#{resources.OK_AK}" id="cmtOK"
                                                       action="#{popupBean.hideCommentDialog}" partialSubmit="true"/>
                                            <af:button textAndAccessKey="#{resources.CANCEL_AK}"
                                                       actionListener="#{bindings.Delete1.execute}" immediate="true"
                                                       partialSubmit="true" id="cmtCan"
                                                       action="#{popupBean.hideCommentDialog}"/>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                    <af:panelGroupLayout id="pgl29">
                                        <af:panelFormLayout id="pfl14">
                                            <f:facet name="footer"/>
                                            <af:inputText id="it58" rows="3" columns="80"
                                                          value="#{bindings.comment.inputValue}"
                                                          label="#{resources.COMMENT}" required="true"
                                                          maximumLength="1999"/>
                                            <af:selectOneRadio value="#{bindings.commentScope.inputValue}"
                                                               label="#{resources.UPLOAD_TO_PROCESS}"
                                                               id="uploadToProcComment"
                                                               visible="#{pageFlowScope.ADFHumanTaskBean.taskBelongsToProcess and !pageFlowScope.ADFHumanTaskBean.isCaseTask}"
                                                               layout="vertical">
                                                <af:selectItem label="#{resources.TASK}" value="TASK" id="si1"/>
                                                <af:selectItem label="#{resources.BPM}" value="BPM" id="si2"/>
                                            </af:selectOneRadio>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="popupAddAttachmentDialog" contentDelivery="lazyUncached"
                                      popupCanceledListener="#{invokeActionBean.attachmentsPopupCanceled}"
                                      childCreation="deferred">
                                <af:dialog title="#{resources.ADD_ATTACHMENT}" type="none" id="d2">
                                    <f:facet name="buttonBar">
                                        <af:panelGroupLayout id="pgl20">
                                            <af:button id="addAtOK" action="#{addAttachmentBean.attachmentOK}"
                                                       textAndAccessKey="#{resources.OK_AK}" partialSubmit="true"/>
                                            <af:button id="attCan" textAndAccessKey="#{resources.CANCEL_AK}"
                                                       actionListener="#{bindings.Delete2.execute}"
                                                       action="#{addAttachmentBean.clear}" immediate="true"
                                                       partialSubmit="true"/>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                    <af:panelGroupLayout layout="vertical" id="pgl21">
                                        <af:panelFormLayout id="pfl8">
                                            <af:selectOneRadio value="#{bindings.attachmentScope.inputValue}"
                                                               label="#{resources.UPLOAD_TO_PROCESS}"
                                                               id="uploadToProcAttach"
                                                               visible="#{pageFlowScope.ADFHumanTaskBean.taskBelongsToProcess and !pageFlowScope.ADFHumanTaskBean.isCaseTask}"
                                                               layout="vertical">
                                                <af:selectItem label="#{resources.TASK}" value="TASK" id="si3"/>
                                                <af:selectItem label="#{resources.BPM}" value="BPM" id="si4"/>
                                            </af:selectOneRadio>
                                        </af:panelFormLayout>
                                        <af:inputText id="edAttTy" visible="false">
                                            <?audit suppress oracle.adf.faces.compnotlabelled?>
                                        </af:inputText>
                                        <af:panelGroupLayout layout="vertical" partialTriggers="edAttTy" id="pgl22">
                                            <af:inputText id="attName" label="#{resources.NAME}"
                                                          value="#{bindings.name.inputValue}"
                                                          required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'url'}"
                                                          partialTriggers="edAttTy" maximumLength="128"/>
                                            <af:switcher facetName="#{pageFlowScope.readAttachmentBean.selectedAttachmentType}"
                                                         id="s9">
                                                <f:facet name="url">
                                                    <af:panelFormLayout id="pfl9">
                                                        <af:inputText id="attHref" label="#{resources.URL}"
                                                                      value="#{bindings.URI.inputValue}"
                                                                      required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'url'}"
                                                                      partialTriggers="edAttTy" maximumLength="256"/>
                                                    </af:panelFormLayout>
                                                </f:facet>
                                                <f:facet name="file">
                                                    <af:panelGroupLayout layout="vertical" id="pgl5">
                                                        <af:panelFormLayout id="pfl17">
                                                            <af:inputFile label="#{resources.FILE_NAME}"
                                                                          value="#{addAttachmentBean.file}" id="attFile"
                                                                          required="true" partialTriggers="edAttTy"/>
                                                            <af:inputText label="#{resources.ALLOWED_FILE_EXT}"
                                                                          value="#{addAttachmentBean.allowedExtensions}"
                                                                          visible="#{!empty addAttachmentBean.allowedExtensions and pageFlowScope.readAttachmentBean.selectedAttachmentType == 'file'}"
                                                                          partialTriggers="edAttTy" id="it55"/>
                                                            <af:inputText label="#{resources.DESCRIPTION}"
                                                                          value="#{pageFlowScope.ADFHumanTaskBean.docComments}"
                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.docCommentsShow}"
                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.docCommentsEdit}"
                                                                          rows="4" id="it56"/>
                                                        </af:panelFormLayout>
                                                        <af:spacer height="10" width="10" id="s12"/>
                                                        <af:switcher facetName="#{pageFlowScope.ADFHumanTaskBean.isUsingUCM}"
                                                                     id="s13">
                                                            <f:facet name="true">
                                                                <af:panelFormLayout id="pfl18">
                                                                    <af:inputText id="attDir"
                                                                                  label="#{resources.FOLDER_NAME}"
                                                                                  value="#{pageFlowScope.ADFHumanTaskBean.folder}"
                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.folderShow}"
                                                                                  partialTriggers="edAttTy"
                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.folderEdit}"
                                                                                  maximumLength="256">
                                                                        <af:autoSuggestBehavior suggestedItems="#{pageFlowScope.ADFHumanTaskBean.onFolderSuggest}"/>
                                                                    </af:inputText>
                                                                    <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.docType}"
                                                                                        label="#{resources.DOCUMENT_TYPE}"
                                                                                        visible="#{pageFlowScope.ADFHumanTaskBean.docTypeShow}"
                                                                                        partialTriggers="edAttTy"
                                                                                        readOnly="#{!pageFlowScope.ADFHumanTaskBean.docTypeEdit}"
                                                                                        required="true" id="soc1">
                                                                        <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.documentTypeList}"
                                                                                       id="si5"/>
                                                                    </af:selectOneChoice>
                                                                    <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.account}"
                                                                                        label="#{resources.ACCOUNT}"
                                                                                        visible="#{pageFlowScope.ADFHumanTaskBean.accountShow}"
                                                                                        partialTriggers="edAttTy"
                                                                                        readOnly="#{!pageFlowScope.ADFHumanTaskBean.accountEdit}"
                                                                                        rendered="#{!empty pageFlowScope.ADFHumanTaskBean.accountList}"
                                                                                        id="soc2">
                                                                        <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.accountList}"
                                                                                       id="si15"/>
                                                                    </af:selectOneChoice>
                                                                    <af:inputText value="#{pageFlowScope.ADFHumanTaskBean.revision}"
                                                                                  label="#{resources.REVISION}"
                                                                                  visible="#{pageFlowScope.ADFHumanTaskBean.revisionShow}"
                                                                                  partialTriggers="edAttTy"
                                                                                  readOnly="#{!pageFlowScope.ADFHumanTaskBean.revisionEdit}"
                                                                                  id="it57"/>
                                                                    <af:switcher facetName="#{!empty pageFlowScope.dateTimePattern}"
                                                                                 id="s14">
                                                                        <f:facet name="true">
                                                                            <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.releaseDate}"
                                                                                          label="#{resources.RELEASE_DATE}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.releaseDateShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                          id="id2">
                                                                                <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                   timeZone="#{pageFlowScope.tz}"
                                                                                                   dateStyle="#{pageFlowScope.df}"
                                                                                                   pattern="#{pageFlowScope.dateTimePattern}"
                                                                                                   timeStyle="#{pageFlowScope.tf}"/>
                                                                            </af:inputDate>
                                                                        </f:facet>
                                                                        <f:facet name="false">
                                                                            <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.releaseDate}"
                                                                                          label="#{resources.RELEASE_DATE}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.releaseDateShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                          id="id3">
                                                                                <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                   timeZone="#{pageFlowScope.tz}"
                                                                                                   dateStyle="#{pageFlowScope.df}"
                                                                                                   timeStyle="#{pageFlowScope.tf}"/>
                                                                            </af:inputDate>
                                                                        </f:facet>
                                                                    </af:switcher>
                                                                    <af:switcher facetName="#{!empty pageFlowScope.dateTimePattern}"
                                                                                 id="s15">
                                                                        <f:facet name="true">
                                                                            <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.expirationDate}"
                                                                                          label="#{resources.EXPIRATION_DATE}"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.expirationDateShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          id="id4">
                                                                                <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                   timeZone="#{pageFlowScope.tz}"
                                                                                                   dateStyle="#{pageFlowScope.df}"
                                                                                                   pattern="#{pageFlowScope.dateTimePattern}"
                                                                                                   timeStyle="#{pageFlowScope.tf}"/>
                                                                            </af:inputDate>
                                                                        </f:facet>
                                                                        <f:facet name="false">
                                                                            <af:inputDate value="#{pageFlowScope.ADFHumanTaskBean.expirationDate}"
                                                                                          label="#{resources.EXPIRATION_DATE}"
                                                                                          readOnly="#{!pageFlowScope.ADFHumanTaskBean.releaseDateEdit}"
                                                                                          visible="#{pageFlowScope.ADFHumanTaskBean.expirationDateShow}"
                                                                                          partialTriggers="edAttTy"
                                                                                          id="id5">
                                                                                <f:convertDateTime type="#{pageFlowScope.dt}"
                                                                                                   timeZone="#{pageFlowScope.tz}"
                                                                                                   dateStyle="#{pageFlowScope.df}"
                                                                                                   timeStyle="#{pageFlowScope.tf}"/>
                                                                            </af:inputDate>
                                                                        </f:facet>
                                                                    </af:switcher>
                                                                    <af:selectOneChoice value="#{pageFlowScope.ADFHumanTaskBean.securityGroup}"
                                                                                        label="#{resources.SECURITY_GROUP}"
                                                                                        visible="#{pageFlowScope.ADFHumanTaskBean.secGroupShow}"
                                                                                        required="true"
                                                                                        readOnly="#{!pageFlowScope.ADFHumanTaskBean.secGroupEdit}"
                                                                                        partialTriggers="edAttTy"
                                                                                        id="soc3">
                                                                        <f:selectItems value="#{pageFlowScope.ADFHumanTaskBean.securityGroupList}"
                                                                                       id="si7"/>
                                                                    </af:selectOneChoice>
                                                                </af:panelFormLayout>
                                                            </f:facet>
                                                        </af:switcher>
                                                    </af:panelGroupLayout>
                                                </f:facet>
                                                <f:facet name="ucm">
                                                    <af:panelGroupLayout layout="vertical" id="pgl6">
                                                        <af:inputListOfValues label="#{resources.DOCUMENT_ID}"
                                                                              id="idInputComboboxLOVWithTable"
                                                                              value="#{pageFlowScope.readAttachmentBean.ucmDocId}"
                                                                              autoSubmit="true"
                                                                              popupTitle="#{resources.SRCH_SLCT_DOC_ID}"
                                                                              searchDesc="#{resources.SRCH_SLCT_DOC_ID}"
                                                                              partialTriggers="edAttTy"
                                                                              model="#{pageFlowScope.ADFHumanTaskBean.listOfValuesModel}"
                                                                              columns="60"
                                                                              required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}"
                                                                              rendered="#{pageFlowScope.ADFHumanTaskBean.isUsingUCM}"
                                                                              visible="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}"/>
                                                    </af:panelGroupLayout>
                                                </f:facet>
                                            </af:switcher>
                                        </af:panelGroupLayout>
                                    </af:panelGroupLayout>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="popupDeleteAttachmentDialog" contentDelivery="lazyUncached"
                                      childCreation="deferred">
                                <af:dialog title="#{resources.DELETE_ATTACHMENT}" type="none" modal="true"
                                           closeIconVisible="false" id="attDelDlg">
                                    <f:facet name="buttonBar">
                                        <af:panelGroupLayout id="pgl25">
                                            <af:button textAndAccessKey="#{resources.OK_AK}"
                                                       actionListener="#{bindings.Delete2.execute}" immediate="true"
                                                       partialSubmit="true" id="delAtOK"
                                                       action="#{popupBean.hideAttachmentDeleteDialog}"/>
                                            <af:button textAndAccessKey="#{resources.CANCEL_AK}" id="delAtCan"
                                                       action="#{popupBean.hideAttachmentDeleteDialog}"
                                                       partialSubmit="true"/>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                    <af:panelGroupLayout id="pgl26">
                                        <af:panelFormLayout id="pfl19">
                                            <af:outputText id="delAttTxt" value="#{resources.DELETE_ATTACHMENT_MSG}"/>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="reassignPopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog id="reAsDg" dialogListener="#{invokeActionBean.reassignAction}"
                                           cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                           affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                           title="#{resources.REASSIGNPAGE}">
                                    <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                         workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                         id="reAsIdB" mode="REASSIGN" showActionButtons="false"
                                                         selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="requestInfoPopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{resources.INFOREQUESTEDPAGE}"
                                           cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                           affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                           dialogListener="#{invokeActionBean.requestInfoAction}" id="reqIfD">
                                    <wlc:requestInfoDialog workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                           id="rqIDgC"
                                                           selectedTaskId="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds[0]}"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="routePopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{resources.ROUTEPAGE}"
                                           cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                           affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                           dialogListener="#{invokeActionBean.routeTaskAction}" id="rteDg">
                                    <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                         workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}"
                                                         id="rteIdB" mode="ROUTE"
                                                         selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}"
                                                         showActionButtons="false"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="decomposePopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{pageFlowScope.ADFHumanTaskBean.decomposeDialogTitle}"
                                           cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                           affirmativeTextAndAccessKey="#{resources.OK_AK}"
                                           dialogListener="#{invokeActionBean.decomposeTaskAction}" id="dcmpDg">
                                    <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}"
                                                         workflowContext="#{pageFlowScope.ADFHumanTaskBean.workflowContext}"
                                                         id="dcmpIdB" mode="DECOMPOSE"
                                                         selectedTaskObject="#{pageFlowScope.ADFHumanTaskBean.task}"
                                                         showActionButtons="false"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="popupEnterPasswordDialog" contentDelivery="lazyUncached"
                                      childCreation="deferred">
                                <af:dialog title="#{resources.ENTER_PASSWORD}"
                                           dialogListener="#{invokeActionBean.validatePassword}" type="okCancel"
                                           modal="true" cancelTextAndAccessKey="#{resources.CANCEL_AK}"
                                           affirmativeTextAndAccessKey="#{resources.OK_AK}" closeIconVisible="false"
                                           id="pwdDlg">
                                    <af:panelGroupLayout id="pgl27">
                                        <af:panelFormLayout id="pfl20">
                                            <af:inputText id="pwdBox" rows="1" columns="50"
                                                          value="#{invokeActionBean.password}"
                                                          label="#{resources.PASSWORD}" secret="true" required="true"/>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="helpPopup" childCreation="deferred">
                                <af:switcher facetName="#{pageFlowScope.taskDocumentationBean.isTaskDoc}" id="s16">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="vertical" id="pgl28">
                                            <af:link text="#{resources.OPEN_IN_WINDOW}"
                                                     destination="#{pageFlowScope.taskDocumentationBean.docURL}"
                                                     targetFrame="help" id="help"
                                                     rendered="#{!empty bindings.activityId.inputValue}"/>
                                            <af:outputFormatted value="#{pageFlowScope.taskDocumentationBean.taskDoc}"
                                                                id="of1"/>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                    <f:facet name="false">
                                        <af:outputText value="#{resources.TASK_DOC_NOT_AVAILABLE}" id="ot29"/>
                                    </f:facet>
                                </af:switcher>
                            </af:popup>
                        </af:panelGroupLayout>
                    </af:panelHeader>
                    <f:facet name="separator"/>
                </af:panelGroupLayout>
            </af:form>
        </af:document>
    </f:view>
</jsp:root>