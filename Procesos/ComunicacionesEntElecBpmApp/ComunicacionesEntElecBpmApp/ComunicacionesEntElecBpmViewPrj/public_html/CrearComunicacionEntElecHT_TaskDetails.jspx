                                                                                  autoSubmit="true"/>
                                                        <af:inputText value="#{bindings.referencia.inputValue}" label=""
                                                                      disabled="#{not CrearComunicacionEntElecHT_jsfbean.tieneReferencia}"
                                                                      showRequired="#{CrearComunicacionEntElecHT_jsfbean.tieneReferencia}"
                                                                      columns="#{bindings.referencia.hints.displayWidth}"
                                                                      maximumLength="200"
                                                                      shortDesc="#{bindings.referencia.hints.tooltip}"
                                                                      placeholder="Referencia" partialTriggers="socRef"
