                                                                            disabled="#{not bindings.isPQRS.inputValue}"
                                                                            showRequired="#{bindings.isPQRS.inputValue}"
                                                                            partialTriggers="sbc2"
                                                                            valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarTipoPQRS}"
                                                                            binding="#{CrearComunicacionEntElecHT_jsfbean.socTipoPQRS}">
                                                            <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listTipoPQRSSI}"
                                                                           id="si14"/>
                                                        </af:selectOneChoice>
                                                        <af:panelLabelAndMessage label="#{bindings.tiempoRespuesta.hints.label}"
                                                                                 id="plam1" visible="false">
                                                            <af:outputText value="#{bindings.tiempoRespuesta.inputValue}"
                                                                           shortDesc="#{bindings.tiempoRespuesta.hints.tooltip}"
                                                                           id="ot2" visible="false">
                                                                <af:convertNumber groupingUsed="false"
                                                                                  pattern="#{bindings.tiempoRespuesta.format}"/>
                                                            </af:outputText>
                                                        </af:panelLabelAndMessage>
                                                        <af:outputLabel value="Fecha Vencimiento " id="ol1"
                                                                        visible="false"/>
