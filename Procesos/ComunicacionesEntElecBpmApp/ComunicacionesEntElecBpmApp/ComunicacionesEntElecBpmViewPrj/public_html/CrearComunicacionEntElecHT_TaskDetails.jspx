                                                                       id="otFechaVencimiento" visible="false"
                                                                       inlineStyle="font-size: 14px;">
                                                            <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                        </af:outputText>
                                                    </af:panelGroupLayout>
                                                    <af:spacer width="10" height="10" id="s25"/>
                                                    <af:panelGroupLayout id="pgl8" layout="vertical">
                                                        <af:selectBooleanCheckbox text="&#191;Referencia adicional?"
                                                                                  label=" " id="socRef"
