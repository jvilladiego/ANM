                                                        <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listaDepartamentoSI}"
                                                                       id="si12"/>
                                                    </af:selectOneChoice>
                                                    <af:spacer height="5px" id="s30"/>
