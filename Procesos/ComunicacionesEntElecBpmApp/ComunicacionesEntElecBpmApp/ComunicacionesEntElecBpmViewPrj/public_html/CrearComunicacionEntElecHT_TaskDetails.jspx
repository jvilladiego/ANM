                            <trh:cellFormat width="50%" valign="top"-->
                                <af:panelFormLayout maxColumns="2" rows="4" id="pfl5">
                                    <af:switcher facetName="#{bindings.taskViewContext == 'FYI'}" id="s16">
                                        <f:facet name="false">
                                            <af:panelLabelAndMessage id="assignees" label="#{resources.ASSIGNEES}">
                                                <af:iterator var="assignees" varStatus="varS"
                                                             value="#{bindings.assignees.collectionModel}" id="i2">
                                                    <af:switcher facetName="#{varS.index == 0}" id="s19">
                                                        <f:facet name="false">
                                                            <af:outputText value=", " id="ot25"/>
                                                        </f:facet>
                                                    </af:switcher>
                                                    <af:switcher facetName="#{!empty assignees.displayName}" id="s13">
                                                        <f:facet name="true">
