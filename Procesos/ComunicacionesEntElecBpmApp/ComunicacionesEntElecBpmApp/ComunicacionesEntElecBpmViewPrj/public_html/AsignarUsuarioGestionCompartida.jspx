<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core" xmlns:af="http://xmlns.oracle.com/adf/faces/rich">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <f:view xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:trh="http://myfaces.apache.org/trinidad/html" xmlns:wf="http://xmlns.oracle.com/bpel/workflow/workflow-taglib.tld" xmlns:wlc="http://xmlns.oracle.com/bpel/workflow/worklist">
        <af:document title="AsignarUsuarioGestionCompartida.jspx" id="d1">
            <af:messages id="m1"/>
            <af:resource type="javascript" source="/jsLibs/taskDetails.js"/>
            <af:resource type="javascript" source="/jsLibs/commonBPM.js"/>
            <af:form id="f1" usesUpload="true">
                <af:panelGroupLayout layout="vertical" inlineStyle="padding: 5px;" id="pgl1">
                    <af:panelHeader text="#{bindings.title.inputValue}" id="ph1">
                        <f:facet name="info"/>
                        <f:facet name="legend"/>
                        <f:facet name="menuBar"/>
                        <f:facet name="toolbar">
                            <af:toolbar visible="#{actionAvailable.toolbarAvailable}" id="t1">
                                <af:switcher id="customActionButtons" facetName="#{actionAvailable.isCustomActionButtons}">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="horizontal" id="pgl2">
                                            <af:button actionListener="#{invokeActionBean.setOperation}" text="#{wf:getResourceValue('ACCEPT', 'bindings.customActions')}" disabled="#{!bindings.ACCEPT.enabled}" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{wf:isCustomActionAvailable('ACCEPT', 'bindings.customActions')}" id="b1">
                                                <f:attribute name="DC_OPERATION_BINDING" value="bindings.ACCEPT"/>
                                            </af:button>
                                            <af:button id="button_save" textAndAccessKey="#{resources.SAVE}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="false" rendered="#{actionAvailable.updateAvailable}">
                                                        <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                                    </af:button>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                </af:switcher>
                                <af:button actionListener="#{invokeActionBean.setOperation}" text="#{resources.CLAIM}" id="Claim" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{actionAvailable.claimAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Claim"/>
                                </af:button>
                                <af:button id="acknowledge" actionListener="#{invokeActionBean.setOperation}" text="#{resources.ACKNOWLEDGE}" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{actionAvailable.isFyiTask}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Acknowledge"/>
                                </af:button>
                                <af:button id="resume" actionListener="#{invokeActionBean.setOperation}" text="#{resources.RESUME}" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{actionAvailable.resumeAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Resume"/>
                                </af:button>
                                <!-- menu acciones  se agrega la propiedad visible="false" -->
                                <af:panelGroupLayout layout="horizontal" id="pgl3" visible="false">
                                    <af:group rendered="#{!((empty actionAvailable.customActions) and (empty actionAvailable.redirectActions) and (empty actionAvailable.otherActions)) || bindings.update.enabled}" id="g1">
                                        <af:menuBar id="mb1">
                                            <af:menu id="acts" text="#{resources.TASK_ACTIONS}" visible="#{actionAvailable.actionsAvailable || bindings.update.enabled}">
                                                <af:group id="g2">
                                                    <af:forEach var="childNode1" items="#{actionAvailable.customActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{childNode1.displayName}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="false" id="cmi2">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode1.action}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g3">
                                                    <af:forEach var="childNode2" items="#{actionAvailable.redirectActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode2]}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="true" id="cmi1">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode2}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g4">
                                                    <af:forEach var="childNode3" items="#{actionAvailable.otherActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode3]}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="false" id="cmi4">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode3}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g5">
                                                    <af:commandMenuItem id="save" textAndAccessKey="#{resources.SAVE}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="false" rendered="#{actionAvailable.updateAvailable}">
                                                        <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                                    </af:commandMenuItem>
                                                </af:group>
                                            </af:menu>
                                        </af:menuBar>
                                    </af:group>
                                </af:panelGroupLayout>
                                <af:spacer width="10" id="s1"/>
                                <af:link shortDesc="#{resources.PREVIOUS_TASK}" icon="#{ adfFacesContext.rightToLeft ? '/hw_images/nexttraversalarrow_ena.png'  : '/hw_images/previoustraversalarrow_ena.png'}" action="fetchPreviousTask" visible="#{pageFlowScope.enableNavigationButton != null}" id="l1"/>
                                <af:spacer width="10" id="s2"/>
                                <af:link shortDesc="#{resources.NEXT_TASK}" icon="#{ adfFacesContext.rightToLeft ? '/hw_images/previoustraversalarrow_ena.png' : '/hw_images/nexttraversalarrow_ena.png'}" action="fetchNextTask" visible="#{pageFlowScope.enableNavigationButton != null}" id="l2"/>
                                <af:spacer width="10" id="s3"/>
                                <af:link shortDesc="#{resources.SHORT_DESC_CLOSE}" icon="/hw_images/close_ena.png" action="closeTaskFlow" visible="#{pageFlowScope.enableNavigationButton != null}" id="l3"/>
                            </af:toolbar>
                        </f:facet>
                        <f:facet name="context"/>
                        <af:panelGroupLayout layout="vertical" id="pgl4">
                            <f:facet name="separator">
                                <af:spacer width="15" height="15" id="s4"/>
                            </f:facet>
                            <af:showDetailHeader size="2" id="dtHead" text="#{resources.DETAILS}" shortDesc="#{resources.TASK_HEADER}" icon="/hw_images/singleapprover_35x35.png" disclosed="#{actionAvailable.discloseHeader}">
                                <f:facet name="context">
                                    <af:link icon="/hw_images/info.png" id="button" clientComponent="true" rendered="#{!empty bindings.activityId.inputValue}">
                                        <af:showPopupBehavior popupId="helpPopup" align="afterEnd" alignId="button"/>
                                    </af:link>
                                </f:facet>
                                <f:facet name="toolbar"/>
                                <!--trh:tableLayout id="detailTableLayout" width="98%">
                        <trh:rowLayout>
                            <trh:cellFormat width="50%" valign="top"-->
                                <af:panelFormLayout maxColumns="2" rows="4" id="pfl1">
                                    <af:switcher facetName="#{bindings.taskViewContext == 'FYI'}" id="s5">
                                        <f:facet name="false">
                                            <af:panelLabelAndMessage id="assignees" label="#{resources.ASSIGNEES}">
                                                <af:iterator var="assignees" varStatus="varS" value="#{bindings.assignees.collectionModel}" id="i1">
                                                    <af:switcher facetName="#{varS.index == 0}" id="s6">
                                                        <f:facet name="false">
                                                            <af:outputText value=", " id="ot1"/>
                                                        </f:facet>
                                                    </af:switcher>
                                                    <af:switcher facetName="#{!empty assignees.displayName}" id="s7">
                                                        <f:facet name="true">
                                                            <af:outputText value="#{assignees.displayName}" id="ot2"/>
                                                        </f:facet>
                                                        <f:facet name="false">
                                                            <af:outputText value="#{assignees.id}" id="ot3"/>
                                                        </f:facet>
                                                    </af:switcher>
                                                </af:iterator>
                                            </af:panelLabelAndMessage>
                                        </f:facet>
                                    </af:switcher>
                                    <af:panelLabelAndMessage id="creator" label="#{resources.CREATOR}">
                                        <af:outputText value="#{bindings.creatorDisplayName.inputValue}" id="ot4"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="createdDate" label="#{resources.CREATE_DATE}">
                                        <af:outputText value="#{bindings.fecRadicacion.inputValue}" noWrap="true" id="ot5">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="updatedDate" label="#{resources.UPDATE_DATE}">
                                        <af:outputText value="#{bindings.updatedDate.inputValue}" noWrap="true" id="ot6">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="expirationDate" label="#{resources.EXPIRATION_DATE}">
                                        <af:outputText value="#{bindings.expirationDate.inputValue}" id="ot7">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="acquiredBy" label="#{resources.ACQUIRED_BY}">
                                        <af:switcher facetName="#{!empty bindings.acquiredByDisplayName.inputValue}" id="s8">
                                            <f:facet name="true">
                                                <af:outputText value="#{bindings.acquiredByDisplayName.inputValue}" id="ot8"/>
                                            </f:facet>
                                            <f:facet name="false">
                                                <af:outputText value="#{bindings.acquiredBy.inputValue}" id="ot9"/>
                                            </f:facet>
                                        </af:switcher>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="dueDate" label="#{resources.DUE_DATE}" rendered="#{!empty bindings.dueDate.inputValue}">
                                        <af:outputText value="#{bindings.dueDate.inputValue}" noWrap="true" id="ot10">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="outcome" label="#{resources.OUTCOME}" rendered="#{!empty bindings.actionDisplayName.inputValue}">
                                        <af:outputText value="#{bindings.actionDisplayName.inputValue}" id="ot11"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="taskNumber" label="#{resources.TASK_NUMBER}">
                                        <af:outputText value="#{bindings.taskNumber.inputValue}" id="ot12"/>
                                    </af:panelLabelAndMessage>
                                    <af:inputText id="priority" value="#{bindings.priority.inputValue}" label="#{resources.PRIORITY}" required="#{bindings.priority.mandatory}" columns="3" validator="#{actionAvailable.validatePriorityValue}"/>
                                    <af:panelLabelAndMessage id="state" label="#{resources.STATE}">
                                        <af:outputText value="#{resources[bindings.state.inputValue]}" id="ot13"/>
                                    </af:panelLabelAndMessage>
                                </af:panelFormLayout>
                                <!--/trh:cellFormat>
                            <trh:cellFormat>
                                <af:spacer width="15" height="15"/>
                            </trh:cellFormat>
                            <trh:cellFormat width="50%" valign="top">
                                <af:panelFormLayout>
                                    <f:facet name="footer"/>
                                </af:panelFormLayout>
                            </trh:cellFormat>
                        </trh:rowLayout>
                    </trh:tableLayout-->
                            </af:showDetailHeader>
                            <af:showDetailHeader size="2" id="apCntHd" text="#{resources.CONTENTS}" disclosed="#{actionAvailable.discloseContents}">
                                <af:panelBox text="General" id="pb7">
                                    <f:facet name="toolbar"/>
                                    <af:panelGroupLayout id="pgl23" layout="horizontal">
                                        <af:panelFormLayout id="pfl3">
                                            <af:panelLabelAndMessage label="Fecha Radicaci&#243;n" id="plam2">
                                                <af:outputText value="#{bindings.fecRadicacion.inputValue}" id="otFecha" inlineStyle="font-size: 14px;">
                                                    <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                </af:outputText>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="Fecha Vencimiento" id="plam3">
                                                <af:outputText value="#{bindings.fechaVencimiento.inputValue}" id="otFechaVencimiento" inlineStyle="font-size: 14px;">
                                                    <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                </af:outputText>
                                            </af:panelLabelAndMessage>
                                        </af:panelFormLayout>
                                        <af:spacer width="20" height="10" id="s18"/>
                                        <af:panelFormLayout id="pfl4">
                                            <af:panelLabelAndMessage label="No. Radicado" id="plam1">
                                                <af:outputText inlineStyle="font-size: 14px;" value="#{bindings.nroRadicado.inputValue}" id="it5"/>
                                            </af:panelLabelAndMessage>
                                            <af:panelLabelAndMessage label="#{bindings.tiempoRespuesta.hints.label}" id="plam4">
                                                <af:outputText value="#{bindings.tiempoRespuesta.inputValue eq 0?'No asignado':bindings.tiempoRespuesta.inputValue}" shortDesc="#{bindings.tiempoRespuesta.hints.tooltip}" id="ot18">
                                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.tiempoRespuesta.format}"/>
                                                </af:outputText>
                                                <af:outputText value=" (d&#237;as h&#225;biles)" id="ot17"/>
                                            </af:panelLabelAndMessage>
                                        </af:panelFormLayout>
                                        <af:spacer width="20" height="10" id="s11"/>
                                        <af:panelFormLayout id="pfl5">
                                            <af:inputText label="Funcionario" value="#{CrearComunicacionEntElecHT_jsfbean.user}" readOnly="true" id="aot2"/>
                                            <af:inputText label="Dependencia" value="#{CrearComunicacionEntElecHT_jsfbean.dependencia}" readOnly="true" id="ot15"/>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:panelBox>
                                <af:panelBox text="Remitente" id="pb1">
                                    <af:panelFormLayout id="pfl2" styleClass="AFStretchWidth">
                                        <af:inputText value="#{bindings.tipoIdentificacion.inputValue}" label="Tipo de Identificaci&#243;n" required="true" columns="30" readOnly="true" id="it1"/>
                                        <af:inputText value="#{bindings.numeroIdentificacion.inputValue}" readOnly="true" label="No. Identificaci&#243;n" shortDesc="N&#250;mero de Identificaci&#243;n" id="it20">
                                            <f:validator binding="#{bindings.numeroIdentificacion.validator}"/>
                                        </af:inputText>
                                        <af:inputText value="#{bindings.primerNombre.inputValue}" label="Primer Nombre" readOnly="true" columns="50" id="it_primernombre"/>
                                        <af:inputText value="#{bindings.segundoNombre.inputValue}" label="Segundo Nombre" readOnly="true" columns="50" id="it_segundonombre"/>
                                        <af:inputText value="#{bindings.primerApellido.inputValue}" label="Primer Apellido" readOnly="true" columns="50" id="it_primerapellido"/>
                                        <af:inputText value="#{bindings.segundoApellido.inputValue}" label="Segundo Apellido" readOnly="true" columns="50" id="it_segundoapellido"/>
                                        <af:inputText value="#{bindings.email.inputValue}" label="Email" readOnly="true" columns="50" id="it2"/>
                                        <af:inputText value="#{bindings.telefono.inputValue}" label="Tel&#233;fono" readOnly="true" columns="20" id="it3"/>
                                        <af:inputText value="#{bindings.celular.inputValue}" readOnly="true"
                                                                  label="Celular" columns="20" id="it_celular"/>
                                        <af:inputText value="#{bindings.direccion.inputValue}" label="#{bindings.direccion.hints.label}" readOnly="true" id="it18">
                                            <f:validator binding="#{bindings.direccion.validator}"/>
                                        </af:inputText>
                                        <af:selectOneChoice value="#{bindings.idPais.inputValue}" id="soc5" label="Pa&#237;s" readOnly="true">
                                            <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listaPaisSI}" id="si9"/>
                                        </af:selectOneChoice>
                                        <af:selectOneChoice value="#{bindings.idDepartamento.inputValue}" id="soc8" label="Departamento" readOnly="true">
                                            <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listaDepartamentoSI}" id="si12"/>
                                        </af:selectOneChoice>
                                        <af:selectOneChoice value="#{bindings.idMunicipio.inputValue}" id="soc9" label="Ciudad/Municipio" readOnly="true">
                                            <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listaMunicipioSI}" id="si13"/>
                                        </af:selectOneChoice>
                                        <af:inputText value="#{bindings.ocupacion.inputValue}" label="#{bindings.ocupacion.hints.label}" readOnly="true" id="it15">
                                            <f:validator binding="#{bindings.ocupacion.validator}"/>
                                        </af:inputText>
                                        <af:selectOneChoice value="#{bindings.idRangoEdad.inputValue}" id="juc1" label="Rango de Edad" readOnly="true">
                                            <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listaRangoEdadSI}" id="sijuc"/>
                                        </af:selectOneChoice>
                                        <af:selectOneChoice value="#{bindings.idPoblacionVulnerable.inputValue}" id="soc6" label="Poblaci&#243;n Vulnerable" readOnly="true">
                                            <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listaPoblacionVulnerableSI}" id="si10"/>
                                        </af:selectOneChoice>
                                        <af:selectOneChoice value="#{bindings.idEtnia.inputValue}" id="soc7" label="Etnia" readOnly="true">
                                            <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listaEtniaSI}" id="si11"/>
                                        </af:selectOneChoice>
                                    </af:panelFormLayout>
                                </af:panelBox>
                                <af:panelBox text="Gesti&#243;n Compartida" id="pb3">
                                    <af:spacer height="10" rendered="#{actionAvailable.isCommentUpdatable}" id="s10"/>
                                    <af:outputText value="Se ha solicitado la colaboraci&#243;n de su Dependencia para dar gesti&#243;n a &#233;sta comunicaci&#243;n. Por favor designe un usuario." id="ot26"/>
                                    <af:spacer height="20" id="s19"/>
                                    <af:selectOneChoice valueChangeListener="#{CrearComunicacionEntElecHT_jsfbean.cambiarUsuarioGestionCompartida}"
                                    autoSubmit="true"
                                    label="Usuario Competente" required="true" id="soc4">
                                        <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listUsuariosSI}" id="si8"/>
                                    </af:selectOneChoice>
                                </af:panelBox>
                                <af:panelBox text="Contenido" id="pb_contenido">
                                    <f:facet name="toolbar"/>
                                    <af:panelLabelAndMessage label="Documento Principal" id="plam5" rendered="#{CrearComunicacionEntElecHT_jsfbean.renderDocPrincipal}">
                                        <af:link targetFrame="_blank" text="#{bindings.nroRadicado.inputValue}" destination="#{bindings.urlDocumentoPrincipalDO.inputValue}" id="l4"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage label="Documento Adjunto" id="plam6" rendered="#{CrearComunicacionEntElecHT_jsfbean.renderAdjunto}">
                                        <af:link targetFrame="_blank" text="anexo-1" destination="#{bindings.urlArchivoAdjuntoDO.inputValue}" id="l5"/>
                                    </af:panelLabelAndMessage>
                                    <af:inputText value="#{bindings.asunto.inputValue}" label="Asunto :" shortDesc="#{bindings.asunto.hints.tooltip}" readOnly="true" id="it36">
                                        <f:validator binding="#{bindings.asunto.validator}"/>
                                    </af:inputText>
                                    <af:spacer width="20" height="10" id="s23"/>
                                    <af:panelGroupLayout id="pgl10" layout="horizontal">
                                        <af:panelFormLayout id="pfl15">
                                            <af:inputText label="Expediente Minero" id="it_expminero" readOnly="true" value="#{bindings.nroPlaca.inputValue}"/>
                                            <af:inputText label="Referencia Adicional" id="it_referencia" readOnly="true" value="#{bindings.referencia.inputValue}"/>
                                        </af:panelFormLayout>
                                        <af:spacer width="100" height="10" id="s21"/>
                                        <af:panelFormLayout id="pf_pqrs">
                                            <af:selectBooleanCheckbox value="#{bindings.isPQRSDO.inputValue}" simple="false" text="&#191;PQRS?" required="false" shortDesc="true" id="sbc2" autoSubmit="true" readOnly="true"/>
                                            <af:selectOneChoice value="#{bindings.idTipoPQRS.inputValue}" id="soc10" label="Tipo PQRS" disabled="#{not bindings.isPQRSDO.inputValue}" partialTriggers="sbc2" readOnly="true">
                                                <f:selectItems value="#{CrearComunicacionEntElecHT_jsfbean.listTipoPQRSSI}" id="si14"/>
                                            </af:selectOneChoice>
                                            <af:inputText id="it_reqrespuesta" label="Requiere Respuesta" value="#{bindings.requiereRespuestaDO.inputValue eq 'S'?'SI':'NO'}" readOnly="true"></af:inputText>
                                        </af:panelFormLayout>
                                        <af:spacer width="100" height="10" id="s25"/>
                                        <af:panelFormLayout id="pf_yesnoquestions">
                                            <af:inputText id="it_accesongedo" label="Acceso Negado Informaci&#243;n" value="#{bindings.accesoNegadoInformacionDO.inputValue eq 'S'?'SI':'NO'}" readOnly="true"></af:inputText>
                                            <af:inputText id="it_identificacionreservada" label="Identificaci&#243;n Reservada" value="#{bindings.identificacionReservadaDO.inputValue eq 'S'?'SI':'NO'}" readOnly="true"></af:inputText>
                                            <af:inputText id="it_traslado" label="Traslado a otra Instituci&#243;n" value="#{bindings.trasladoOtraInstitucionDO.inputValue eq 'S'?'SI':'NO'}" readOnly="true"></af:inputText>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:panelBox>
                                <af:panelBox text="Adjuntos" id="pb_adjuntos">
                                    <wlc:manageDocuments docBean="#{pageFlowScope.docMgmtBean}" id="manageDocs" rendered="#{!actionAvailable.inNotificationClient}"/>
                                </af:panelBox>
                                <af:panelBox text="#{resources.COMMENTS}" disclosed="#{actionAvailable.discloseComments}" contentStyle="padding: 5px;" partialTriggers="commentSubmit" id="sdh1">
                                    <af:panelGroupLayout layout="vertical" inlineStyle="padding:10px;" id="dc_pgl1">
                                        <af:inputText id="cmtBox_2" rows="2" columns="80" wrap="off" partialTriggers="commentSubmit" value="#{commentBean.value}" visible="#{actionAvailable.isCommentUpdatable}" maximumLength="2000" label="" inlineStyle="text-align:left;"/>
                                        <af:spacer height="5" rendered="#{actionAvailable.isCommentUpdatable}" id="s9"/>
                                        <af:toolbar rendered="#{actionAvailable.isCommentUpdatable}" id="t4">
                                            <af:commandButton id="commentSubmit" text="#{resources.POST_COMMENT}" partialSubmit="true" actionListener="#{bindings.CreateInsert2.execute}" action="#{commentBean.addComment}"/>
                                        </af:toolbar>
                                        <af:spacer height="10" id="dc_s7" rendered="#{actionAvailable.isCommentUpdatable}"/>
                                        <af:outputText value="#{resources.NO_ROWS_YET}" rendered="#{(actionAvailable.isCommentUpdatable) and (empty bindings.userComment)}" id="ot29"/>
                                        <af:forEach items="#{bindings.userComment.children}" var="row">
                                            <af:panelGroupLayout id="pgl21" layout="horizontal" valign="top">
                                                <af:image source="/images/simple_16x16.png" id="i19"/>
                                                <af:spacer width="10" height="10" id="s27"/>
                                                <af:panelGroupLayout id="pgl22" layout="vertical">
                                                    <af:panelGroupLayout id="pgl69" layout="horizontal">
                                                        <af:switcher facetName="#{row.updatedBy.displayName != null}" id="s17">
                                                            <f:facet name="true">
                                                                <af:group id="g12">
                                                                    <af:outputText value="#{row.updatedBy.displayName}" id="ot59" inlineStyle="font-weight:bold;"/>
