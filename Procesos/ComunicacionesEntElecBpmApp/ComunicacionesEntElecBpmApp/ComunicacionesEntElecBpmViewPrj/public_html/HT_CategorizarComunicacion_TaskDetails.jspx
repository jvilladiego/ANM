<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich">
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <f:view xmlns:c="http://java.sun.com/jsp/jstl/core" xmlns:trh="http://myfaces.apache.org/trinidad/html"
            xmlns:wf="http://xmlns.oracle.com/bpel/workflow/workflow-taglib.tld"
            xmlns:wlc="http://xmlns.oracle.com/bpel/workflow/worklist">
        <af:document title="HT_CategorizarComunicacion_TaskDetails" id="d1">
            <af:messages id="m1"/>
            <af:resource type="javascript" source="/jsLibs/taskDetails.js"/>
            <af:resource type="javascript" source="/jsLibs/commonBPM.js"/>
            <af:form id="f1" usesUpload="true">
                <af:panelGroupLayout layout="vertical" inlineStyle="padding: 5px;" id="pgl1">
                    <af:panelHeader text="#{bindings.title.inputValue}" id="ph1">
                        <f:facet name="info"/>
                        <f:facet name="legend"/>
                        <f:facet name="menuBar"/>
                        <f:facet name="toolbar">
                            <af:toolbar visible="#{actionAvailable.toolbarAvailable}" id="t1">
                                <af:switcher id="customActionButtons" facetName="#{actionAvailable.isCustomActionButtons}">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="horizontal" id="pgl2">
                                            <af:button actionListener="#{categorizarComBean.enviarComunicado}" 
                                                        text="#{wf:getResourceValue('APPROVE', 'bindings.customActions')}" 
                                                        disabled="#{!bindings.APPROVE.enabled}" 
                                                        action="#{invokeActionBean.invokeOperation}" 
                                                        partialSubmit="false" 
                                                        visible="#{wf:isCustomActionAvailable('APPROVE', 'bindings.customActions')}" 
                                                        id="b1">
                                                <f:attribute name="DC_OPERATION_BINDING" value="bindings.APPROVE"/>
                                            </af:button>
                                            <!--af:button actionListener="#{invokeActionBean.setOperation}" text="#{wf:getResourceValue('REJECT', 'bindings.customActions')}" disabled="#{!bindings.REJECT.enabled}" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{wf:isCustomActionAvailable('REJECT', 'bindings.customActions')}" id="b2">
                                                <f:attribute name="DC_OPERATION_BINDING" value="bindings.REJECT"/>
                                            </af:button-->
                                        </af:panelGroupLayout>
                                    </f:facet>
                                </af:switcher>
                                <af:button actionListener="#{invokeActionBean.setOperation}" text="#{resources.CLAIM}" id="Claim" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{actionAvailable.claimAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Claim"/>
                                </af:button>
                                <af:button id="acknowledge" actionListener="#{invokeActionBean.setOperation}" text="#{resources.ACKNOWLEDGE}" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{actionAvailable.isFyiTask}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Acknowledge"/>
                                </af:button>
                                <af:button id="resume" actionListener="#{invokeActionBean.setOperation}" text="#{resources.RESUME}" action="#{invokeActionBean.invokeOperation}" partialSubmit="false" visible="#{actionAvailable.resumeAvailable}">
                                    <f:attribute name="DC_OPERATION_BINDING" value="bindings.Resume"/>
                                </af:button>
                                <af:panelGroupLayout layout="horizontal" id="pgl3">
                                    <af:group rendered="#{!((empty actionAvailable.customActions) and (empty actionAvailable.redirectActions) and (empty actionAvailable.otherActions)) || bindings.update.enabled}" id="g1">
                                        <af:menuBar id="mb1">
                                            <af:menu id="acts" text="#{resources.TASK_ACTIONS}" visible="#{actionAvailable.actionsAvailable || bindings.update.enabled}">
                                                <af:group id="g2">
                                                    <af:forEach var="childNode1" items="#{actionAvailable.customActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{childNode1.displayName}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="false" id="cmi2">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode1.action}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g3">
                                                    <af:forEach var="childNode2" items="#{actionAvailable.redirectActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode2]}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="true" id="cmi1">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode2}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g4">
                                                    <af:forEach var="childNode3" items="#{actionAvailable.otherActions}">
                                                        <af:commandMenuItem textAndAccessKey="#{resources[childNode3]}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="false" id="cmi4">
                                                            <f:attribute name="ACTION_MENU_ITEM" value="#{childNode3}"/>
                                                        </af:commandMenuItem>
                                                    </af:forEach>
                                                </af:group>
                                                <af:group id="g5">
                                                    <af:commandMenuItem id="save" textAndAccessKey="#{resources.SAVE}" actionListener="#{invokeActionBean.setAction}" action="#{invokeActionBean.action}" partialSubmit="false" rendered="#{actionAvailable.updateAvailable}">
                                                        <f:attribute name="ACTION_MENU_ITEM" value="bindings.update"/>
                                                    </af:commandMenuItem>
                                                </af:group>
                                            </af:menu>
                                        </af:menuBar>
                                    </af:group>
                                </af:panelGroupLayout>
                                <af:spacer width="10" id="s1"/>
                                <af:link shortDesc="#{resources.PREVIOUS_TASK}" icon="#{ adfFacesContext.rightToLeft ? '/hw_images/nexttraversalarrow_ena.png'  : '/hw_images/previoustraversalarrow_ena.png'}" action="fetchPreviousTask" visible="#{pageFlowScope.enableNavigationButton != null}" id="l1"/>
                                <af:spacer width="10" id="s2"/>
                                <af:link shortDesc="#{resources.NEXT_TASK}" icon="#{ adfFacesContext.rightToLeft ? '/hw_images/previoustraversalarrow_ena.png' : '/hw_images/nexttraversalarrow_ena.png'}" action="fetchNextTask" visible="#{pageFlowScope.enableNavigationButton != null}" id="l2"/>
                                <af:spacer width="10" id="s3"/>
                                <af:link shortDesc="#{resources.SHORT_DESC_CLOSE}" icon="/hw_images/close_ena.png" action="closeTaskFlow" visible="#{pageFlowScope.enableNavigationButton != null}" id="l3"/>
                            </af:toolbar>
                        </f:facet>
                        <f:facet name="context"/>
                        <af:panelGroupLayout layout="vertical" id="pgl4">
                            <f:facet name="separator">
                                <af:spacer width="15" height="15" id="s4"/>
                            </f:facet>
                            <af:showDetailHeader size="2" id="dtHead" text="#{resources.DETAILS}" shortDesc="#{resources.TASK_HEADER}" icon="/hw_images/singleapprover_35x35.png" disclosed="#{actionAvailable.discloseHeader}">
                                <f:facet name="context">
                                    <af:link icon="/hw_images/info.png" id="button" clientComponent="true" rendered="#{!empty bindings.activityId.inputValue}">
                                        <af:showPopupBehavior popupId="helpPopup" align="afterEnd" alignId="button"/>
                                    </af:link>
                                </f:facet>
                                <f:facet name="toolbar"/>
                                <!--trh:tableLayout id="detailTableLayout" width="98%">
                        <trh:rowLayout>
                            <trh:cellFormat width="50%" valign="top"-->
                                <af:panelFormLayout maxColumns="2" rows="4" id="pfl1">
                                    <af:switcher facetName="#{bindings.taskViewContext == 'FYI'}" id="s5">
                                        <f:facet name="false">
                                            <af:panelLabelAndMessage id="assignees" label="#{resources.ASSIGNEES}">
                                                <af:iterator var="assignees" varStatus="varS" value="#{bindings.assignees.collectionModel}" id="i1">
                                                    <af:switcher facetName="#{varS.index == 0}" id="s6">
                                                        <f:facet name="false">
                                                            <af:outputText value=", " id="ot1"/>
                                                        </f:facet>
                                                    </af:switcher>
                                                    <af:switcher facetName="#{!empty assignees.displayName}" id="s7">
                                                        <f:facet name="true">
                                                            <af:outputText value="#{assignees.displayName}" id="ot2"/>
                                                        </f:facet>
                                                        <f:facet name="false">
                                                            <af:outputText value="#{assignees.id}" id="ot3"/>
                                                        </f:facet>
                                                    </af:switcher>
                                                </af:iterator>
                                            </af:panelLabelAndMessage>
                                        </f:facet>
                                    </af:switcher>
                                    <af:panelLabelAndMessage id="creator" label="#{resources.CREATOR}">
                                        <af:outputText value="#{bindings.creatorDisplayName.inputValue}" id="ot4"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="createdDate" label="#{resources.CREATE_DATE}">
                                        <af:outputText value="#{bindings.createdDate.inputValue}" noWrap="true" id="ot5">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="updatedDate" label="#{resources.UPDATE_DATE}">
                                        <af:outputText value="#{bindings.updatedDate.inputValue}" noWrap="true" id="ot6">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="expirationDate" label="#{resources.EXPIRATION_DATE}">
                                        <af:outputText value="#{bindings.expirationDate.inputValue}" id="ot7">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="acquiredBy" label="#{resources.ACQUIRED_BY}">
                                        <af:switcher facetName="#{!empty bindings.acquiredByDisplayName.inputValue}" id="s8">
                                            <f:facet name="true">
                                                <af:outputText value="#{bindings.acquiredByDisplayName.inputValue}" id="ot8"/>
                                            </f:facet>
                                            <f:facet name="false">
                                                <af:outputText value="#{bindings.acquiredBy.inputValue}" id="ot9"/>
                                            </f:facet>
                                        </af:switcher>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="dueDate" label="#{resources.DUE_DATE}" rendered="#{!empty bindings.dueDate.inputValue}">
                                        <af:outputText value="#{bindings.dueDate.inputValue}" noWrap="true" id="ot10">
                                            <f:convertDateTime type="#{pageFlowScope.dt}" timeZone="#{pageFlowScope.tz}" dateStyle="#{pageFlowScope.df}" timeStyle="#{pageFlowScope.tf}" pattern="#{pageFlowScope.dateTimePattern}"/>
                                        </af:outputText>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="outcome" label="#{resources.OUTCOME}" rendered="#{!empty bindings.actionDisplayName.inputValue}">
                                        <af:outputText value="#{bindings.actionDisplayName.inputValue}" id="ot11"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage id="taskNumber" label="#{resources.TASK_NUMBER}">
                                        <af:outputText value="#{bindings.taskNumber.inputValue}" id="ot12"/>
                                    </af:panelLabelAndMessage>
                                    <af:inputText id="priority" value="#{bindings.priority.inputValue}" label="#{resources.PRIORITY}" required="#{bindings.priority.mandatory}" columns="3" validator="#{actionAvailable.validatePriorityValue}"/>
                                    <af:panelLabelAndMessage id="state" label="#{resources.STATE}">
                                        <af:outputText value="#{resources[bindings.state.inputValue]}" id="ot13"/>
                                    </af:panelLabelAndMessage>
                                </af:panelFormLayout>
                                <!--/trh:cellFormat>
                            <trh:cellFormat>
                                <af:spacer width="15" height="15"/>
                            </trh:cellFormat>
                            <trh:cellFormat width="50%" valign="top">
                                <af:panelFormLayout>
                                    <f:facet name="footer"/>
                                </af:panelFormLayout>
                            </trh:cellFormat>
                        </trh:rowLayout>
                    </trh:tableLayout-->
                            </af:showDetailHeader>
                            <af:showDetailHeader size="2" id="apCntHd" text="#{resources.CONTENTS}" 
                                                disclosed="#{actionAvailable.discloseContents}">
                                <af:showDetailHeader text="DEBUG" disclosed="true" id="sdh2" rendered="false">
                                    <f:facet name="context"/>
                                    <f:facet name="toolbar"/>
                                    <f:facet name="menuBar"/>
                                    <f:facet name="legend"/>
                                    <f:facet name="info"/>
                                    <af:panelFormLayout id="pfl3">
                                        <f:facet name="footer"/>
                                        <af:inputText value="#{bindings.taskNumber.inputValue}"
                                                      label="#{bindings.taskNumber.hints.label}"
                                                      readOnly="true" id="it10">
                                            <f:validator binding="#{bindings.taskNumber.validator}"/>
                                            <af:convertNumber groupingUsed="false"
                                                              pattern="#{bindings.taskNumber.format}"/>
                                        </af:inputText>
                                        <af:inputText value="#{bindings.taskId.inputValue}"
                                                      label="#{bindings.taskId.hints.label}"
                                                      readOnly="true" id="it11">
                                            <f:validator binding="#{bindings.taskId.validator}"/>
                                        </af:inputText>
                                        <af:inputText value="#{bindings.id.inputValue}"
                                                      label="Form user"
                                                      readOnly="true" id="it12">
                                            <f:validator binding="#{bindings.id.validator}"/>
                                        </af:inputText>
                                        
                                        <af:inputText value="#{bindings.id7.inputValue}"
                                                      label="Assignees User"
                                                      required="#{bindings.id7.hints.mandatory}"
                                                      columns="#{bindings.id7.hints.displayWidth}"
                                                      maximumLength="#{bindings.id7.hints.precision}"
                                                      shortDesc="#{bindings.id7.hints.tooltip}" id="it14">
                                            <f:validator binding="#{bindings.id7.validator}"/>
                                        </af:inputText>
                                        <af:inputText value="#{bindings.acquiredBy.inputValue}"
                                                      label="#{bindings.acquiredBy.hints.label}"
                                                      required="#{bindings.acquiredBy.hints.mandatory}"
                                                      columns="#{bindings.acquiredBy.hints.displayWidth}"
                                                      maximumLength="#{bindings.acquiredBy.hints.precision}"
                                                      shortDesc="#{bindings.acquiredBy.hints.tooltip}" id="it13">
                                            <f:validator binding="#{bindings.acquiredBy.validator}"/>
                                        </af:inputText>
                                    </af:panelFormLayout>
                                </af:showDetailHeader>
                                <af:panelBox text="General" id="pb7">
                                        <f:facet name="toolbar"/>
                                        <af:panelGroupLayout id="pgl23" layout="horizontal">
                                            <af:panelFormLayout id="pfl9">
                                                <af:panelLabelAndMessage label="Fecha Radicaci&#243;n" id="plam2">
                                                    <af:outputText value="#{bindings.fecRadicacion.inputValue}"
                                                                   id="otFecha" inlineStyle="font-size: 14px;">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="Fecha Vencimiento" id="plam3">
                                                    <af:outputText value="#{bindings.fechaVencimiento.inputValue}"
                                                                   id="otFechaVencimiento"
                                                                   inlineStyle="font-size: 14px;">
                                                        <af:convertDateTime pattern="dd-MMM-yyyy hh:mm:ss a"/>
                                                    </af:outputText>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:spacer width="20" height="10" id="s18"/>
                                            <af:panelFormLayout id="pfl4">
                                                <af:panelLabelAndMessage label="No. Radicado" id="plam1">
                                                    <af:outputText inlineStyle="font-size: 14px;"
                                                                   value="#{bindings.nroRadicado.inputValue}" id="it5"/>
                                                </af:panelLabelAndMessage>
                                                <af:panelLabelAndMessage label="#{bindings.tiempoRespuestaDO.label}"
                                                                         id="plam4"
                                                                         partialTriggers="otFechaVencimiento">
                                                    <af:outputText value="#{bindings.tiempoRespuestaDO.inputValue eq 0?'No asignado':bindings.tiempoRespuestaDO.inputValue}"
                                                                   shortDesc="#{bindings.tiempoRespuestaDO.hints.tooltip}"
                                                                   id="ot18">
                                                        <af:convertNumber groupingUsed="false"
                                                                          pattern="#{bindings.tiempoRespuestaDO.format}"/>
                                                    </af:outputText>
                                                    <af:outputText value=" (d&#237;as h&#225;biles)" id="ot14"/>
                                                </af:panelLabelAndMessage>
                                            </af:panelFormLayout>
                                            <af:spacer width="20" height="10" id="s11"/>
                                            <af:panelFormLayout id="pfl5">
                                                <af:inputText label="Funcionario"
                                                              value="#{bindings.idUsuario.inputValue}"
                                                              readOnly="true" id="aot2"/>
                                                <af:spacer width="20" height="10" id="s22"/>
                                                <af:inputText label="Dependencia" visible="false"
                                                              value="#{bindings.codDependencia.inputValue}"
                                                              readOnly="true" id="ot15"/>
                                            </af:panelFormLayout>
                                        </af:panelGroupLayout>
                                    </af:panelBox>
                                    <af:panelBox text="Remitente" id="pb1">
                                        <af:panelFormLayout id="pfl2" styleClass="AFStretchWidth">
                                            <af:inputText value="#{bindings.tipoIdentificacion.inputValue}"
                                                          label="Tipo de Identificaci&#243;n" required="true"
                                                          columns="30" readOnly="true" id="it1"/>
                                            <af:inputText value="#{bindings.numeroIdentificacion.inputValue}"
                                                          readOnly="true" label="No. Identificaci&#243;n"
                                                          shortDesc="N&#250;mero de Identificaci&#243;n" id="it20">
                                                <f:validator binding="#{bindings.numeroIdentificacion.validator}"/>
                                            </af:inputText>
                                            <af:inputText value="#{bindings.primerNombre.inputValue}"
                                                          label="Primer Nombre" readOnly="true" columns="50"
                                                          id="it_primernombre"/>
                                            <af:inputText value="#{bindings.segundoNombre.inputValue}"
                                                          label="Segundo Nombre" readOnly="true" columns="50"
                                                          id="it_segundonombre"/>
                                            <af:inputText value="#{bindings.primerApellido.inputValue}"
                                                          label="Primer Apellido" readOnly="true" columns="50"
                                                          id="it_primerapellido"/>
                                            <af:inputText value="#{bindings.segundoApellido.inputValue}"
                                                          label="Segundo Apellido" readOnly="true" columns="50"
                                                          id="it_segundoapellido"/>
                                            <af:inputText value="#{bindings.email.inputValue}" label="Email"
                                                          required="true" columns="50" readOnly="true" id="it2"/>
                                            <af:inputText value="#{bindings.telefono.inputValue}" label="Tel&#233;fono"
                                                          columns="20" readOnly="true" id="it3"/>
                                                          <af:inputText value="#{bindings.celular.inputValue}" readOnly="true"
                                                                  label="Celular" columns="20" id="it_celular"/>
                                            <af:inputText value="#{bindings.direccion.inputValue}"
                                                          label="#{bindings.direccion.hints.label}" readOnly="true"
                                                          id="it18">
                                                <f:validator binding="#{bindings.direccion.validator}"/>
                                            </af:inputText>
                                            <af:inputText value="#{bindings.nombrePaisDO.inputValue}" id="it4"
                                                          label="#{bindings.nombrePaisDO.hints.label}" readOnly="true">
                                            </af:inputText>
                                            <af:inputText value="#{bindings.nombreDepartamentoDO.inputValue}" id="it6"
                                                          label="#{bindings.nombreDepartamentoDO.hints.label}" readOnly="true">
                                            </af:inputText>
                                            <af:inputText value="#{bindings.nombreCiudadDO.inputValue}" id="it7"
                                                          label="#{bindings.nombreDepartamentoDO.hints.label}" readOnly="true">
                                            </af:inputText>
                                            
                                            <af:inputText value="#{bindings.ocupacion.inputValue}"
                                                          label="#{bindings.ocupacion.hints.label}" readOnly="true"
                                                          id="it15">
                                                <f:validator binding="#{bindings.ocupacion.validator}"/>
                                            </af:inputText>
                                            <af:selectOneChoice value="#{bindings.idRangoEdad.inputValue}" id="juc1"
                                                                label="Rango de Edad" readOnly="true">
                                                <f:selectItem itemLabel="N/A" id="siRangoEdad" itemValue="-1"/>
                                                <f:selectItems value="#{categorizarComBean.listaRangoEdadSI}"
                                                               id="sijuc"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice value="#{bindings.idPoblacionVulnerable.inputValue}"
                                                                id="soc6" label="Poblaci&#243;n Vulnerable"
                                                                readOnly="true" >
                                                <f:selectItem itemLabel="N/A" id="siPobVuln" itemValue="-1"/>
                                                <f:selectItems value="#{categorizarComBean.listaPoblacionVulnerableSI}"
                                                               id="si10"/>
                                            </af:selectOneChoice>
                                            <af:selectOneChoice value="#{bindings.idEtnia.inputValue}" id="soc7"
                                                                label="Etnia" readOnly="true">
                                                <f:selectItem itemLabel="N/A" id="siEtnia" itemValue="-1"/>
                                                <f:selectItems value="#{categorizarComBean.listaEtniaSI}"
                                                               id="si11"/>
                                            </af:selectOneChoice>
                                        </af:panelFormLayout>
                                    </af:panelBox>
                                    <af:panelBox text="Contenido" id="pb8">
                                        <f:facet name="toolbar"/>
                                        <af:panelLabelAndMessage label="Documento Principal" id="plam5"
                                                                 visible="true">
                                            <af:link targetFrame="_blank" text="#{bindings.nroRadicado.inputValue}"
