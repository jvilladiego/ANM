                                                <f:facet name="ucm">
                                                    <af:panelGroupLayout layout="vertical" id="pgl32">
                                                        <af:inputListOfValues label="#{resources.DOCUMENT_ID}" id="idInputComboboxLOVWithTable" value="#{pageFlowScope.readAttachmentBean.ucmDocId}" autoSubmit="true" popupTitle="#{resources.SRCH_SLCT_DOC_ID}" searchDesc="#{resources.SRCH_SLCT_DOC_ID}" model="#{pageFlowScope.ADFHumanTaskBean.listOfValuesModel}" columns="60" required="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}" rendered="#{pageFlowScope.ADFHumanTaskBean.isUsingUCM}" visible="#{pageFlowScope.readAttachmentBean.selectedAttachmentType == 'ucm'}"/>
                                                    </af:panelGroupLayout>
                                                </f:facet>
                                            </af:switcher>
                                        </af:panelGroupLayout>
                                    </af:panelGroupLayout>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="popupDeleteAttachmentDialog" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{resources.DELETE_ATTACHMENT}" type="none" modal="true" closeIconVisible="false" id="attDelDlg">
                                    <f:facet name="buttonBar">
                                        <af:panelGroupLayout id="pgl33">
                                            <af:button textAndAccessKey="#{resources.OK_AK}" actionListener="#{bindings.Delete5.execute}" immediate="true" partialSubmit="true" id="delAtOK" action="#{popupBean.hideAttachmentDeleteDialog}"/>
                                            <af:button textAndAccessKey="#{resources.CANCEL_AK}" id="delAtCan" action="#{popupBean.hideAttachmentDeleteDialog}" partialSubmit="true"/>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                    <af:panelGroupLayout id="pgl34">
                                        <af:panelFormLayout id="pfl23">
                                            <af:outputText id="delAttTxt" value="#{resources.DELETE_ATTACHMENT_MSG}"/>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="reassignPopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog id="reAsDg" dialogListener="#{invokeActionBean.reassignAction}" cancelTextAndAccessKey="#{resources.CANCEL_AK}" affirmativeTextAndAccessKey="#{resources.OK_AK}" title="#{resources.REASSIGNPAGE}">
                                    <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}" workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}" id="reAsIdB" mode="REASSIGN" showActionButtons="false" selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="requestInfoPopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{resources.INFOREQUESTEDPAGE}" cancelTextAndAccessKey="#{resources.CANCEL_AK}" affirmativeTextAndAccessKey="#{resources.OK_AK}" dialogListener="#{invokeActionBean.requestInfoAction}" id="reqIfD">
                                    <wlc:requestInfoDialog workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}" id="rqIDgC" selectedTaskId="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds[0]}"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="routePopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{resources.ROUTEPAGE}" cancelTextAndAccessKey="#{resources.CANCEL_AK}" affirmativeTextAndAccessKey="#{resources.OK_AK}" dialogListener="#{invokeActionBean.routeTaskAction}" id="rteDg">
                                    <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}" workflowContext="#{pageFlowScope.taskFlowReassignBean.workflowContext}" id="rteIdB" mode="ROUTE" selectedTaskIds="#{pageFlowScope.taskFlowReassignBean.selectedTaskIds}" showActionButtons="false"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="decomposePopup" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{pageFlowScope.ADFHumanTaskBean.decomposeDialogTitle}" cancelTextAndAccessKey="#{resources.CANCEL_AK}" affirmativeTextAndAccessKey="#{resources.OK_AK}" dialogListener="#{invokeActionBean.decomposeTaskAction}" id="dcmpDg">
                                    <wlc:identityBrowser identityBrowserView="#{pageFlowScope.identityBrowserView}" workflowContext="#{pageFlowScope.ADFHumanTaskBean.workflowContext}" id="dcmpIdB" mode="DECOMPOSE" selectedTaskObject="#{pageFlowScope.ADFHumanTaskBean.task}" showActionButtons="false"/>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="popupEnterPasswordDialog" contentDelivery="lazyUncached" childCreation="deferred">
                                <af:dialog title="#{resources.ENTER_PASSWORD}" dialogListener="#{invokeActionBean.validatePassword}" type="okCancel" modal="true" cancelTextAndAccessKey="#{resources.CANCEL_AK}" affirmativeTextAndAccessKey="#{resources.OK_AK}" closeIconVisible="false" id="pwdDlg">
                                    <af:panelGroupLayout id="pgl35">
                                        <af:panelFormLayout id="pfl24">
                                            <af:inputText id="pwdBox" rows="1" columns="50" value="#{invokeActionBean.password}" label="#{resources.PASSWORD}" secret="true" required="true"/>
                                        </af:panelFormLayout>
                                    </af:panelGroupLayout>
                                </af:dialog>
                            </af:popup>
                            <af:popup id="helpPopup" childCreation="deferred">
                                <af:switcher facetName="#{pageFlowScope.taskDocumentationBean.isTaskDoc}" id="s16">
                                    <f:facet name="true">
                                        <af:panelGroupLayout layout="vertical" id="pgl36">
                                            <af:link text="#{resources.OPEN_IN_WINDOW}" destination="#{pageFlowScope.taskDocumentationBean.docURL}" targetFrame="help" id="help" rendered="#{!empty bindings.activityId.inputValue}"/>
                                            <af:outputFormatted value="#{pageFlowScope.taskDocumentationBean.taskDoc}" id="of1"/>
                                        </af:panelGroupLayout>
                                    </f:facet>
                                    <f:facet name="false">
                                        <af:outputText value="#{resources.TASK_DOC_NOT_AVAILABLE}" id="ot36"/>
                                    </f:facet>
                                </af:switcher>
                            </af:popup>
                        </af:panelGroupLayout>
                    </af:panelHeader>
                    <f:facet name="separator"/>
                </af:panelGroupLayout>
            </af:form>
        </af:document>
    </f:view>
</jsp:root>
