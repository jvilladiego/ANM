                                            </af:panelGroupLayout>
                                            <af:spacer width="100" height="10" id="s21"/>
                                            <af:panelGroupLayout id="pgl6" layout="vertical">
                                                <af:selectBooleanCheckbox value="true" simple="false" label="&#191;PQRS?"
                                                                          required="false" shortDesc="true" id="sbc2"
                                                                          autoSubmit="true" readOnly="true"/>
                                                <af:inputText id="it25" label="Tipo PQRS" value="#{bindings.tipoPQRSDO.inputValue}"
                                                              readOnly="true">
                                                    <?audit suppress oracle.adf.faces.compnotlabelled?>
                                                </af:inputText>
                                            </af:panelGroupLayout>
                                            <af:spacer width="100" height="10" id="s25"/>
