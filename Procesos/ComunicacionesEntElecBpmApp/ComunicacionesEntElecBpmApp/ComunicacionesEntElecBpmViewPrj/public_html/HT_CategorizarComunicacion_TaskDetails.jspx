                                                      id="it36">
                                            <f:validator binding="#{bindings.asunto.validator}"/>
                                        </af:inputText>
                                         <af:inputText value="#{bindings.textoWebformPQRSDO.inputValue}" label="Descripción :"
                                                      shortDesc="#{bindings.descripcion.hints.tooltip}" readOnly="true"
                                                      id="it8">
                                            <f:validator binding="#{bindings.descripcion.validator}"/>
                                        </af:inputText>
                                        <af:spacer width="20" height="10" id="s24"/>
                                        <af:panelGroupLayout id="pgl5" layout="horizontal">
                                            <af:panelGroupLayout id="pgl100" layout="vertical">
                                                <af:selectBooleanCheckbox value="#{bindings.esTituloMinero.inputValue}"
                                                                          label="¿Expediente Minero?"
                                                                          autoSubmit="true" id="sbc1" readOnly="true"/>
                                                <af:inputText value="#{bindings.nroPlaca.inputValue}"
                                                              placeholder="Placa" label="#{bindings.nroPlaca.label}"
                                                              required="#{bindings.nroPlaca.hints.mandatory}"
                                                              shortDesc="#{bindings.nroPlaca.hints.tooltip}" id="it37"
                                                              readOnly="true">
