<?xml version='1.0' encoding='UTF-8'?>
<taskDefinition targetNamespace="http://xmlns.oracle.com/bpm/ComunicacionesEntBpmPrj/HT_GestionarObservacion" xmlns:xp20="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.Xpath20" xmlns:ora="http://schemas.oracle.com/xpath/extension" xmlns:oraext="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.ExtFunc" xmlns:task="http://xmlns.oracle.com/bpel/workflow/task" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://xmlns.oracle.com/bpel/workflow/taskDefinition" xmlns:bpm="http://xmlns.oracle.com/bpmn20/extensions" xmlns:ns0="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/MetadatosBO" xmlns:ns1="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/TipoSimpleBO" xmlns:ns2="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/InteresadoBO" xmlns:ns3="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ComunicacionBO" xmlns:ns4="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/AnexoBO" xmlns:hwf="http://xmlns.oracle.com/bpel/workflow/xpath" xmlns:xref="http://www.oracle.com/XSL/Transform/java/oracle.tip.xref.xpath.XRefXPathFunctions" xmlns:ns5="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/TaxonomiaBO" xmlns:ns6="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/DependenciaBO" xmlns:ns7="http://xmlns.oracle.com/bpel/workflow/common" xmlns:dvm="http://www.oracle.com/XSL/Transform/java/oracle.tip.dvm.LookupValue" xmlns:ns8="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ContentFolderBO" xmlns:ids="http://xmlns.oracle.com/bpel/services/IdentityService/xpath" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:evidence="http://xmlns.oracle.com/bpel/workflow/TaskEvidenceService" xmlns:ns9="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/InteresadoInterno" xmlns:ns10="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/UsuarioBO" xmlns:socket="http://www.oracle.com/XSL/Transform/java/oracle.tip.adapter.socket.ProtocolTranslator" xmlns:bpws="http://schemas.xmlsoap.org/ws/2003/03/business-process/" xmlns:oraxsl="http://www.oracle.com/XSL/Transform/java" xmlns:xdk="http://schemas.oracle.com/bpel/extension/xpath/function/xdk" xmlns:fn="http://www.w3.org/2005/xpath-functions" xmlns:mhdr="http://www.oracle.com/XSL/Transform/java/oracle.tip.mediator.service.common.functions.MediatorExtnFunction" xmlns:ess="http://xmlns.oracle.com/scheduler" xmlns:med="http://schemas.oracle.com/mediator/xpath" xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable" xmlns:ldap="http://schemas.oracle.com/xpath/extension/ldap" xmlns:ns11="http://service.sgd.anm.gov.co">
   <name>HT_GestionarObservacion</name>
   <id>${domain_id}_${process_id}_${process_revision}_HT_GestionarObservacion</id>
   <title type="XPATH"><value>/task:task/task:payload/task:tituloActividad</value></title>
   <priority>3</priority>
   <hideCreator>false</hideCreator>
   <process processId="" processVersion=""/>
   <routingSlip xmlns="http://xmlns.oracle.com/bpel/workflow/routingSlip" routingType="TEMPLATE">
      <globalConfiguration>
         <applicationContext>OracleBPMProcessRolesApp</applicationContext>
         <taskOwner type="STATIC" identityType="application_role">ComunicacionesEntBpmPrj.ProcessOwner</taskOwner>
         <sharePayloadConfiguration>
            <type>USE_SYSTEM_WIDE_GLOBAL_CONFIGURATION</type>
         </sharePayloadConfiguration>
         <errorOnEmptyAssignee>false</errorOnEmptyAssignee>
         <excludeSaturdayAndSunday>false</excludeSaturdayAndSunday>
      </globalConfiguration>
      <participants isAdhocRoutingSupported="false">
         <stage name="Stage1" disabled="false">
            <participant disabled="false" name="default.DefaultPerformer">
               <resource type="XPATH" identityType="user">/task:task/task:payload/ns10:UsuarioBO/ns10:idUsuario</resource>
            </participant>
         </stage>
      </participants>
      <onErrorParticipant>
         <resource type="STATIC" identityType="user">weblogic</resource>
      </onErrorParticipant>
      <notification includeTaskAttachments="false" actionable="false" secureNotifications="false"
                    oneNotificationPerUserPerAction="false" hideWorklistUrlInEmail="false">
         <action name="ASSIGN" recipient="ASSIGNEES">
            <![CDATA[concat(string('Task '), /task:task/task:title, string(' requires your attention.'))]]>
         </action>
         <action name="COMPLETE" recipient="CREATOR">
            <![CDATA[concat(string('Task '), /task:task/task:title, string(' requires your attention.'))]]>
         </action>
         <action name="ERROR" recipient="OWNER">
            <![CDATA[concat(string('Task '), /task:task/task:title, string(' requires your attention.'))]]>
         </action>
         <groupNotificationConfiguration>SEND_INDIVIDUAL_NOTIFICATION</groupNotificationConfiguration>
         <commentScope>TASK</commentScope>
      </notification>
   </routingSlip>
   <workflowConfiguration features="ucm,RSCUSTOMIZATION" xmlns:ns0="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/ComunicacionBO" xmlns="http://xmlns.oracle.com/bpel/workflow/configuration" xmlns:ns1="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/InteresadoBO" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://xmlns.oracle.com/bpm/bpmobject/SGDComunicaciones/UsuarioBO">
      <outcomes>
         <outcome>OK</outcome>
      </outcomes>
      <payload externalSchema="false" xmlSchemaDefinition="../Schemas/HT_GestionarObservacionPayload.xsd"
               typedTaskSchemaLocation="../Schemas/HT_GestionarObservacionWorkflowTask.xsd">
         <messageAttribute name="ComunicacionBO" attributeType="ELEMENT" type="ns0:ComunicacionBO" updatable="true"
                           external="false"/>
         <messageAttribute name="InteresadoBO" attributeType="ELEMENT" type="ns1:InteresadoBO" updatable="true"
                           external="false"/>
         <messageAttribute name="requiereGestionCompartidaDO" attributeType="SIMPLE_TYPE" type="xsd:string"
                           updatable="true" external="false"/>
         <messageAttribute name="esPQRSDO" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="requiereRespuestaDO" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="trasladoOtraInstitucionDO" attributeType="SIMPLE_TYPE" type="xsd:string"
                           updatable="true" external="false"/>
         <messageAttribute name="accesoNegadoInformacionDO" attributeType="SIMPLE_TYPE" type="xsd:string"
                           updatable="true" external="false"/>
         <messageAttribute name="identificacionReservadaDO" attributeType="SIMPLE_TYPE" type="xsd:string"
                           updatable="true" external="false"/>
         <messageAttribute name="jefeAsignadoDO" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="codDepGestionCompartida" attributeType="SIMPLE_TYPE" type="xsd:long" updatable="true"
                           external="false"/>
         <messageAttribute name="UsuarioBO" attributeType="ELEMENT" type="ns2:UsuarioBO" updatable="true"
                           external="false"/>
         <messageAttribute name="isPQRS" attributeType="SIMPLE_TYPE" type="xsd:boolean" updatable="true"
                           external="false"/>
         <messageAttribute name="tipoPQRS" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="tiempoRespuesta" attributeType="SIMPLE_TYPE" type="xsd:integer" updatable="true"
                           external="false"/>
         <messageAttribute name="fechaVencimiento" attributeType="SIMPLE_TYPE" type="xsd:dateTime" updatable="true"
                           external="false"/>
         <messageAttribute name="idTipoPQRS" attributeType="SIMPLE_TYPE" type="xsd:long" updatable="true"
                           external="false"/>
         <messageAttribute name="urlDocumentoPrincipalDO" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="urlArchivoAdjuntoDO" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="tituloActividad" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="asunto" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="radicado" attributeType="SIMPLE_TYPE" type="xsd:string" updatable="true"
                           external="false"/>
         <messageAttribute name="fechaRadicacion" attributeType="SIMPLE_TYPE" type="xsd:dateTime" updatable="true"
                           external="false"/>
      </payload>
      <flexfieldMappings>
         <flexfieldMapping>
            <xpathExpression>/task:task/task:payload/task:asunto</xpathExpression>
            <attributeLabel>
               <labelName>asunto</labelName>
               <flexfield>ProtectedTextAttribute11</flexfield>
               <description>Asunto</description>
            </attributeLabel>
            <description>Asunto</description>
         </flexfieldMapping>
         <flexfieldMapping>
            <xpathExpression>/task:task/task:payload/task:radicado</xpathExpression>
            <attributeLabel>
               <labelName>numeroRadicado</labelName>
               <flexfield>ProtectedTextAttribute12</flexfield>
               <description>Numero radicado</description>
            </attributeLabel>
            <description>Numero radicado</description>
         </flexfieldMapping>
         <flexfieldMapping>
            <xpathExpression>/task:task/task:payload/task:fechaVencimiento</xpathExpression>
            <attributeLabel>
               <labelName>Fecha de Vencimiento</labelName>
               <flexfield>ProtectedDateAttribute1</flexfield>
               <description>Auto-generated for BPM Process</description>
            </attributeLabel>
            <description>Fecha vencimiento</description>
         </flexfieldMapping>
         <flexfieldMapping>
            <xpathExpression>/task:task/task:payload/task:fechaRadicacion</xpathExpression>
            <attributeLabel>
               <labelName>Fecha de Radicación</labelName>
               <flexfield>ProtectedDateAttribute2</flexfield>
               <description>Auto-generated for BPM Process</description>
            </attributeLabel>
            <description>Fecha radicacion</description>
         </flexfieldMapping>
      </flexfieldMappings>
      <bpelEventListener>false</bpelEventListener>
      <bpelNoCallbacks>false</bpelNoCallbacks>
      <accessRules>
         <actionRules>
            <systemAction>REASSIGN</systemAction>
            <roles>
               <role privilege="PERMIT">ADMIN</role>
               <role privilege="PERMIT">OWNER</role>
               <role privilege="RESTRICT">APPROVERS</role>
               <role privilege="RESTRICT">CREATOR</role>
               <role privilege="RESTRICT">REVIEWERS</role>
               <role privilege="RESTRICT">ASSIGNEES</role>
            </roles>
         </actionRules>
         <actionRules>
            <systemAction>WITHDRAW</systemAction>
            <roles>
               <role privilege="PERMIT">ADMIN</role>
               <role privilege="PERMIT">OWNER</role>
               <role privilege="RESTRICT">APPROVERS</role>
               <role privilege="RESTRICT">ASSIGNEES</role>
               <role privilege="RESTRICT">REVIEWERS</role>
               <role privilege="RESTRICT">CREATOR</role>
            </roles>
         </actionRules>
      </accessRules>
      <showCompleteGraphicalHistory>true</showCompleteGraphicalHistory>
      <reevalTranslatablesOnUpdate>false</reevalTranslatablesOnUpdate>
      <preActionMandatoryUserSteps/>
      <allowInitiatorEditParticipants>false</allowInitiatorEditParticipants>
      <allowParticipantsEditParticipants>false</allowParticipantsEditParticipants>
      <globalCreationTask>false</globalCreationTask>
      <enableAutoClaim>true</enableAutoClaim>
      <workflowConditions/>
      <taskSequenceTypes>FUTURE</taskSequenceTypes>
      <taskSequenceTypes>AGGREGATE</taskSequenceTypes>
   </workflowConfiguration>
</taskDefinition>
