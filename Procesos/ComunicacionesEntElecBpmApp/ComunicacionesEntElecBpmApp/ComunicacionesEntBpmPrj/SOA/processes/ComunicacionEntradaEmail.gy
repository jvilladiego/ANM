public void methodACT49111323529595()
{
	if (respuestaRadicadoCierreDO == null) {
	    throw new IllegalStateException(
	        "El servicio no devolvió respuesta de radicación");
	}
	
	if (!"0".equals(respuestaRadicadoCierreDO.statusCode)) {
	    throw new IllegalStateException(
	        "Falló la radicación: " +
	        respuestaRadicadoCierreDO.statusMessage);
	}
	
	if (respuestaRadicadoCierreDO.noRadicado == null ||
	    respuestaRadicadoCierreDO.noRadicado.trim().length() == 0) {
	    throw new IllegalStateException(
	        "El servicio devolvió un radicado vacío");
	}
	
	comunicacionCierreBO.nroRadicado =
	    respuestaRadicadoCierreDO.noRadicado;
}


