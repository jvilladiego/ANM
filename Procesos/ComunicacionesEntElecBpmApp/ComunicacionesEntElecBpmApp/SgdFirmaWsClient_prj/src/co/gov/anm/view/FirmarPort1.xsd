<?xml version='1.0' encoding='UTF-8'?>
<xsd:schema xmlns:ns0="http://view.anm.gov.co/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://view.anm.gov.co/">
  <xsd:complexType name="firmarPdf">
    <xsd:sequence>
      <xsd:element name="numeroRadicado" type="xsd:string" minOccurs="0"/>
      <xsd:element name="taskNumber" type="xsd:int" minOccurs="0"/>
      <xsd:element name="identificacion" type="xsd:string" minOccurs="0"/>
      <xsd:element name="usuario" type="xsd:string" minOccurs="0"/>
      <xsd:element name="contrasenaEncriptada" type="xsd:string" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="firmarPdfResponse">
    <xsd:sequence>
      <xsd:element name="return" type="ns0:firmarResponse" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="firmarResponse">
    <xsd:sequence>
      <xsd:element name="statusCode" type="xsd:int" minOccurs="0"/>
      <xsd:element name="statusMessage" type="xsd:string" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="firmarPdf" type="ns0:firmarPdf"/>
  <xsd:element name="firmarPdfResponse" type="ns0:firmarPdfResponse"/>
</xsd:schema>